  private predicate renOpen(DataFlow::Node sink) {
    exists(Call c |
      pathArg0(sink, c) and
      c.getFunc().(Name).getId() = "ren_open" and
      c.getLocation().getFile().getShortName() in ["httpcli.py", "up2k.py"]
    )
  }

  /**
   * yieldfile(): streaming content read (open(fsenc(fn), "rb") at util.py:2121).
