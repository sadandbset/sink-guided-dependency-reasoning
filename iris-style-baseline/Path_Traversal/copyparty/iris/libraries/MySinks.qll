  private predicate fsOperation(DataFlow::Node sink) {
    exists(Call c, Attribute f |
      (
        f.getName() = "rename" and sink.asExpr() = c.getArg(1)
        or f.getName() != "rename" and sink.asExpr() = c.getArg(0)
      ) and
      f = c.getFunc().(Attribute) and
      f.getObject().(Name).getId() in ["bos", "os"] and
      f.getName() in ["stat", "lstat", "unlink", "rmdir", "rename", "mkdir", "makedirs"] and
      (
        c.getLocation().getFile().getShortName() in [
          "httpcli.py", "ftpd.py", "smbd.py", "up2k.py",
