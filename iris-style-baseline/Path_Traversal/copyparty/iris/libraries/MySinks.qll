    exists(Call c, Attribute f |
      pathArg0(sink, c) and
      f = c.getFunc().(Attribute) and
      f.getName() in ["exists", "isfile", "isdir", "getsize", "getmtime", "lexists", "islink"] and
      f.getObject().(Attribute).getName() = "path" and
