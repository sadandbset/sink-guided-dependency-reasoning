import python
import semmle.python.dataflow.new.DataFlow

module MySinks {
  /** Unified pass key (see WORKFLOW.md section 5.1). */
  private string passKey() { result = "path_traversal" }

  /**
   * Holds if `sink` is a filesystem-access sink for the path-traversal
   * pass, according to the reviewed pass-1 labels.
   */
  predicate isSink(DataFlow::Node sink, string pass) {
    pass = passKey() and
    (
      builtinOpen(sink)
      or bosOpen(sink)
      or fileServe(sink)
      or renOpen(sink)
      or yieldfileRead(sink)
      or imageOpen(sink)
      or kernSendfile(sink)
      or statdirScandir(sink)
      or fsOperation(sink)
      or pathMetadataProbe(sink)
