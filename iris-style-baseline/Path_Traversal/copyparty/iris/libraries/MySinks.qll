  // ---------- helpers ----------

  private predicate fileIs(AstNode n, string name) {
    n.getLocation().getFile().getShortName() = name
  }

  private predicate funcIs(AstNode n, string name) {
    n.getScope() instanceof Function and
    n.getScope().(Function).getName() = name
  }

  /** The node is argument 0 (the path text) of call `c`. */
  private predicate pathArg0(DataFlow::Node sink, Call c) {
    sink.asExpr() = c.getArg(0)
  }

  // ---------- direct content access ----------

  /**
   * builtin open() at the verified request-channel sites.
   * Labels (file_open tp): P1-K-0017 (ftpd.py:221 FtpFs.open),
   * P1-K-0019 (LOCK create :1159), P1-K-0024 (new-md :2110),
   * P1-K-0028 (text upload :2518), P1-K-0035/0036/0038
   * (prologue/README/doc viewer :3595/:3603/:3878 in tx_browser),
   * P1-K-0040 (star.py:94 tar content read), P1-K-0054 (util ren_open
   * fn-trunc write), P1-K-0057 (util gzip_orig_sz of tx_file editions).
   */
  private predicate builtinOpen(DataFlow::Node sink) {
    exists(Call c |
      pathArg0(sink, c) and
      c.getFunc().(Name).getId() = "open" and
      (
        (fileIs(c, "httpcli.py") and
          c.getScope().(Function).getName() in [
            "handle_lock", "handle_new_md", "handle_text_upload", "tx_browser",
          ])
        or (fileIs(c, "ftpd.py") and funcIs(c, "open"))
        or (fileIs(c, "star.py") and funcIs(c, "ser"))
        or (fileIs(c, "util.py") and
          c.getScope().(Function).getName() in ["ren_open", "gzip_orig_sz"])
      )
    )
  }

  /**
   * bos.open(): the first-party filesystem wrapper used by tx_file for
   * block devices and by the SMB server.
   * Labels (bos_open tp): P1-K-0029 (httpcli.py:2615, tx_file),
   * P1-K-0039 (smbd.py:185, _open).
   */
  private predicate bosOpen(DataFlow::Node sink) {
    exists(Call c |
      pathArg0(sink, c) and
      c.getFunc().(Attribute).getName() = "open" and
      c.getFunc().(Attribute).getObject().(Name).getId() = "bos" and
      (
        (fileIs(c, "httpcli.py") and funcIs(c, "tx_file"))
        or (fileIs(c, "smbd.py") and funcIs(c, "_open"))
      )
    )
  }

  /**
