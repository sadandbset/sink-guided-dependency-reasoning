      pathArg0(sink, c) and
      fileIs(c, "httpcli.py") and
      c.getFunc().(Attribute).getName() in ["tx_file", "tx_md"]
    )
  }

  /**
   * ren_open(): the atomic file-create wrapper (os.path.join(fdir, fname)
