   */
  private predicate statdirScandir(DataFlow::Node sink) {
    exists(Call c |
      pathArg0(sink, c) and
      fileIs(c, "util.py") and
      funcIs(c, "statdir") and
      c.getFunc().(Attribute).getName() = "scandir" and
      c.getFunc().(Attribute).getObject().(Name).getId() = "os"
    )
  }

  // ---------- filesystem operations ----------

  /**
   * bos.* / os.* filesystem operations in the request-serving modules:
   * stat / lstat (metadata + serve gating), unlink / rmdir (deletion),
   * rename (move: dangerous position is the destination, argument 1),
   * mkdir / makedirs (creation). In util.py only atomic_move is included
