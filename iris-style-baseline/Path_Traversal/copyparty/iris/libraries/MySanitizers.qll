  }

  // ---------- helpers ----------

  private predicate fileIs(AstNode n, string name) {
    n.getLocation().getFile().getShortName() = name
  }

  // ---------- barriers ----------

  /**
   * undot() results at the verified SOUND application sites.
   * Labels (path_sanitize sanitizer tp): P1-K-0270 (authsrv.py:430,
   * _find recursion), P1-K-0271 (authsrv.py:439, can_access),
   * P1-K-0272 (authsrv.py:473, VFS.get - the load-bearing guard),
   * P1-K-0337 (httpcli.py:1765, handle_post_json),
