import python
import semmle.python.dataflow.new.DataFlow

module MySanitizers {
  /** Unified pass key (see WORKFLOW.md section 5.1). */
  private string passKey() { result = "path_traversal" }

  /**
   * Holds if `node` is a proven traversal-sanitizing node for the
   * path-traversal pass. The barrier is placed on the undot/sanitize_fn
   * CALL RESULT: any taint arriving there stops, so only values that
   * were actually normalized are considered clean downstream.
