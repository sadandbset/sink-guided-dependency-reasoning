   * szip.py:109 (P1-K-0392) is excluded: ok='/' keeps separators, so it
   * does not sanitize filesystem paths.
   */
  private predicate sanitizeFnBarrier(DataFlow::Node node) {
    exists(Call c |
      node.asExpr() = c and
      c.getFunc().(Name).getId() = "sanitize_fn" and
      c.getLocation().getFile().getShortName() in ["ftpd.py", "httpcli.py", "up2k.py"]
