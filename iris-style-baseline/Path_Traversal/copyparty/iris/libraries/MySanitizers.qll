   * The pre-decode undot at httpcli.py:333/:337 (P1-K-0315/P1-K-0316,
   * classification candidate) is intentionally excluded: it runs on the
   * still-percent-encoded raw path, so encoded traversal survives it.
   */
  private predicate soundUndotBarrier(DataFlow::Node node) {
    exists(Call c |
      node.asExpr() = c and
      c.getFunc().(Name).getId() = "undot" and
      (
        fileIs(c, "authsrv.py")
        or (fileIs(c, "httpcli.py") and
          c.getScope().(Function).getName() in ["handle_post_json", "tx_tree"])
      )
    )
