import python
import semmle.python.dataflow.new.DataFlow

/**
 * Source model for pass key "path_traversal". Declared as a module so the
 * query (and any future pass query) can address the predicate as
 * `MySources::isSource(node, passKey)` after `import libraries.MySources`
 * (import paths use dots, name qualification uses `::` - a mixed
 * `libraries.MySources::isSource` reference is not valid QL syntax).
 */
module MySources {

/* ------------------------------------------------------------------ */
/* Shared scope helpers (private; identical to extraction/sources.ql)   */
/* ------------------------------------------------------------------ */

/** Forward-slash-normalized absolute path of the file containing n, so path
 *  matching works with both CodeQL path styles on Windows. */
private string normalizedPathOf(AstNode n) {
  result = n.getLocation().getFile().getAbsolutePath().replaceAll("\\", "/")
}

/** The generator core module (openapi_python_client/__init__.py) where the
 *  document fetch/read, the yaml parse, the project_dir construction and all
 *  file operations live. */
bindingset[path]
private predicate generatorCoreModule(string path) {
  path.matches("%/openapi_python_client/__init__.py")
}

/** The OpenAPI parser module (openapi_python_client/parser/openapi.py). */
bindingset[path]
private predicate parserModule(string path) {
  path.matches("%/openapi_python_client/parser/openapi.py")
}

/* ------------------------------------------------------------------ */
/* Source model                                                        */
/* ------------------------------------------------------------------ */

/**
 * Holds if `source` is a Pass 1 (path traversal) taint source for pass key
 * `passKey`. Renders the 12 reviewed tp source labels; see the file header
 * for the exact label IDs and the exclusion rationale for the candidate
 * config-content rows.
 */
predicate isSource(DataFlow::Node source, string passKey) {
  passKey = "path_traversal" and
  (
    /* S01 (http_fetch, tp, 0.90): httpx.get(url) at __init__.py:71 inside
       _get_document - the RETURN VALUE (httpx.Response) carries the remote
       OpenAPI document body. The url argument itself is the operator --url
       value (Pass 3 material, not modeled here); the returned body is the
       Pass 1 input boundary. External input conditions: any server the
       operator points --url at; full control of the document bytes. */
    exists(Call c, Attribute func |
      func = c.getFunc().(Attribute) and
      func.getName() = "get" and
      func.getObject().(Name).getId() = "httpx" and
      generatorCoreModule(normalizedPathOf(c)) and
      source = DataFlow::exprNode(c)
    )
    or
    /* S02 (http_content, tp, 0.95): response.content at __init__.py:72 - the
       remote document bytes entering local flow as yaml_bytes (passed to
       yaml.safe_load at :80). */
    exists(Attribute a |
      a.getName() = "content" and
      a.getObject().(Name).getId() = "response" and
      generatorCoreModule(normalizedPathOf(a)) and
      source = DataFlow::exprNode(a)
    )
    or
    /* S03 (doc_read, tp, 0.80): path.read_bytes() at __init__.py:76 - the
       RETURN VALUE is the --path OpenAPI document CONTENT. The file is
       operator-selected (the CLI user passes --path), but the document is
       typically authored by a third party (downloaded spec), so its content
       is untrusted of the same shape as the URL case. Only the returned
       content is a source; the operator-chosen path VALUE is not (see the
       sink-side labeling of :76). */
    exists(Call c, Attribute func |
      func = c.getFunc().(Attribute) and
      func.getName() = "read_bytes" and
      func.getObject().(Name).getId() = "path" and
      generatorCoreModule(normalizedPathOf(c)) and
      source = DataFlow::exprNode(c)
    )
    or
    /* S04 (yaml_load, tp, 0.95): yaml.safe_load(yaml_bytes) at
       __init__.py:80 - THE document parse boundary: every remote document
       field (info.title, components.schemas names+titles,
       paths -> operations -> tags) enters as the returned dict. The
       config.py:34 safe_load (label S22) is a DIFFERENT trust judgment
       (candidate, excluded) and is kept out by the module restriction. */
    exists(Call c, Attribute func |
      func = c.getFunc().(Attribute) and
      func.getName() = "safe_load" and
      func.getObject().(Name).getId() = "yaml" and
      generatorCoreModule(normalizedPathOf(c)) and
      source = DataFlow::exprNode(c)
    )
    or
    /* S06 (openapi_field, tp, 0.95): openapi.title read at __init__.py:94
       inside Project.__init__ - the remote info.title (via GeneratorData)
       read inside the project_name f-string. Only cosmetic shaping follows
       (replace(' ', '-'), lower(), '-client' suffix) - no '/', backslash or
       '..' handling - so the title fully controls
       project_dir = Path.cwd() / project_name (:95) and every
       mkdir/write_text/rmtree below it. This is the strongest and the
       alert-generating source of this pass. */
    exists(Attribute a |
      a.getName() = "title" and
      a.getObject().(Name).getId() = "openapi" and
      generatorCoreModule(normalizedPathOf(a)) and
      source = DataFlow::exprNode(a)
    )
    or
    /* S10/S11 (name_field, tp, 0.90): model.reference.module_name /
       enum.reference.module_name reads at __init__.py:196/:203, inside the
       f-string file-name joins models_dir / f"{...}.py". The names originate
       from remote schema titles / #/components/schemas ref leafs and pass
       only through pascal_case/snake_case (case + whitespace reshaping that
       does not strip '/' or '..'), so they can carry path separators into
       the written file paths at :197/:204. */
    exists(Attribute a, Attribute base |
      a.getName() = "module_name" and
      base = a.getObject().(Attribute) and
      base.getName() = "reference" and
      base.getObject() instanceof Name and
      generatorCoreModule(normalizedPathOf(a)) and
      source = DataFlow::exprNode(a)
    )
    or
    /* S24 (openapi_field, tp, 0.95): operation.tags read at
       parser/openapi.py:51 - tag = (operation.tags or ["default"])[0] is
       taken COMPLETELY RAW from the remote document (no transformation, no
       validation) and later becomes the module file name
       api_dir / f"{tag}.py" (__init__.py:234) and async_api_dir / f"{tag}.py"
       (:236). NOTE: the taint path from this parse-side source to the :235/
       :237 sinks crosses dataclass/dict boundaries that no reviewed label
       bridges - see report/query_generation_notes.md section 5 (known
       limitation + diagnostics); the sink sites themselves still alert via
       the S06 title path. */
    exists(Attribute a |
      a.getName() = "tags" and
      a.getObject().(Name).getId() = "operation" and
      parserModule(normalizedPathOf(a)) and
      source = DataFlow::exprNode(a)
    )
    or
    /* S25/S26 (openapi_field, tp, 0.85): data.title reads at
       parser/openapi.py:230/:271 - the model/enum schema title (or
       components.schemas map key) passed to Reference.from_ref, becoming
       class_name/module_name after pascal_case/snake_case and then the
       models module file names. */
    exists(Attribute a |
      a.getName() = "title" and
      a.getObject().(Name).getId() = "data" and
      parserModule(normalizedPathOf(a)) and
      source = DataFlow::exprNode(a)
    )
    or
    /* S27 (parse_obj, tp, 0.85): oai.OpenAPI.parse_obj(d) at
       parser/openapi.py:300 - the external pydantic parse: the RETURN VALUE
       carries all document fields (info.title/version, paths ->
       operation.tags, components.schemas titles) into GeneratorData. CodeQL
       cannot see through pydantic, so the call return is a source for
       recall; the use-site field reads (S06/S10/S11/S24/S25/S26/S28) anchor
       the same boundary redundantly. */
    exists(Call c, Attribute func, Attribute mid |
      func = c.getFunc().(Attribute) and
      func.getName() = "parse_obj" and
      mid = func.getObject().(Attribute) and
      mid.getName() = "OpenAPI" and
      mid.getObject().(Name).getId() = "oai" and
      parserModule(normalizedPathOf(c)) and
      source = DataFlow::exprNode(c)
    )
    or
    /* S28 (openapi_field, tp, 0.90): openapi.info.title read at
       parser/openapi.py:311 - copied into GeneratorData.title and read in
       Project.__init__ (:94) to build project_name; same root cause as S06,
       labeled at the parse-side copy point. */
    exists(Attribute a, Attribute info |
      a.getName() = "title" and
      info = a.getObject().(Attribute) and
      info.getName() = "info" and
      info.getObject().(Name).getId() = "openapi" and
      parserModule(normalizedPathOf(a)) and
      source = DataFlow::exprNode(a)
    )
  )
}

}

