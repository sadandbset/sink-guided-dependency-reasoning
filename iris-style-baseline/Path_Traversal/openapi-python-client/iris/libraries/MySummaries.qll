import python
import semmle.python.dataflow.new.DataFlow

/**
 * Additional taint-step model for pass key "path_traversal". Declared as a
 * module so the query can address the predicate as
 * `MySummaries::isAdditionalTaintStep(from, to, passKey)` after
 * `import libraries.MySummaries` (import paths use dots, name
 * qualification uses `::`).
 */
module MySummaries {

/* ------------------------------------------------------------------ */
/* Shared scope helpers (private; identical to extraction/sinks.ql)     */
/* ------------------------------------------------------------------ */

/** Forward-slash-normalized absolute path of the file containing n, so path
 *  matching works with both CodeQL path styles on Windows. */
private string normalizedPathOf(AstNode n) {
  result = n.getLocation().getFile().getAbsolutePath().replaceAll("\\", "/")
}

/** The generator core module (openapi_python_client/__init__.py). */
bindingset[path]
private predicate generatorCoreModule(string path) {
  path.matches("%/openapi_python_client/__init__.py")
}

/** The four Project-specific instance attributes whose values are computed
 *  from the OpenAPI document inside Project.__init__ (:94-:98) and consumed
 *  by the other Project methods. */
private predicate projectAttrName(string attr) {
  attr = "project_name"
  or
  attr = "package_name"
  or
  attr = "project_dir"
  or
  attr = "package_dir"
}

/** A store `self.<attr> = value` inside openapi_python_client/__init__.py
 *  for one of the four Project attributes (labels K06 evidence: the four
 *  annotated assignments at :94/:95/:97/:98; the plain AssignStmt arm is
 *  kept for shape completeness - no such store exists in this snapshot). */
private predicate projectAttrStore(Expr value, string attr) {
  exists(AnnAssign store, Attribute target |
    store.getTarget() = target and
    target.getName() = attr and
    target.getObject().(Name).getId() = "self" and
    store.getValue() = value and
    generatorCoreModule(normalizedPathOf(store))
  )
  or
  exists(AssignStmt store, Attribute target |
    store.getATarget() = target and
    target.getName() = attr and
    target.getObject().(Name).getId() = "self" and
    store.getValue() = value and
    generatorCoreModule(normalizedPathOf(store))
  )
}

/* ------------------------------------------------------------------ */
/* Additional taint-step model                                         */
/* ------------------------------------------------------------------ */

/**
 * Holds if taint may flow from `nodeFrom` to `nodeTo` in addition to the
 * default taint steps, for pass key `passKey`. Renders exactly the two
 * label families that require explicit edges: the 20 pathlib '/' join
 * steps (K07-K50 join rows) and the Project field-flow step (K06).
 */
predicate isAdditionalTaintStep(DataFlow::Node nodeFrom, DataFlow::Node nodeTo, string passKey) {
  passKey = "path_traversal" and
  (
    /* pathlib '/' join: operand -> join result.
       Evidence: every true-divide (BinaryExpr with operator Div) in
       openapi_python_client/__init__.py is a pathlib path join - grep
       verified (no arithmetic division exists in the file). The default
       taint library propagates '+' (concatStep) but NOT '/', so without
       this step no tainted operand would reach any write_text/mkdir
       receiver. Left operand (the base directory, tainted via the
       Project field-flow step) and right operand (the appended
       component: title-derived project_name/package_name at :95/:98,
       remote module_name f-strings at :196/:203, raw tag f-strings at
       :234/:236) both propagate to the join result, as the labels
       specify (receiver- and argument-flow_kind join rows). */
    exists(BinaryExpr b |
      b.getOp() instanceof Div and
      generatorCoreModule(normalizedPathOf(b)) and
      (
        nodeFrom = DataFlow::exprNode(b.getLeft())
        or
        nodeFrom = DataFlow::exprNode(b.getRight())
      ) and
      nodeTo = DataFlow::exprNode(b)
    )
    or
    /* Project field flow (label K06): the value stored to
       self.project_name / self.package_name / self.project_dir /
       self.package_dir inside Project.__init__ (:94-:98) flows to every
       read of self.<attr> in the Project methods of the same module.
       Evidence chain that this single labeled step makes work:
         openapi.title (S06, :94) -> f-string -> project_name store (:94)
         -> self.project_name read (:95) -> '/' join (:95) -> project_dir
         store (:95) -> self.project_dir read (:109 mkdir receiver /
         :133 :136 subprocess cwd - excluded candidate sink - / :159 join)
         and self.package_dir reads (:122 is_dir - not a sink - / :125
         rmtree argument 0 / :146 mkdir receiver / :185 :217 :222 joins)
         -> derived joins -> the 15 write_text receivers.
       This is a bounded, evidence-anchored step: it only connects the four
       Project-specific attribute names inside the single generator core
       module, matching the labeled object-boundary summary exactly. */
    exists(string attr, Expr storedValue, Attribute read |
      projectAttrName(attr) and
      projectAttrStore(storedValue, attr) and
      read.getName() = attr and
      read.getObject().(Name).getId() = "self" and
      generatorCoreModule(normalizedPathOf(read)) and
      nodeFrom = DataFlow::exprNode(storedValue) and
      nodeTo = DataFlow::exprNode(read)
    )
  )
}

}

