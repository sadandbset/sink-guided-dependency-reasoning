import python
import semmle.python.dataflow.new.DataFlow

/**
 * Sink model for pass key "path_traversal". Declared as a module so the
 * query can address the predicate as `MySinks::isSink(node, passKey)`
 * after `import libraries.MySinks` (import paths use dots, name
 * qualification uses `::`).
 */
module MySinks {

/* ------------------------------------------------------------------ */
/* Shared scope helpers (private; identical to extraction/sinks.ql)     */
/* ------------------------------------------------------------------ */

/** Forward-slash-normalized absolute path of the file containing n, so path
 *  matching works with both CodeQL path styles on Windows. */
private string normalizedPathOf(AstNode n) {
  result = n.getLocation().getFile().getAbsolutePath().replaceAll("\\", "/")
}

/** The generator core module (openapi_python_client/__init__.py) - the only
 *  module of the audited package that performs filesystem operations, and
 *  the only module whose filesystem operations are Pass 1 sinks. */
bindingset[path]
private predicate generatorCoreModule(string path) {
  path.matches("%/openapi_python_client/__init__.py")
}

/* ------------------------------------------------------------------ */
/* Sink model                                                          */
/* ------------------------------------------------------------------ */

/**
 * Holds if `sink` is a Pass 1 (path traversal) taint sink for pass key
 * `passKey`. Renders the 21 reviewed tp sink labels (15 .write_text
 * receivers, 5 .mkdir receivers, 1 shutil.rmtree argument 0); see the file
 * header for the exact label IDs and the exclusion rationale.
 */
predicate isSink(DataFlow::Node sink, string passKey) {
  passKey = "path_traversal" and
  (
    /* K17/K19/K21/K23/K25/K30/K32/K34/K35/K37/K41/K45/K47/K49/K51
       (file_write, tp, 0.85-0.95): the 15 .write_text(...) calls in
       openapi_python_client/__init__.py - actual file writes of rendered
       jinja template output. The dangerous path parameter is the RECEIVER
       (the pathlib.Path object): the path escapes the intended CWD root via
       the title-derived base directory (all sites) and, at :197/:204/:235/
       :237, via the remote-controlled file NAME (module_name / raw tag).
       The first positional argument (the written content) is deliberately
       NOT the sink node. */
    exists(Call c, Attribute func |
      func = c.getFunc().(Attribute) and
      func.getName() = "write_text" and
      generatorCoreModule(normalizedPathOf(c)) and
      sink = DataFlow::exprNode(func.getObject())
    )
    or
    /* K10/K15/K27/K39/K43 (dir_create, tp, 0.90): the 5 .mkdir() calls in
       openapi_python_client/__init__.py (:109 project_dir, :146
       package_dir, :186 models_dir, :218 api_dir, :223 async_api_dir) -
       actual directory creation; the path is the RECEIVER. No containment
       validation of the title/config-derived base exists anywhere (the
       FileExistsError catch at :110 is an existence guard only). */
    exists(Call c, Attribute func |
      func = c.getFunc().(Attribute) and
      func.getName() = "mkdir" and
      generatorCoreModule(normalizedPathOf(c)) and
      sink = DataFlow::exprNode(func.getObject())
    )
    or
    /* K12 (dir_delete, tp, 0.95): shutil.rmtree(self.package_dir) at
       __init__.py:125 inside Project.update() - RECURSIVE directory
       deletion; argument 0 carries the path (package_dir = project_dir /
       package_name, both components title/config-derivable from the remote
       document). The sole preceding check is is_dir() (:122) - an existence
       check, not containment (check-then-act, TOCTOU-shaped). Highest-impact
       Pass 1 sink of this codebase. */
    exists(Call c, Attribute func |
      func = c.getFunc().(Attribute) and
      func.getName() = "rmtree" and
      func.getObject().(Name).getId() = "shutil" and
      generatorCoreModule(normalizedPathOf(c)) and
      sink = DataFlow::exprNode(c.getArg(0))
    )
  )
}

}

