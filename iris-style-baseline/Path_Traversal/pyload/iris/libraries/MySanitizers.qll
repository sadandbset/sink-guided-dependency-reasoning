import python
import semmle.python.dataflow.new.DataFlow

module MySanitizers {
  /** Unified pass key (see WORKFLOW.md section 5.1). */
  private string passKey() { result = "path_traversal" }

  /**
   * Holds if `node` is a proven traversal-sanitizing node for the
   * path-traversal pass. Barriers are placed on the sanitizer CALL
   * RESULTS: taint arriving at the call's arguments stops at the call
   * node, so only actually-normalized values flow downstream.
   */
  predicate isBarrier(DataFlow::Node node, string pass) {
    pass = passKey() and
    (
      purgeNameBarrier(node)
      or parseNameBarrier(node)
      or basenameNeutralizer(node)
    )
  }

  // ---------- helpers ----------

  /**
   * File scoping follows the proven extraction-query idiom
   * (extraction/sources.ql normalizedPathOf/excludedPath): the raw
   * absolute path is forward-slash normalized, then matched against
   * the fixed prefix + relPath pattern. bindingset[relPath] declares
   * that every caller passes a bound (literal) relPath; the parameter
   * occurs only in checked positions (string concatenation into
   * matches), which the QL binding analysis cannot bind on its own.
   */
  bindingset[relPath]
  private predicate inFile(AstNode n, string relPath) {
    n.getLocation().getFile().getAbsolutePath().replaceAll("\\", "/").matches("%/src/pyload/" + relPath)
  }

  // ---------- barriers ----------

  /**
   * purge.name(...) call results anywhere in the pyload tree (the
   * function is a pyload-internal sanitizer wherever it is applied).
   * Verified application sites: core/datatypes/pyfile.py:34
   * (PyFile._set_name, sep="") and
   * core/network/http/http_chunk.py:349 (content-disposition).
   * Label: P1-K-0635 (core/utils/purge.py:41, sanitizer tp 0.8).
   */
  private predicate purgeNameBarrier(DataFlow::Node node) {
    exists(Call c |
      node.asExpr() = c and
      c.getFunc().(Attribute).getName() = "name" and
      c.getFunc().(Attribute).getObject().(Name).getId() = "purge"
    )
  }

  /**
   * parse.name(...) call results: URL-derived names reduced to their
   * final component (core/utils/parse.py:40-47, basename at :45/:47).
   * Verified application: downloader.py:309 dl_basename.
   * Labels: P1-K-0571 (parse.py:45) and P1-K-0572 (parse.py:47), both
   * sanitizer tp 0.75.
   */
  private predicate parseNameBarrier(DataFlow::Node node) {
    exists(Call c |
      node.asExpr() = c and
      c.getFunc().(Attribute).getName() = "name" and
      c.getFunc().(Attribute).getObject().(Name).getId() = "parse"
    )
  }

  /**
   * os.path.basename call results at the four verified name-
   * neutralization sites (single-component file names before use):
   *   - http_request.py:252 (multipart FormFile filename),
   *   - plugins/extractors/HjSplit.py:57 (merge output name),
   *   - plugins/downloaders/ZDF.py:60 (media-id download name),
   *   - plugins/downloaders/LinksnappyComTorrent.py:195 (torrent url
   *     name).
   * basename calls elsewhere are propagation steps (MySummaries), not
   * barriers - e.g. ExtractArchive.py:302/:433 and YoutubeCom
   * basename rows are display/name assignments with no containment
   * claim in the labels.
   */
  private predicate basenameNeutralizer(DataFlow::Node node) {
    exists(Call c |
      node.asExpr() = c and
      c.getFunc().(Attribute).getName() = "basename" and
      c.getFunc().(Attribute).getObject().(Attribute).getName() = "path" and
      c.getFunc().(Attribute).getObject().(Attribute).getObject().(Name).getId() = "os" and
      (
        inFile(c, "core/network/http/http_request.py")
        or inFile(c, "plugins/extractors/HjSplit.py")
        or inFile(c, "plugins/downloaders/ZDF.py")
        or inFile(c, "plugins/downloaders/LinksnappyComTorrent.py")
      )
    )
  }
}
