  private predicate pathJoinStep(DataFlow::Node nodeFrom, DataFlow::Node nodeTo) {
    exists(Call c, int i |
      nodeFrom.asExpr() = c.getArg(i) and
      nodeTo.asExpr() = c and
      c.getFunc().(Attribute).getName() = "join" and
      c.getFunc().(Attribute).getObject().(Attribute).getName() = "path" and
      c.getFunc().(Attribute).getObject().(Attribute).getObject().(Name).getId() = "os"
    )
    or
    exists(Call c, int i |
      nodeFrom.asExpr() = c.getArg(i) and
      nodeTo.asExpr() = c and
      c.getFunc().(Name).getId() = "join" and
      inFile(c, "core/utils/fs.py")
