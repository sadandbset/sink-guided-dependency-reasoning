import python
import semmle.python.dataflow.new.DataFlow

module MySummaries {
  /** Unified pass key (see WORKFLOW.md section 5.1). */
  private string passKey() { result = "path_traversal" }

  /**
   * Holds if taint may flow from `from` to `to` in addition to the
   * default data-flow steps, for the path-traversal pass.
   */
  predicate isAdditionalTaintStep(DataFlow::Node nodeFrom, DataFlow::Node nodeTo, string pass) {
    pass = passKey() and
