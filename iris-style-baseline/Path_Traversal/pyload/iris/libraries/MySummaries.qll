   * '..'-strip and send_from_directory), and the CNL form entries
   * (P1-S-0045, cnl_blueprint.py:63).
   */
  private predicate urlDecodeStep(DataFlow::Node nodeFrom, DataFlow::Node nodeTo) {
    exists(Call c |
      nodeFrom.asExpr() = c.getArg(0) and
      nodeTo.asExpr() = c and
      c.getFunc().(Name).getId() = "unquote" and
      (
        inFile(c, "webui/app/blueprints/api_blueprint.py")
        or inFile(c, "webui/app/blueprints/app_blueprint.py")
        or inFile(c, "webui/app/blueprints/cnl_blueprint.py")
        or inFile(c, "webui/app/blueprints/json_blueprint.py")
        or inFile(c, "webui/app/helpers.py")
      )
    )
  }

  // ---------- path construction steps ----------

  /**
   * os.path.join: taint flows from EVERY argument to the joined
   * result (two-sided joins; the controlled component sits at index 1
   * or later - e.g. 'tmp_' + file.filename at
   * json_blueprint.py:154-156, 'tmp_' + container/filename at
