      nodeFrom.asExpr() = c.getArg(0) and
      nodeTo.asExpr() = c and
      c.getFunc().(Attribute).getName() in [
        "normpath", "realpath", "abspath", "relpath",
        "dirname", "basename", "split", "splitext",
      ] and
      c.getFunc().(Attribute).getObject().(Attribute).getName() = "path" and
      c.getFunc().(Attribute).getObject().(Attribute).getObject().(Name).getId() = "os"
