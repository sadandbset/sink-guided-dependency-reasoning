/**
 * Machine-generated by Augur 0.3.0 (Phase 2, Step 4) from
 * iris/labels/labels.json, pass 1 (Path Traversal, CWE-22/23/36/73).
 *
 * Source model: reviewed pass-1 labels with role=source (87 entries:
 * 85 tp + 2 candidate). Every family below is anchored at a genuine
 * input boundary verified in the pyLoad 0.5.0b3 source tree:
 *
 *   - http_form / http_args / http_values / http_auth / http_iter /
 *     http_file / http_file_name: the Flask request surface of the four
 *     webui blueprints and webui/app/helpers.py (form/args/values/
 *     authorization reads, request.files multipart upload, the
 *     FileStorage.filename attribute, and the args.items()/form.items()
 *     loop of the dynamic /api/<func> RPC dispatcher at
 *     api_blueprint.py:53). Permission gates on the routes are recorded
 *     per family below and in report/query_generation_notes.md.
 *   - route_param: rpc(func, args) (the /api/<func>[/<args>] dynamic RPC
 *     selector + literal_eval'd positional args), render(filename)
 *     (/render/<path:filename>) and get_file(path)
 *     (/files/get/<path:path>).
 *   - api_param: the six RPC-receiving core Api method parameters
 *     (set_config_value.value, add_package.name,
 *     check_online_status_container.container, set_package_name.name,
 *     upload_container.filename, set_package_data.data).
 *   - archive_entry: zipfile namelist() / tarfile getnames() return
 *     values (remote-controlled archive entry names).
 *
 * The two source entries classified `candidate` are modeled with their
 * caveats (see below); the cli/cli_arg rows (sys.argv, argparse fields)
 * are operator-trust and labeled none/fp, hence NOT modeled here, and
 * filemanager(path) (app_blueprint.py:439) was discarded in Phase 1
 * because its route declares no variable and the parameter is unused.
 *
 * Generated: 2026-10-23. Do not edit by hand; regenerate from labels.
 */

import python
import semmle.python.dataflow.new.DataFlow

module MySources {
  /** Unified pass key (see WORKFLOW.md section 5.1). */
  private string passKey() { result = "path_traversal" }

  /**
   * Holds if `source` is an untrusted input node for the path-traversal
   * pass, according to the reviewed pass-1 labels.
   */
  predicate isSource(DataFlow::Node source, string pass) {
    pass = passKey() and
    (
      flaskRequestRead(source)
      or multipartFilename(source)
      or routeParameter(source)
      or apiParameter(source)
      or apiDispatchSelector(source)
      or archiveEntryName(source)
    )
  }

  // ---------- helpers ----------

  /**
   * File scoping follows the proven extraction-query idiom
   * (extraction/sources.ql normalizedPathOf/excludedPath): the raw
   * absolute path is forward-slash normalized, then matched against
   * the fixed prefix + relPath pattern. bindingset[relPath] declares
   * that every caller passes a bound (literal) relPath; the parameter
   * occurs only in checked positions (string concatenation into
   * matches), which the QL binding analysis cannot bind on its own.
   */
  bindingset[relPath]
  private predicate inFile(AstNode n, string relPath) {
    n.getLocation().getFile().getAbsolutePath().replaceAll("\\", "/").matches("%/src/pyload/" + relPath)
  }

  private predicate inWebui(AstNode n) {
    inFile(n, "webui/app/blueprints/api_blueprint.py")
    or inFile(n, "webui/app/blueprints/app_blueprint.py")
    or inFile(n, "webui/app/blueprints/cnl_blueprint.py")
    or inFile(n, "webui/app/blueprints/json_blueprint.py")
    or inFile(n, "webui/app/helpers.py")
  }

  /**
   * The Attribute `flask.request.<name>` (name in form/args/values/
   * authorization/files). flask is imported as a plain module
   * (`import flask`) in every webui file, so the chain is
   * Attribute(<name>, Attribute(request, Name(flask))).
   */
  private predicate flaskRequestAttr(Attribute a) {
    a.getObject().(Attribute).getName() = "request" and
    a.getObject().(Attribute).getObject().(Name).getId() = "flask" and
    a.getName() in ["form", "args", "values", "authorization", "files"]
  }

  // ---------- Flask request boundary ----------

  /**
   * flask.request.<form|args|values|authorization>.get/getlist/items(...)
   * call results and flask.request.<form|args|values|files>[...] subscript
   * values in the five webui request files.
   *
   * Labels (http_form 49 + http_args 12 + http_values 1 + http_auth 2 +
   * http_iter 3 + http_file 1 entries, tp 0.7-0.95), e.g.:
   *   P1-S-0030 (api_blueprint.py:53, http_iter 0.95 - every query/form
   *     key becomes an RPC kwarg, unquote()d at :55 and literal_eval'd
   *     in call_api :72-75),
   *   P1-S-0026/P1-S-0027 (basic-auth credentials, api_blueprint.py:28-29),
   *   P1-S-0038 (pathchooser 'path', app_blueprint.py:257, login_required
   *     "STATUS"),
   *   P1-S-0043..P1-S-0059 (CNL /flash/* package/urls/passwords/crypted/jk
   *     fields, local_check localhost restriction cnl_blueprint.py:22-36),
   *   P1-S-0067..P1-S-0100 (/json/* form fields),
   *   P1-S-0071 (flask.request.files['add_file'], json_blueprint.py:148,
   *     login_required "ADD").
   *
   * Note: the form/args values are read AFTER Flask/Werkzeug's own URL
   * decoding of the transport; no additional decode step is needed for
   * them (unlike the raw route strings, handled via MySummaries).
   */
  private predicate flaskRequestRead(DataFlow::Node source) {
    exists(Call c |
      source.asExpr() = c and
      inWebui(c) and
      c.getFunc().(Attribute).getName() in ["get", "getlist", "items"] and
      flaskRequestAttr(c.getFunc().(Attribute).getObject().(Attribute))
    )
    or
    exists(Subscript s |
      source.asExpr() = s and
      inWebui(s) and
      flaskRequestAttr(s.getObject().(Attribute))
    )
  }

  /**
   * The FileStorage.filename attribute read in /json/add_package
   * (json_blueprint.py:150/:152/:155) - the client-supplied multipart
   * filename, used unsanitized in join(storage_folder, 'tmp_'+filename)
   * at :154-156 and file.save at :157.
   * Labels (http_file_name tp 0.95): P1-S-0072, P1-S-0073, P1-S-0074.
   * login_required("ADD") guards the route.
   */
  private predicate multipartFilename(DataFlow::Node source) {
    exists(Attribute a |
      source.asExpr() = a and
      inFile(a, "webui/app/blueprints/json_blueprint.py") and
      a.getScope() instanceof Function and
      a.getScope().(Function).getName() = "add_package" and
      a.getName() = "filename" and
      a.getObject().(Name).getId() = "file"
    )
  }

  // (multipartFilename above is wired into isSource directly)

  // ---------- route variables ----------

  /**
   * Route-variable parameters of the three path-relevant handlers:
   *   - rpc(func, args)  api_blueprint.py:24  (/api/<func>[/<args>],
   *     dynamic RPC: args are comma-split and literal_eval'd, func is
   *     filtered only by func.startswith('_') in call_api :68-70;
   *     permission checked via api.is_authorized :40-45).
   *   - render(filename) app_blueprint.py:34  (/render/<path:filename>).
   *   - get_file(path)   app_blueprint.py:161 (/files/get/<path:path>,
   *     login_required("DOWNLOAD")).
   * Labels (route_param tp 0.9-0.95): P1-S-0024, P1-S-0025, P1-S-0034,
   * P1-S-0037.
   */
  private predicate routeParameter(DataFlow::Node source) {
    exists(Parameter p, Function f |
      source = DataFlow::parameterNode(p) and
      f.getAnArg() = p and
      p.asName().getId() = "func" and
      f.getName() = "rpc" and
      inFile(f, "webui/app/blueprints/api_blueprint.py")
    )
    or
    exists(Parameter p, Function f |
      source = DataFlow::parameterNode(p) and
      f.getAnArg() = p and
      p.asName().getId() = "args" and
      f.getName() = "rpc" and
      inFile(f, "webui/app/blueprints/api_blueprint.py")
    )
    or
    exists(Parameter p, Function f |
      source = DataFlow::parameterNode(p) and
      f.getAnArg() = p and
      p.asName().getId() = "filename" and
      f.getName() = "render" and
      inFile(f, "webui/app/blueprints/app_blueprint.py")
    )
    or
    exists(Parameter p, Function f |
      source = DataFlow::parameterNode(p) and
      f.getAnArg() = p and
      p.asName().getId() = "path" and
      f.getName() = "get_file" and
      inFile(f, "webui/app/blueprints/app_blueprint.py")
    )
  }

  // ---------- core Api RPC boundary ----------

  /**
   * Parameters of the six RPC-receiving core Api methods
   * (core/api/__init__.py). These are the RECEIVER side of the dynamic
   * getattr(api, func) dispatch (api_blueprint.py:72-75), which the static
   * analysis cannot resolve; modeling the parameters directly is the
   * label-designed substitute (Phase 1 detection.json, uncoveredCases).
   * Labels (api_param):
   *   - P1-S-0010 set_config_value 'value' (candidate 0.6, Perms.SETTINGS
   *     via @permission; admin-config origin - FP-heuristic applies at
   *     triage; modeled for recall),
   *   - P1-S-0011 add_package 'name' (tp 0.85, Perms.ADD; sanitized into
   *     folder at :427-438 but stored RAW as package name),
   *   - P1-S-0012 check_online_status_container 'container' (tp 0.9,
   *     Perms.ADD; unsanitized 'tmp_'+container join at :535-540),
   *   - P1-S-0013 set_package_name 'name' (tp 0.75, Perms.MODIFY),
   *   - P1-S-0014 upload_container 'filename' (tp 0.9, Perms.ADD;
   *     unsanitized 'tmp_'+filename join at :951-956),
   *   - P1-S-0015 set_package_data 'data' (tp 0.9, Perms.MODIFY; the
   *     '_folder' setattr chain).
   */
  private predicate apiParameter(DataFlow::Node source) {
    exists(Parameter p, Function f |
      source = DataFlow::parameterNode(p) and
      f.getAnArg() = p and
      inFile(f, "core/api/__init__.py") and
      (
        (f.getName() = "set_config_value" and p.asName().getId() = "value")
        or (f.getName() = "add_package" and p.asName().getId() = "name")
        or (f.getName() = "check_online_status_container" and p.asName().getId() = "container")
        or (f.getName() = "set_package_name" and p.asName().getId() = "name")
        or (f.getName() = "upload_container" and p.asName().getId() = "filename")
        or (f.getName() = "set_package_data" and p.asName().getId() = "data")
      )
    )
  }

  /**
   * The dynamic-dispatch selector call_api(func) itself
   * (api_dispatch candidate 0.55, P1-S-0031 at api_blueprint.py:65):
   * the getattr(api, func) target string. It is externally controllable
   * (route variable) but is not a path value; it is modeled as a source
   * for label fidelity only - no path sink is reachable from it without
   * a dispatch edge, which is deliberately NOT created (see
   * report/query_generation_notes.md).
   */
  private predicate apiDispatchSelector(DataFlow::Node source) {
    exists(Parameter p, Function f |
      source = DataFlow::parameterNode(p) and
      f.getAnArg() = p and
      p.asName().getId() = "func" and
      f.getName() = "call_api" and
      inFile(f, "webui/app/blueprints/api_blueprint.py")
    )
  }

  // ---------- remote archive content ----------

  /**
   * Remote-controlled archive entry names: zipfile namelist() calls in
   * UnZip.py (:59 list(), :87 extract() members generator, :92 post-
   * extract file list) and tarfile getnames() calls in UnTar.py (:57
   * list(), :79 extract()).
   * Labels (archive_entry tp 0.9): P1-S-0001..P1-S-0005.
   */
  private predicate archiveEntryName(DataFlow::Node source) {
    exists(Call c |
      source.asExpr() = c and
      c.getFunc().(Attribute).getName() = "namelist" and
      inFile(c, "plugins/extractors/UnZip.py")
    )
    or
    exists(Call c |
      source.asExpr() = c and
      c.getFunc().(Attribute).getName() = "getnames" and
      inFile(c, "plugins/extractors/UnTar.py")
    )
  }
}
