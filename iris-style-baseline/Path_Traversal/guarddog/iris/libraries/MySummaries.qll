/*
 * Machine-generated by Augur Phase 2 Step 4 from iris/labels/labels.json
 * (run guarddog-iris-pass1-step3-20261022, pass 1 "Path Traversal",
 *  CWE-22/23/36/73, labeling model glm-5.3).
 *
 * DO NOT EDIT BY HAND: regenerate from labels instead.
 *
 * Additional taint steps: renders the `role=summary` entries of the reviewed
 * Pass 1 labels (src-08..src-26) plus the intermediate hops that those
 * labels' rationales assert but that TaintTracking::Global does not model
 * by default.
 *
 * Design rules (per the reviewed labels and real code only):
 *  1. Parameter-passing summaries (src-08/09/10/11/12/14/17/19/20/21/24/25/
 *     26) are already realized by TaintTracking::Global's default
 *     interprocedural edges (call argument -> parameter, return -> caller);
 *     they are NOT re-emitted here to avoid duplicate edges.
 *  2. Default taint steps already provided by python-all 7.1.2 and relied on:
 *     BinOp `+` and `%` (concatStep / stringManipulation), f-strings
 *     (Fstring), subscript reads `x[k]` (subscriptStep), container literals
 *     `[a, b]` / `(a, b)` / `{k: v}` (containerStep), `yield` content
 *     (yieldStoreStep), str methods incl. decode/split/splitlines/strip/
 *     replace/format/join (stringManipulation).
 *  3. Every step below is a specific node-to-node edge anchored to a real
 *     (file, line) site or a specific API (os.path.join), each citing the
 *     label it realizes. No arbitrary node-to-node propagation is created.
 *
 * Verified against codeql/python-all 7.1.2:
 *   API::moduleImport / API::builtin / API::Node.getMember / getACall
 *   DataFlow::CallCfgNode / MethodCallNode / exprNode / Node.asExpr
 *   AST classes Assign, Subscript, For, Attribute, Tuple, Name, Dict, List
 *
 * Revision 2026-10-22: parameters renamed from/to -> nodeFrom/nodeTo
 * (compile fix: `from` is a reserved QL keyword, see
 * report/query_generation_notes.md section 11a). Semantics unchanged.
 * Compile-verified: codeql query compile Pass1_PathTraversal.ql -> Done.
 */

import python
import semmle.python.ApiGraphs
import semmle.python.dataflow.new.DataFlow

/** Holds if `node` is at the labeled site (file base name, 1-based line). */
private predicate at(DataFlow::Node node, string file, int line) {
  node.getLocation().getFile().getBaseName() = file and
  node.getLocation().getStartLine() = line
}

/** Holds if the AST expression `e` is at the labeled (file, line) site. */
private predicate atExpr(Expr e, string file, int line) {
  e.getLocation().getFile().getBaseName() = file and
  e.getLocation().getStartLine() = line
}

module MySummaries {
  /**
   * Holds if taint may flow from `nodeFrom` to `nodeTo` in addition to the
   * default data-flow steps, for the given pass.
   *
   * `passKey` dispatches per Augur WORKFLOW 5.1.3; only "path_traversal"
   * (pass 1) is defined in this project so far.
   */
  predicate isAdditionalTaintStep(DataFlow::Node nodeFrom, DataFlow::Node nodeTo, string passKey) {
    passKey = "path_traversal" and
    (
      pathJoinStep(nodeFrom, nodeTo)                // S1  - labels src-14/20/21/24/25
      or removesuffixStep(nodeFrom, nodeTo)         // S2  - label src-25
      or listAppendStep(nodeFrom, nodeTo)           // S3  - label src-26
      or dictStoreStep(nodeFrom, nodeTo)            // S4  - label src-26
      or dictItemsStep(nodeFrom, nodeTo)            // S5  - label src-26
      or parseRequirementsStep(nodeFrom, nodeTo)    // S6  - label src-26
      or nextStep(nodeFrom, nodeTo)                 // S7  - label src-26
      or dictKeysStep(nodeFrom, nodeTo)             // S8  - labels src-04/29
      or sortedStep(nodeFrom, nodeTo)               // S9  - labels src-04/29
      or requirementNameStep(nodeFrom, nodeTo)      // S10 - label src-26
      or forIterationStep(nodeFrom, nodeTo)         // S11 - label src-26
      or starmapDispatchStep(nodeFrom, nodeTo)      // S12 - label src-26
      or pathWrapperStep(nodeFrom, nodeTo)          // S13 - label src-09
      or responseContentStep(nodeFrom, nodeTo)      // S14 - label src-30
    )
  }

  /**
   * S1 - os.path.join(...) argument -> call result.
   * Realizes labels src-14/20/21/24/25 (path construction into
   * file_path/zippath/unzippedpath/package_info paths).
   * Evidence sites: package_scanner.py:55,56,65,140; analyzer.py:29,30,171;
   * typosquatting.py:55,56 (internal, harmless). os.path.join is a pure
   * string-composition function: the result contains each argument, so
   * argument taint reaches the result. Not modeled by default (it is a
   * plain function call, not the str.join method).
   */
  private predicate pathJoinStep(DataFlow::Node nodeFrom, DataFlow::Node nodeTo) {
    exists(DataFlow::CallCfgNode joinCall |
      joinCall = API::moduleImport("os").getMember("path").getMember("join").getACall() and
      nodeFrom = joinCall.getArg(_) and
      nodeTo = joinCall
    )
  }

  /**
   * S2 - zippath.removesuffix(file_extension) receiver -> call result.
   * Realizes label src-25 (unzippedpath derivation).
   * Evidence: package_scanner.py:141 `unzippedpath =
   * zippath.removesuffix(file_extension)`; removesuffix is a plain string
   * truncation whose result derives from the receiver, and it is not in the
   * default str-method taint list of python-all 7.1.2.
   */
  private predicate removesuffixStep(DataFlow::Node nodeFrom, DataFlow::Node nodeTo) {
    exists(DataFlow::MethodCallNode call |
      at(call, "package_scanner.py", 141) and
      call.getMethodName() = "removesuffix" and
      nodeFrom = call.getObject() and
      nodeTo = call
    )
  }

  /**
   * S3 - list mutation: x.append(v) argument -> the list object created for
   * the same variable (x = [...] / x = []).
   * Realizes label src-26 (sanitized lines / params tuples accumulate
   * dependency names and versions).
   * Evidence: project_scanner.py:67 `sanitized_lines.append(stripped_line)`
   * (list created at :57 `sanitized_lines = []`), :198 and :201
   * `params.append((dependency, version))` (list created at :195
   * `params = []`). append mutates the receiver, so the appended value
   * taints the list object itself; the object node is the list literal of
   * the variable's creating assignment (matched via the shared Variable).
   */
  private predicate listAppendStep(DataFlow::Node nodeFrom, DataFlow::Node nodeTo) {
    exists(DataFlow::MethodCallNode call, Assign create, Variable listVar |
      call.getMethodName() = "append" and
      call.getLocation().getFile().getBaseName() = "project_scanner.py" and
      call.getObject().asExpr().(Name).getVariable() = listVar and
      create.getATarget().(Name).getVariable() = listVar and
      create.getLocation().getFile().getBaseName() = "project_scanner.py" and
      create.getValue() instanceof List and
      nodeFrom = call.getArg(0) and
      nodeTo = DataFlow::exprNode(create.getValue())
    )
  }

  /**
   * S4 - dict mutation: d[k] = v key/value -> the dict object created for
   * the same variable (d = {}).
   * Realizes label src-26 (dependency names and versions are stored into
   * the dependencies mapping).
   * Evidence: project_scanner.py:160 `dependencies[requirement.project_name]
   * = valid_versions` (dict created at :98 `dependencies = {}`). Subscript
   * assignment stores both the key (dependency name) and the value into
   * the dict object; python-all provides no store step for subscript
   * assignment (only for dict display literals).
   */
  private predicate dictStoreStep(DataFlow::Node nodeFrom, DataFlow::Node nodeTo) {
    exists(Assign store, Assign create, Variable dictVar |
      store.getLocation().getFile().getBaseName() = "project_scanner.py" and
      store.getATarget().(Subscript).getObject().(Name).getVariable() = dictVar and
      create.getATarget().(Name).getVariable() = dictVar and
      create.getLocation().getFile().getBaseName() = "project_scanner.py" and
      create.getValue() instanceof Dict and
      (
        nodeFrom = DataFlow::exprNode(store.getValue())
        or
        nodeFrom = DataFlow::exprNode(store.getATarget().(Subscript).getIndex())
      ) and
      nodeTo = DataFlow::exprNode(create.getValue())
    )
  }

  /**
   * S5 - dependencies.items() receiver -> call result.
   * Realizes label src-26 (iteration over the dependencies mapping at
   * scan_requirements).
   * Evidence: project_scanner.py:196 `for dependency, versions in
   * dependencies.items():`. items() returns the dict's (key, value) pairs
   * derived from the receiver; not in the default str-method taint list.
   */
  private predicate dictItemsStep(DataFlow::Node nodeFrom, DataFlow::Node nodeTo) {
    exists(DataFlow::MethodCallNode call |
      at(call, "project_scanner.py", 196) and
      call.getMethodName() = "items" and
      nodeFrom = call.getObject() and
      nodeTo = call
    )
  }

  /**
   * S6 - pkg_resources.parse_requirements(req) argument -> return value.
   * Realizes label src-26 (requirements text is parsed into dependency
   * specification objects).
   * Evidence: project_scanner.py:101 `parsed =
   * pkg_resources.parse_requirements(req)` inside the local generator
   * safe_parse_requirements. The external parser's results derive from its
   * input; CodeQL has no taint summary for pkg_resources.
   */
  private predicate parseRequirementsStep(DataFlow::Node nodeFrom, DataFlow::Node nodeTo) {
    exists(DataFlow::CallCfgNode call |
      call = API::moduleImport("pkg_resources").getMember("parse_requirements").getACall() and
      at(call, "project_scanner.py", 101) and
      nodeFrom = call.getArg(0) and
      nodeTo = call
    )
  }

  /**
   * S7 - next(parsed) argument -> return value.
   * Realizes label src-26 (generator advance yields the parsed requirement
   * objects to the caller's for-loop).
   * Evidence: project_scanner.py:104 `yield next(parsed)`. next() returns
   * an element of its argument; the builtin has no default taint step.
   */
  private predicate nextStep(DataFlow::Node nodeFrom, DataFlow::Node nodeTo) {
    exists(DataFlow::CallCfgNode call |
      call = API::builtin("next").getACall() and
      at(call, "project_scanner.py", 104) and
      nodeFrom = call.getArg(0) and
      nodeTo = call
    )
  }

  /**
   * S8 - data["releases"].keys() receiver -> call result.
   * Realizes labels src-04/29 (PyPI release keys become candidate
   * versions).
   * Evidence: project_scanner.py:93 `versions =
   * sorted(data["releases"].keys(), reverse=True)`. keys() returns the
   * receiver's keys; not in the default taint list.
   */
  private predicate dictKeysStep(DataFlow::Node nodeFrom, DataFlow::Node nodeTo) {
    exists(DataFlow::MethodCallNode call |
      at(call, "project_scanner.py", 93) and
      call.getMethodName() = "keys" and
      nodeFrom = call.getObject() and
      nodeTo = call
    )
  }

  /**
   * S9 - sorted(iterable) argument -> return value.
   * Realizes labels src-04/29 (version list ordering preserves taint).
   * Evidence: project_scanner.py:93 (same statement as S8). sorted()
   * returns a list of the argument's elements; the builtin has no default
   * taint step.
   */
  private predicate sortedStep(DataFlow::Node nodeFrom, DataFlow::Node nodeTo) {
    exists(DataFlow::CallCfgNode call |
      call = API::builtin("sorted").getACall() and
      at(call, "project_scanner.py", 93) and
      nodeFrom = call.getArg(0) and
      nodeTo = call
    )
  }

  /**
   * S10 - attribute read requirement.project_name: object -> attribute
   * value.
   * Realizes label src-26 (parsed dependency name extraction).
   * Evidence: project_scanner.py:122 and :124
   * `versions(requirement.project_name)` / error message, :160
   * `dependencies[requirement.project_name] = valid_versions`.
   * python-all's attributeReadStep is content-based (AttributeContent) and
   * does not propagate whole-object taint to attribute values, so a scoped
   * step is needed for the parsed requirement objects.
   */
  private predicate requirementNameStep(DataFlow::Node nodeFrom, DataFlow::Node nodeTo) {
    exists(Attribute attr |
      attr.getName() = "project_name" and
      attr.getObject().(Name).getId() = "requirement" and
      attr.getLocation().getFile().getBaseName() = "project_scanner.py" and
      (
        attr.getLocation().getStartLine() = 122
        or attr.getLocation().getStartLine() = 124
        or attr.getLocation().getStartLine() = 160
      ) and
      nodeFrom = DataFlow::exprNode(attr.getObject()) and
      nodeTo = DataFlow::exprNode(attr)
    )
  }

  /**
   * S11 - for-loop iteration over a whole-tainted iterable: iterable
   * expression -> each (Name) element of the loop target.
   * Realizes label src-26 (lines of the requirements text; dependency /
   * version pairs from dependencies.items()).
   * Evidence: project_scanner.py:59 `for line in requirements:` (the
   * scan_requirements parameter, a tainted list) and :196
   * `for dependency, versions in dependencies.items():` (items() result
   * tainted via S5). python-all deliberately provides no whole-object
   * taint read step for container iteration (only content-based reads), so
   * these two reviewed-label sites are bridged explicitly.
   */
  private predicate forIterationStep(DataFlow::Node nodeFrom, DataFlow::Node nodeTo) {
    exists(For f, Name target |
      f.getLocation().getFile().getBaseName() = "project_scanner.py" and
      (
        f.getLocation().getStartLine() = 59
        or f.getLocation().getStartLine() = 196
      ) and
      (
        target = f.getTarget().(Name)
        or target = f.getTarget().(Tuple).getAnElt().(Name)
      ) and
      nodeFrom = DataFlow::exprNode(f.getIter()) and
      nodeTo = DataFlow::exprNode(target)
    )
  }

  /**
   * S12 - multiprocessing dispatch: pool.starmap(get_package_results,
   * params) params argument -> the scan_remote call arguments inside the
   * worker function.
   * Realizes label src-26 (dependency names and versions reach
   * PackageScanner.scan_remote(dependency, version)).
   * Evidence: project_scanner.py:202-203 `pool =
   * pathos.helpers.mp.Pool(); project_results =
   * pool.starmap(get_package_results, params)` where
   * get_package_results = functools.partial(get_package_results_helper)
   * (:193) and get_package_results_helper(dependency, version) calls
   * self.package_scanner.scan_remote(dependency, version) at :190. The
   * child-process / functools.partial boundary is invisible to dataflow;
   * the edge injects taint at the argument expressions of the real call
   * site, after which default interprocedural steps carry it into
   * scan_remote. Both endpoints are concrete, code-verified nodes.
   */
  private predicate starmapDispatchStep(DataFlow::Node nodeFrom, DataFlow::Node nodeTo) {
    exists(DataFlow::MethodCallNode starmapCall, DataFlow::MethodCallNode scanRemoteCall |
      at(starmapCall, "project_scanner.py", 203) and
      starmapCall.getMethodName() = "starmap" and
      at(scanRemoteCall, "project_scanner.py", 190) and
      scanRemoteCall.getMethodName() = "scan_remote" and
      nodeFrom = starmapCall.getArg(1) and
      (
        nodeTo = scanRemoteCall.getArg(0)
        or nodeTo = scanRemoteCall.getArg(1)
      )
    )
  }

  /**
   * S13 - pathlib.Path(path) argument -> call result.
   * Realizes label src-09 (path -> Path(path) -> invoke_semgrep target
   * list).
   * Evidence: analyzer.py:149 `targetpath = Path(path)`; the Path object
   * wraps its argument. Scoped to this single site (the other Path calls at
   * analyzer.py:159/171 wrap the internal rules directory, which is never
   * tainted).
   */
  private predicate pathWrapperStep(DataFlow::Node nodeFrom, DataFlow::Node nodeTo) {
    exists(DataFlow::CallCfgNode call |
      call = API::moduleImport("pathlib").getMember("Path").getACall() and
      at(call, "analyzer.py", 149) and
      nodeFrom = call.getArg(0) and
      nodeTo = call
    )
  }

  /**
   * S14 - attribute read resp.content: object -> attribute value.
   * Realizes label src-30 (remote requirements.txt content reaches
   * scan_requirements).
   * Evidence: project_scanner.py:270 `return
   * self.scan_requirements(resp.content.decode().splitlines())` where resp
   * is the requests.get response at :267 (labeled source src-30). The
   * subsequent .decode()/.splitlines() propagation is provided by
   * python-all's default str-method taint steps; the attribute read is not
   * (content-based only), so this single site is bridged explicitly.
   */
  private predicate responseContentStep(DataFlow::Node nodeFrom, DataFlow::Node nodeTo) {
    exists(Attribute attr |
      attr.getName() = "content" and
      attr.getObject().(Name).getId() = "resp" and
      atExpr(attr, "project_scanner.py", 270) and
      nodeFrom = DataFlow::exprNode(attr.getObject()) and
      nodeTo = DataFlow::exprNode(attr)
    )
  }
}
