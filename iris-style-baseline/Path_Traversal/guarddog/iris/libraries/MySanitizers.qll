import python
import semmle.python.ApiGraphs
import semmle.python.dataflow.new.DataFlow

/** Holds if `node` is at the labeled site (file base name, 1-based line). */
private predicate at(DataFlow::Node node, string file, int line) {
  node.getLocation().getFile().getBaseName() = file and
  node.getLocation().getStartLine() = line
}

module MySanitizers {
  /**
   * Holds if `node` is a reviewed pass-1 barrier (sanitizer).
   *
   * `passKey` dispatches per Augur WORKFLOW 5.1.3; only "path_traversal"
   * (pass 1) is defined in this project so far.
   */
  predicate isBarrier(DataFlow::Node node, string passKey) {
    passKey = "path_traversal" and sink11TarsafeExtractallBarrier(node)
  }

  /**
   * Label sink-11 (sanitizer / candidate / 0.7):
   * `tarsafe.open(path).extractall(tmpdirname)` at
   * guarddog/scanners/package_scanner.py:46.
   *
   * What it blocks and why (per the reviewed label):
   * - tarsafe==0.0.4 (pinned in requirements.txt / pyproject.toml) is a
   *   path-sanitizing tar extraction wrapper that rejects traversal (".."),
   *   absolute, and symlink member names during extraction, in contrast to
   *   the unsanitized shutil.unpack_archive at :163.
   * - The destination is a fresh tempfile.TemporaryDirectory() (:45), so
   *   entry-name traversal is mitigated on this code path.
   *
   * QL realization: both call nodes on the wrapper chain are barriers -
   *   (a) the `tarsafe.open(path)` call node, and (b) the
   *       `.extractall(tmpdirname)` method call node -
   * so no taint passes through the tarsafe wrapper chain into the
   * extraction. Entry-name sanitation inside the archive is beyond
   * intra-program dataflow and is represented by this barrier only.
   *
   * Verification caveat (phase1_review.md R2): the tarsafe library source is
   * NOT part of the CodeQL database (only guarddog code is indexed); the
   * verdict rests on the pinned version's documented purpose and is
   * flagged for human review. In the current label set no source-to-sink
   * path traverses these nodes, so the barrier is currently vacuous; it is
   * included because the reviewed labels assign the sanitizer role, and it
   * becomes effective if the CLI-argument source gap (see
   * report/query_generation_notes.md G1) is ever closed.
   */
  private predicate sink11TarsafeExtractallBarrier(DataFlow::Node node) {
    // (a) tarsafe.open(path) call node at package_scanner.py:46
    exists(DataFlow::CallCfgNode openCall |
      openCall = API::moduleImport("tarsafe").getMember("open").getACall() and
      at(openCall, "package_scanner.py", 46) and
      node = openCall
    )
    or
    // (b) .extractall(tmpdirname) method call node at package_scanner.py:46
    exists(DataFlow::MethodCallNode extractCall |
      at(extractCall, "package_scanner.py", 46) and
      extractCall.getMethodName() = "extractall" and
      node = extractCall
    )
