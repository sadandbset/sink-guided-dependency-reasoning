/** Holds if `node` is at the labeled site (file base name, 1-based line). */
private predicate at(DataFlow::Node node, string file, int line) {
  node.getLocation().getFile().getBaseName() = file and
  node.getLocation().getStartLine() = line
}

module MySources {
