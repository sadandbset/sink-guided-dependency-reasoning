/**
 * Audited additional taint steps for the airflow path-traversal pass
 * MACHINE-GENERATED by Augur Phase 2 Step 4 from iris/labels/labels.json
 * (Pass 1: Path Traversal, CWE-22/23/36/73) - DO NOT EDIT BY HAND.
 * Propagation edges rendered from the audited summary labels: the pathlib.Path()
 * constructor (path text -> Path object, required so tainted path strings reach the
 * receiver-method sinks), the relative_fileloc relativization hops, the
 * correct_maybe_zipped/process_subdir/add_triggerer_suffix path transformers, and the
 * collect_dags forwarding. No arbitrary node-to-node propagation is introduced.
 * Rendered 54 audited label entries (role=summary); see
 * iris/report/query_generation_notes.md for the label-id -> rule mapping and
 * the source-code evidence behind every rule.
 */

import python
import semmle.python.dataflow.new.DataFlow

module MySummaries {
  /** Holds if taint may propagate from `nodeFrom` to `nodeTo` for pass `passKey`. */
  predicate isAdditionalTaintStep(DataFlow::Node nodeFrom, DataFlow::Node nodeTo, string passKey) {
    passKey = "path_traversal" and
    (
      pathConstructorStep(nodeFrom, nodeTo)
      or pathRelativizationStep(nodeFrom, nodeTo)
      or pathTransformerStep(nodeFrom, nodeTo)
    )
  }

  private predicate inDeployedCode(AstNode n) {
    n.getLocation().getFile().getAbsolutePath().matches("%/airflow/%") and
    not n.getLocation().getFile().getAbsolutePath().matches("%/example_dags/%") and
    not n.getLocation().getFile().getAbsolutePath().matches("%/airflow/migrations/%")
  }

  /**
   * pathlib.Path(path, ...) constructor: the constructed Path OBJECT carries taint from
   * the path TEXT in argument 0. This is a pure path construction (no filesystem access),
   * so the constructor itself is a propagation step, not a sink.
   */
  private predicate pathConstructorStep(DataFlow::Node nodeFrom, DataFlow::Node nodeTo) {
    exists(Call c |
      inDeployedCode(c) and
      nodeFrom = DataFlow::exprNode(c.getPositionalArg(0)) and
      nodeTo = DataFlow::exprNode(c) and
      (
        c.getFunc() instanceof Name and c.getFunc().(Name).getId() = "Path"
        or
        c.getFunc().(Attribute).getName() = "Path" and c.getFunc().(Attribute).getObject().(Name).getId() = "pathlib"
      )
    )
  }

  /**
   * Location anchor: node n sits at (site, line) in the analyzed tree.
   * bindingset: callers always pass literal site paths and line numbers.
   */
  bindingset[site, line]
  private predicate atSite(AstNode n, string site, int line) {
    n.getLocation().getFile().getAbsolutePath().matches("%/" + site) and
    n.getLocation().getStartLine() = line
  }

  /**
   * Path(...).relative_to(...) relativization hops in DAG.relative_fileloc /
   * DagModel.relative_fileloc (labels P1-K-0128 / P1-K-0135): taint on the Path receiver
   * flows to the relativized result (method-call receiver -> result is not default flow).
   */
  private predicate pathRelativizationStep(DataFlow::Node nodeFrom, DataFlow::Node nodeTo) {
    exists(Call rc |
      rc.getFunc().(Attribute).getName() = "relative_to" and
      (
(
        atSite(rc, "airflow/models/dag.py", 1287) and
        nodeFrom = DataFlow::exprNode(rc.getFunc().(Attribute).getObject()) and
        nodeTo = DataFlow::exprNode(rc)
      )
        or (
        atSite(rc, "airflow/models/dag.py", 3520) and
        nodeFrom = DataFlow::exprNode(rc.getFunc().(Attribute).getObject()) and
        nodeTo = DataFlow::exprNode(rc)
      )
      )
    )
  }

  /**
   * Audited path-transformer functions: parameter -> returned (transformed) path.
   * - correct_maybe_zipped (utils/file.py:166): redirects fileloc to the .zip archive
   *   path (rendered from the audited P1-K-0141 rationale; the function itself was not
   *   extracted as a wrapper because zipfile.is_zipfile is a probe, not a file access).
   * - process_subdir (utils/cli.py:173, P1-K-0557): DAGS_FOLDER substitution + ~ / .
   *   expansion, returns the expanded path.
   * - FileTaskHandler.add_triggerer_suffix (P1-K-0612): Path(full_path).as_posix() +
   *   trigger suffix, returns the derived log filename.
   */
  private predicate pathTransformerStep(DataFlow::Node nodeFrom, DataFlow::Node nodeTo) {
    exists(Function f, Parameter p, Return r |
      (f.getAnArg() = p or f.getKeywordOnlyArg(_) = p) and
      r.getScope() = f and
      nodeFrom = DataFlow::parameterNode(p) and
      nodeTo = DataFlow::exprNode(r.getValue()) and
      (
        (
          atSite(f, "airflow/utils/file.py", 166) and f.getName() = "correct_maybe_zipped" and
          p.getName() = "fileloc"
        )
        or
        (
          atSite(f, "airflow/utils/cli.py", 173) and f.getName() = "process_subdir" and
          p.getName() = "subdir"
        )
        or
        (
          atSite(f, "airflow/utils/log/file_task_handler.py", 194) and
          f.getName() = "add_triggerer_suffix" and p.getName() = "full_path"
        )
      )
    )
  }
}
