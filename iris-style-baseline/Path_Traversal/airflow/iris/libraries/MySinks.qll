/**
 * Audited taint sinks for the airflow path-traversal pass
 * MACHINE-GENERATED by Augur Phase 2 Step 4 from iris/labels/labels.json
 * (Pass 1: Path Traversal, CWE-22/23/36/73) - DO NOT EDIT BY HAND.
 * Sinks are real local filesystem accesses / file-serving responses at the dangerous
 * path position only: builtin open(path, ...), module-qualified os.* / shutil.* /
 * zipfile.ZipFile members (path at argument 0), flask send_from_directory (filename at
 * argument 1), importlib.machinery.SourceFileLoader (path at argument 1), pathlib
 * receiver-method calls at audited sites, and audited wrapper functions whose parameter
 * flows into the file-operation path. Path-text and file-object positions are kept
 * distinct (the Path() constructor itself is a MySummaries step, not a sink).
 * Rendered 269 audited label entries (role=sink); see
 * iris/report/query_generation_notes.md for the label-id -> rule mapping and
 * the source-code evidence behind every rule.
 */

import python
import semmle.python.dataflow.new.DataFlow

module MySinks {
  /** Holds if `sink` is an audited dangerous file-access position for pass `passKey`. */
  predicate isSink(DataFlow::Node sink, string passKey) {
    passKey = "path_traversal" and
    (
      builtinOpenSink(sink)
      or moduleQualifiedFsSink(sink)
      or sendFromDirectorySink(sink)
      or sourceFileLoaderSink(sink)
      or gzipOpenSink(sink)
      or receiverPathMethodSink(sink)
      or wrapperParamSink(sink)
    )
  }

  /** Only the deployed airflow package (labels excluded dev/, scripts/, docs/, example_dags/, migrations/, test trees). */
  private predicate inDeployedCode(AstNode n) {
    n.getLocation().getFile().getAbsolutePath().matches("%/airflow/%") and
    not n.getLocation().getFile().getAbsolutePath().matches("%/example_dags/%") and
    not n.getLocation().getFile().getAbsolutePath().matches("%/airflow/migrations/%")
  }

  /** builtin open(path, ...) - the path text is positional argument 0. */
  private predicate builtinOpenSink(DataFlow::Node sink) {
    exists(Call c |
      c.getFunc() instanceof Name and
      c.getFunc().(Name).getId() = "open" and
      inDeployedCode(c) and
      sink = DataFlow::exprNode(c.getPositionalArg(0))
    )
  }

  /** os.<member>(path, ...) / shutil.<member>(path, ...) / zipfile.ZipFile(path): path at argument 0. */
  private predicate moduleQualifiedFsSink(DataFlow::Node sink) {
    exists(Call c, Attribute func |
      func = c.getFunc().(Attribute) and
      func.getObject() instanceof Name and
      inDeployedCode(c) and
      sink = DataFlow::exprNode(c.getPositionalArg(0)) and
      (
        func.getObject().(Name).getId() = "os" and func.getName() in ["chmod", "listdir", "makedirs", "readlink", "remove", "stat", "symlink", "unlink", "walk"]
        or
        func.getObject().(Name).getId() = "shutil" and func.getName() in ["copy", "move", "rmtree"]
        or
        func.getObject().(Name).getId() = "zipfile" and func.getName() in ["ZipFile"]
      )
    )
  }

  /** flask send_from_directory(directory, filename, ...): the controlled filename is argument 1. */
  private predicate sendFromDirectorySink(DataFlow::Node sink) {
    exists(Call c |
      c.getFunc() instanceof Name and
      c.getFunc().(Name).getId() = "send_from_directory" and
      inDeployedCode(c) and
      sink = DataFlow::exprNode(c.getPositionalArg(1))
    )
  }

  /** importlib.machinery.SourceFileLoader(name, path).exec_module(): path at argument 1. */
  private predicate sourceFileLoaderSink(DataFlow::Node sink) {
    exists(Call c |
      c.getFunc().(Attribute).getName() = "SourceFileLoader" and
      c.getFunc().(Attribute).getObject().(Attribute).getName() = "machinery" and
      c.getFunc().(Attribute).getObject().(Attribute).getObject().(Name).getId() = "importlib" and
      inDeployedCode(c) and
      sink = DataFlow::exprNode(c.getPositionalArg(1))
    )
  }

  /**
   * Location anchor: node n sits at (site, line) in the analyzed tree.
   * bindingset: callers always pass literal site paths and line numbers.
   */
  bindingset[site, line]
  private predicate atSite(AstNode n, string site, int line) {
    n.getLocation().getFile().getAbsolutePath().matches("%/" + site) and
    n.getLocation().getStartLine() = line
  }

  /** gzip.open (imported as `gz` in the audited s3/gcs hooks): path at argument 0. */
  private predicate gzipOpenSink(DataFlow::Node sink) {
    exists(Call c |
      c.getFunc().(Attribute).getName() = "open" and
      c.getFunc().(Attribute).getObject().(Name).getId() = "gz" and
      sink = DataFlow::exprNode(c.getPositionalArg(0)) and
      (
(
        atSite(c, "airflow/providers/amazon/aws/hooks/s3.py", 1068)
      )
        or (
        atSite(c, "airflow/providers/google/cloud/hooks/gcs.py", 535)
      )
      )
    )
  }

  /**
   * pathlib-style receiver-path method calls at audited sites: .read_text()/.read_bytes()/
   * .write_text()/.write_bytes()/.mkdir()/.glob()/.chmod()/.open() where the RECEIVER
   * object is the path (the file object being opened is NOT the sink position).
   */
  private predicate receiverPathMethodSink(DataFlow::Node sink) {
    exists(Call c |
      c.getFunc() instanceof Attribute and
