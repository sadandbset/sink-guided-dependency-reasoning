/**
 * Audited taint sources for the airflow path-traversal pass
 * MACHINE-GENERATED by Augur Phase 2 Step 4 from iris/labels/labels.json
 * (Pass 1: Path Traversal, CWE-22/23/36/73) - DO NOT EDIT BY HAND.
 * Every predicate is anchored to the audited Pass 1 label set: flask/FAB request
 * reads, route-handler parameters, request-derived json.loads sites, signed-token
 * decode sites and request-data wrappers.
 * Rendered 631 audited label entries (role=source); see
 * iris/report/query_generation_notes.md for the label-id -> rule mapping and
 * the source-code evidence behind every rule.
 */

import python
import semmle.python.dataflow.new.DataFlow

module MySources {
  /** Holds if `source` is an audited external-input boundary for pass `passKey`. */
  predicate isSource(DataFlow::Node source, string passKey) {
    passKey = "path_traversal" and
    (
      flaskRequestAttrSource(source)
      or flaskRequestCallSource(source)
      or handlerParamSource(source)
      or requestWrapperCallSource(source)
      or requestDerivedLoadsSource(source)
      or signedTokenLoadsSource(source)
    )
  }

  /** Files whose module-level `request` name is the flask request proxy (verified in Pass 1). */
  private predicate inRequestBoundaryCode(AstNode n) {
    n.getLocation().getFile().getAbsolutePath().matches("%/airflow/www/%")
    or n.getLocation().getFile().getAbsolutePath().matches("%/airflow/api_connexion/%")
    or n.getLocation().getFile().getAbsolutePath().matches("%/airflow/utils/serve_logs.py")
    or n.getLocation().getFile().getAbsolutePath().matches("%/airflow/api/auth/%")
    or n.getLocation().getFile().getAbsolutePath().matches("%/airflow/providers/google/common/auth_backend/%")
  }

  /** A syntactic reference to the flask request proxy (request / www_request / flask_request / flask.request). */
  private predicate requestObject(Expr o) {
    o.(Name).getId() in ["request", "www_request", "flask_request"]
    or o.(Attribute).getName() = "request"
  }

  /** Attribute reads on the flask request proxy: request.args, request.form, request.files, ... */
  private predicate flaskRequestAttrSource(DataFlow::Node source) {
    exists(Attribute a |
      a.getName() in ["accept_mimetypes", "args", "files", "form", "headers", "host_url", "is_json", "json", "method", "path", "url", "values", "view_args"] and
      requestObject(a.getObject()) and
      inRequestBoundaryCode(a) and
      source = DataFlow::exprNode(a)
    )
  }

  /** Field-method calls on the request proxy: request.args.get(...), request.form.getlist(...), request.values.items(...). */
  private predicate flaskRequestCallSource(DataFlow::Node source) {
    exists(Call c, Attribute func |
      func = c.getFunc().(Attribute) and
      inRequestBoundaryCode(c) and
      source = DataFlow::exprNode(c) and
      (
        func.getName() in ["get", "getlist", "items"] and
        func.getObject().(Attribute).getName() in ["args", "form", "values", "json", "headers", "cookies"] and
        requestObject(func.getObject().(Attribute).getObject())
        or
        func.getName() = "get_json" and
        requestObject(func.getObject())
        or
        func.getName() = "best_match" and
        func.getObject().(Attribute).getName() = "accept_mimetypes" and
        requestObject(func.getObject().(Attribute).getObject())
      )
    )
  }

  /**
   * Parameters of externally routed handler functions (FAB @expose/@action views and
   * flask @*.route handlers in the www tree and the serve-logs app, connexion REST v1
   * handlers whose names are OpenAPI operationIds). `self` and the @provide_session
   * injected `session` parameters are not request data and are excluded.
   */
  private predicate handlerParamSource(DataFlow::Node source) {
    exists(Parameter p, Function f |
      source = DataFlow::parameterNode(p) and
      (f.getAnArg() = p or f.getKeywordOnlyArg(_) = p) and
      p.getName() != "session" and
      not p.isSelf() and
      handlerFunction(f)
    )
  }

  private predicate handlerFunction(Function f) {
    // FAB @expose(...) / @action(...) views and flask @<blueprint>.route(...) handlers
    (
      exists(Expr d |
        d = f.getADecorator() and
        (
          d.(Call).getFunc().(Name).getId() in ["expose", "action"]
          or d.(Call).getFunc().(Attribute).getName() = "route"
        ) and
        (
          f.getScope().getEnclosingModule().getName().matches("airflow.www.%")
          or f.getScope().getEnclosingModule().getName() = "airflow.utils.serve_logs"
        )
      )
    )
    or
    // connexion REST API v1 handlers: functions under airflow.api_connexion.endpoints
    // whose name is an operationId of openapi/v1.yaml (parameters injected by connexion)
    (
      f.getScope().getEnclosingModule().getName().matches("airflow.api_connexion.endpoints.%") and
      f.getName() in ["clear_dag_run", "delete_connection", "delete_dag", "delete_dag_run", "delete_pool", "delete_role", "delete_user", "delete_variable", "get_config", "get_connection", "get_connections", "get_dag", "get_dag_details", "get_dag_run", "get_dag_runs", "get_dag_source", "get_dag_warnings", "get_dags", "get_dataset", "get_dataset_events", "get_datasets", "get_event_log", "get_event_logs", "get_extra_links", "get_import_error", "get_import_errors", "get_log", "get_mapped_task_instance", "get_mapped_task_instances", "get_permissions", "get_plugins", "get_pool", "get_pools", "get_role", "get_roles", "get_task", "get_task_instance", "get_task_instances", "get_tasks", "get_upstream_dataset_events", "get_user", "get_users", "get_value", "get_variable", "get_variables", "get_xcom_entries", "get_xcom_entry", "patch_connection", "patch_dag", "patch_dags", "patch_mapped_task_instance", "patch_pool", "patch_role", "patch_task_instance", "patch_user", "patch_variable", "post_clear_task_instances", "post_dag_run", "post_set_task_instances_state", "set_dag_run_note", "set_mapped_task_instance_note", "set_task_instance_note", "update_dag_run_state"]
    )
  }

  /** Request-data wrappers: get_json_request_dict() -> request.get_json(); FAB urltools pagination/order args. */
  private predicate requestWrapperCallSource(DataFlow::Node source) {
    exists(Call c |
      c.getFunc() instanceof Name and
      c.getFunc().(Name).getId() in ["get_json_request_dict", "get_page_args", "get_order_args", "get_page_size_args"] and
      (
        c.getScope().getEnclosingModule().getName().matches("airflow.api_connexion.endpoints.%")
        or c.getScope().getEnclosingModule().getName().matches("airflow.www.%")
      ) and
      source = DataFlow::exprNode(c)
    )
  }

  /**
   * Location anchor: node n sits at (site, line) in the analyzed tree.
   * bindingset: callers always pass literal site paths and line numbers.
   */
  bindingset[site, line]
  private predicate atSite(AstNode n, string site, int line) {
    n.getLocation().getFile().getAbsolutePath().matches("%/" + site) and
    n.getLocation().getStartLine() = line
  }

  /**
   * json.loads call sites whose decoded argument is request-derived (verified in Pass 1:
   * request body/form fields, marshmallow _deserialize of request payloads, the varimport
   * multipart upload body, the Azure OIDC id_token payload).
   */
  private predicate requestDerivedLoadsSource(DataFlow::Node source) {
    exists(Call c |
      c.getFunc().(Attribute).getName() = "loads" and
      c.getFunc().(Attribute).getObject().(Name).getId() = "json" and
      source = DataFlow::exprNode(c) and
      (
atSite(c, "airflow/api/common/trigger_dag.py", 82)
        or atSite(c, "airflow/api_connexion/schemas/common_schema.py", 182)
        or atSite(c, "airflow/api_connexion/schemas/dag_run_schema.py", 48)
        or atSite(c, "airflow/www/decorators.py", 68)
        or atSite(c, "airflow/www/fab_security/manager.py", 731)
        or atSite(c, "airflow/www/forms.py", 153)
        or atSite(c, "airflow/www/validators.py", 77)
        or atSite(c, "airflow/www/views.py", 1598)
        or atSite(c, "airflow/www/views.py", 2110)
        or atSite(c, "airflow/www/views.py", 4769)
        or atSite(c, "airflow/www/views.py", 5170)
      )
    )
  }

  /**
   * Signed-token decode sites (itsdangerous URLSafeSerializer(...).loads(token) of the
   * /dagSources/file_token and get_log token parameters). Decoded value is
   * request-supplied but cryptographically constrained; kept per the audited
   * source/candidate labels for Phase 2 triage.
   */
  private predicate signedTokenLoadsSource(DataFlow::Node source) {
    exists(Call c |
      c.getFunc().(Attribute).getName() = "loads" and
      source = DataFlow::exprNode(c) and
      (
atSite(c, "airflow/api_connexion/endpoints/dag_source_endpoint.py", 37)
        or atSite(c, "airflow/api_connexion/endpoints/log_endpoint.py", 64)
      )
    )
  }
}
