/**
 * Machine-generated by Augur Phase 2 Step 4 (run gradio-pathtraversal-pass1-20261022).
 *
 * Source model for pass key "path_traversal" (Pass 1: CWE-22/23/36/73), rendered
 * deterministically from iris/labels/labels.json (pass 1, role=source).
 *
 * Coverage: 38 of the 39 source-role label entries (classification "tp").
 * The single "candidate" entry S51 (parameter `flag_index` of flag_data,
 * gradio/networking.py:276) is intentionally NOT modeled: it is unresolved
 * pending human review (labels/phase1_review.md section 6) and is a CSV row
 * index, not a filesystem path.
 *
 * Every source below was reviewed against the real sources in
 * gradio_vuln during Phase 1 Step 3; label IDs and evidence are kept in the
 * comments so this file stays traceable to the labels.
 */

import python
import semmle.python.dataflow.new.DataFlow

module MySources {
  /**
   * Holds if `source` is a reviewed taint source for the given pass key.
   * Interface consumed by queries/Pass1_PathTraversal.ql via
   * `MySources::isSource(source, "path_traversal")`.
   */
  predicate isSource(DataFlow::Node source, string passKey) {
    passKey = "path_traversal" and
    (
      flaskRequestJsonSource(source)          // S54-S58
      or flaskRoutePathParameter(source)      // S62, S64
      or interfaceDispatchParameter(source)   // S46, S47
      or componentPreprocessParameter(source) // S31-S44
      or processSingleFileParameter(source)   // S45
      or flagDataParameter(source)            // S48, S49, S50
      or queuePushParameter(source)           // S52, S53
      or saveFlaggedDataParameter(source)     // S03-S06, S10-S13
      or saveFlaggedFileDataParameter(source) // S30
    )
  }

  /** Holds if `n` is located in the gradio package file with the given (regexp-escaped) base name. */
  bindingset[baseName]
  private predicate inGradioFile(AstNode n, string baseName) {
    n.getLocation().getFile().getAbsolutePath().regexpMatch(".*[\\\\/]gradio[\\\\/]" + baseName)
  }

  /** Holds if `n` is the data-flow node for parameter `index` (0-based, including `self`) of `f`, named `name`. */
  private predicate parameterSource(DataFlow::Node n, Function f, int index, string name) {
    exists(Parameter p |
      p = f.getArg(index) and
      p.asName().getId() = name and
      n.(DataFlow::ParameterNode).getParameter() = p
    )
  }

  /**
   * S54-S58 (tp 0.6-0.9): `request.json[...]` subscript reads in the Flask POST
   * handlers of gradio/networking.py. External boundary: HTTP request body of
   * /api/predict (192), /api/flag (358), /api/interpret (368), /api/queue/push
   * (394, 395). Access condition: `@login_check` wrapper is a no-op unless the
   * operator configured app.auth (networking.py:84-95), so these are reachable
   * by any network client in the default configuration.
   * S59 (`request.json['hash']` in queue_status) is labeled none/fp and excluded.
   */
  private predicate flaskRequestJsonSource(DataFlow::Node source) {
    exists(Subscript s, Attribute json, Name req, Function f |
      source.asExpr() = s and
      s.getValue() = json and
      json.getName() = "json" and
      json.getObject() = req and
      req.getId() = "request" and
      s.getScope() = f and
      f.getName() in ["predict", "flag", "interpret", "queue_push"] and
      inGradioFile(f, "networking\\.py")
    )
  }

  /**
   * S62, S64 (tp 0.9): URL path variables of the Flask routes with a
   * `<path:path>` converter: `static_resource` (/static/, networking.py:139)
   * and `file` (/file/, networking.py:379). External boundary: URL path
   * segment, fully attacker-controlled including `..`, absolute-path and
   * separator variants.
   * S63 (`enable_sharing`, /enable_sharing/, networking.py:173) is labeled
   * none/fp (stored to config["share_url"] only) and excluded.
   * Note: the `file` handler is NOT treated as safe merely because it is a
   * handler parameter — it is a reviewed label whose intended sanitizer
   * `secure_filename` (networking.py:380) is not imported in that module.
   */
  private predicate flaskRoutePathParameter(DataFlow::Node source) {
    exists(Function f |
      f.getName() in ["static_resource", "file"] and
      f.getScope() instanceof Module and
      inGradioFile(f, "networking\\.py") and
      parameterSource(source, f, 0, "path")
    )
  }

  /**
   * S46, S47 (tp 0.9/0.75): `raw_input` parameters of Interface.process
   * (gradio/interface.py:363) and Interface.interpret (gradio/interface.py:377).
   * These are the verified dispatch targets of the /api/predict and
   * /api/interpret request payloads (networking.py:192 -> 196/201,
   * networking.py:368-370); process dispatches raw_input[i] to component
   * preprocess (interface.py:369-370) and interpret does the same
   * (interface.py:384-386). Modeled as sources so the flow does not depend on
   * CodeQL resolving the `app.interface.process(...)` dynamic dispatch.
   */
  private predicate interfaceDispatchParameter(DataFlow::Node source) {
    exists(Function f, Class c |
      f.getName() in ["process", "interpret"] and
      f.getScope() = c and
      c.getName() = "Interface" and
      inGradioFile(f, "interface\\.py") and
      parameterSource(source, f, 1, "raw_input")
    )
  }

  /**
   * S31-S44 (tp 0.6-0.95): `x` parameter of every InputComponent.preprocess
   * override in gradio/inputs.py (InputComponent, Textbox, Number, Slider,
   * Checkbox, CheckboxGroup, Radio, Dropdown, Image, Audio, Video, File,
   * Dataframe, Timeseries). External boundary: raw request JSON payload for
   * one input component, dispatched from Interface.process/interpret. The
   * File/Video/Audio variants (S43, S42, S33) carry the client-controlled
   * `name` field and the client-settable `is_example` flag that reach
   * filesystem paths (inputs.py:998-1004, 915-921, 1172-1182); the scalar
   * components are kept at 0.6 confidence for conservative recall per the
   * reviewed labels.
   */
  private predicate componentPreprocessParameter(DataFlow::Node source) {
    exists(Function f |
      f.getName() = "preprocess" and
      inGradioFile(f, "inputs\\.py") and
      parameterSource(source, f, 1, "x")
    )
  }

  /**
   * S45 (tp 0.95): parameter `f` of the nested helper process_single_file
   * inside File.preprocess (gradio/inputs.py:1171). `f` is the per-file request
   * dict: f["name"] is the client-supplied filename and
   * f.get("is_example", False) is client-settable; when is_example is true,
   * f["name"] is used directly as the path argument of open() (inputs.py:1180)
   * and create_tmp_copy_of_file (inputs.py:1175).
   */
  private predicate processSingleFileParameter(DataFlow::Node source) {
    exists(Function f |
      f.getName() = "process_single_file" and
      inGradioFile(f, "inputs\\.py") and
      parameterSource(source, f, 0, "f")
    )
  }

  /**
   * S48, S49, S50 (tp 0.75/0.75/0.6): parameters of flag_data
   * (gradio/networking.py:276), fed directly from the /api/flag request JSON
   * (networking.py:358-360) and from /api/predict auto-flagging
   * (networking.py:212-214). input_data[i]/output_data[i] are dispatched to
   * component save_flagged (networking.py:285-290) reaching
   * decode_base64_to_file and the temp-file write path.
   * S51 (`flag_index`, parameter index 3) is classification "candidate" and is
   * intentionally not modeled (CSV row index, not a path; see
   * labels/phase1_review.md).
   */
  private predicate flagDataParameter(DataFlow::Node source) {
    exists(Function f |
      f.getName() = "flag_data" and
      f.getScope() instanceof Module and
      inGradioFile(f, "networking\\.py") and
      (
        parameterSource(source, f, 0, "input_data")
        or parameterSource(source, f, 1, "output_data")
        or parameterSource(source, f, 2, "flag_option")
      )
    )
  }

  /**
   * S52, S53 (tp 0.7/0.6): parameters of queue.push (gradio/queue.py:68),
   * receiving the /api/queue/push request JSON (networking.py:394-396). The
   * job is persisted to sqlite and re-posted by queue_thread to the local
   * /api/<task_type>/ endpoint (networking.py:408-416), re-entering
   * Interface.process — the HTTP round-trip is modeled by labeling the queue
   * entry parameters as sources (second-order boundary), not by a flow step.
   */
  private predicate queuePushParameter(DataFlow::Node source) {
    exists(Function f |
      f.getName() = "push" and
      f.getScope() instanceof Module and
      inGradioFile(f, "queue\\.py") and
      (
        parameterSource(source, f, 0, "input_data")
        or parameterSource(source, f, 1, "action")
      )
    )
  }

  /**
   * S03-S06, S10-S13 (tp 0.8): `data` parameter of save_flagged in the
   * file-carrying component overrides — Image/Video/Audio/File in
   * gradio/inputs.py (863, 941, 1115, 1194) and gradio/outputs.py (242, 297,
   * 440, 549). External boundary: flagged request base64 (including the
   * client-controlled data-URI header) persisted under the flagging dir via
   * save_flagged_file -> decode_base64_to_file. The json.dumps-only
   * save_flagged overrides (Label, Dataframe, CheckboxGroup, Timeseries,
   * KeyValues, HighlightedText, JSON, Carousel) are labeled none/fp and are
   * not matched here.
   */
  private predicate saveFlaggedDataParameter(DataFlow::Node source) {
    exists(Function f, Class c |
      f.getName() = "save_flagged" and
      f.getScope() = c and
      c.getName() in ["Image", "Video", "Audio", "File"] and
      (inGradioFile(f, "inputs\\.py") or inGradioFile(f, "outputs\\.py")) and
      parameterSource(source, f, 3, "data")
    )
  }

  /**
   * S30 (tp 0.75): `data` parameter of Component.save_flagged_file
   * (gradio/component.py:48). Receives the flagged request base64 string and
   * writes it to disk through decode_base64_to_file -> tempfile (component.py:51)
   * and shutil.move (component.py:65). Destination dir/name are
   * server-generated; the tempfile prefix/suffix surface is the sink modeled
   * in MySinks (K03/K04).
   */
  private predicate saveFlaggedFileDataParameter(DataFlow::Node source) {
    exists(Function f, Class c |
      f.getName() = "save_flagged_file" and
      f.getScope() = c and
      c.getName() = "Component" and
      inGradioFile(f, "component\\.py") and
      parameterSource(source, f, 3, "data")
    )
  }
}
