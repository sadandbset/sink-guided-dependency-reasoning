/**
 * Machine-generated by Augur Phase 2 Step 4 (run gradio-pathtraversal-pass1-20261022).
 *
 * Sink model for pass key "path_traversal" (Pass 1: CWE-22/23/36/73), rendered
 * deterministically from iris/labels/labels.json (pass 1, role=sink).
 *
 * Coverage: 15 of the 17 sink-role label entries (classification "tp").
 * The two "candidate" entries are intentionally NOT modeled, pending the
 * human review requested in labels/phase1_review.md section 6:
 *   - K25: shutil.move argument 1 (gradio/component.py:65) — index-based
 *     destination with an extension derived from the client data-URI header.
 *   - K45: os.path.getsize (gradio/outputs.py:545) — argument is the predict
 *     function's returned path, not request-derived in gradio's own flow.
 *
 * Every sink below is an actual file access / file response / file-modification
 * API at its dangerous PATH argument position (per the reviewed labels); the
 * file OBJECT returned by open()/send_file() is not used as a sink, and
 * Path()/join()/string wrappers are treated as propagation, not as sinks.
 */

import python
import semmle.python.dataflow.new.DataFlow

module MySinks {
  /**
   * Holds if `sink` is a reviewed taint sink for the given pass key.
   * Interface consumed by queries/Pass1_PathTraversal.ql via
   * `MySinks::isSink(sink, "path_traversal")`.
   */
  predicate isSink(DataFlow::Node sink, string passKey) {
    passKey = "path_traversal" and
    (
      ffmpegPathSink(sink)                // K01, K02
      or namedTemporaryFileNameSink(sink) // K03-K06
      or audioExportFilenameSink(sink)    // K19
      or openPathSink(sink)               // K26, K27, K35, K41
      or sendFilePathSink(sink)           // K42, K44
      or audioFromFileSink(sink)          // K46
      or shutilCopySourceSink(sink)       // K47
    )
  }

  /** Holds if `n` is located in the gradio package file with the given (regexp-escaped) base name. */
  bindingset[baseName]
  private predicate inGradioFile(AstNode n, string baseName) {
    n.getLocation().getFile().getAbsolutePath().regexpMatch(".*[\\\\/]gradio[\\\\/]" + baseName)
  }

  /** Holds if `call` is a plain call to the (imported-by-name) function `callee`, e.g. open, send_file, FFmpeg, safe_join. */
  private predicate plainCall(Call call, string callee) {
    call.getFunc() instanceof Name and
    call.getFunc().(Name).getId() = callee
  }

  /** Holds if `call` is `moduleName.memberName(...)`, e.g. tempfile.NamedTemporaryFile, shutil.copy2, AudioSegment.from_file. */
  private predicate moduleCall(Call call, string moduleName, string memberName) {
    exists(Attribute a, Name obj |
      call.getFunc() = a and
      a.getName() = memberName and
      a.getObject() = obj and
      obj.getId() = moduleName
    )
  }

  /** Holds if `call` appears directly in the body of the function named `funcName`. */
  private predicate inFunction(Call call, string funcName) {
    call.getScope() instanceof Function and
    call.getScope().getName() = funcName
  }

  /** Holds if `sink` is the node of positional argument `index` of `call`. */
  private predicate argSink(DataFlow::Node sink, Call call, int index) {
    sink.asExpr() = call.getPositionalArg(index)
  }

  /**
   * K01, K02 (tp 0.6/0.75): ffmpy.FFmpeg(inputs={...}, outputs={...}) followed
   * by .run() spawns an ffmpeg subprocess that READS the files named by the
   * keys of the `inputs` dict and WRITES the files named by the keys of the
   * `outputs` dict.
   *   - K02: gradio/inputs.py:926, inside Video.preprocess — both dict paths
   *     derive from decode_base64_to_file temp names whose prefix/extension
   *     come from the client-supplied `name` (inputs.py:915-930).
   *   - K01: gradio/outputs.py:283, inside Video.postprocess — `y` is the
   *     predict function's returned path.
   * Label flow kind is keyword-controlled (arg index not applicable), so the
   * sink node is modeled as the `inputs`/`outputs` dict argument itself and
   * the key expressions inside it (the actual file paths). Callers: `ff.run()`
   * at inputs.py:930 / outputs.py:287.
   */
  private predicate ffmpegPathSink(DataFlow::Node sink) {
    exists(Call call, Keyword kw, Dict dict |
      plainCall(call, "FFmpeg") and
      kw = call.getANamedArg() and
      kw.getArg() in ["inputs", "outputs"] and
      kw.getValue() = dict and
      (
        (inGradioFile(call, "inputs\\.py") and inFunction(call, "preprocess"))
        or
        (inGradioFile(call, "outputs\\.py") and inFunction(call, "postprocess"))
      ) and
      (
        sink.asExpr() = dict
        or sink.asExpr() = dict.getAnItem().(KeyValuePair).getKey()
      )
    )
  }

  /**
   * K03-K06 (tp 0.8/0.65): tempfile.NamedTemporaryFile(prefix=..., suffix=...)
   * creates a file; the prefix/suffix keyword values are the dangerous
   * filename components.
   *   - K03/K04: inside decode_base64_to_file (processing_utils.py:149, 151).
   *     In the flagging flow `file_path` is None, so prefix/suffix derive from
   *     the client-controlled data-URI header parsed in decode_base64_to_binary
   *     (processing_utils.py:124-135) with no separator filtering — a suffix
   *     containing path separators can redirect file creation outside the temp
   *     dir (the random body and O_EXCL constrain but do not canonicalize).
   *   - K05/K06: inside create_tmp_copy_of_file (processing_utils.py:165, 167).
   *     prefix/extension pass through os.path.basename (processing_utils.py:159-163),
   *     which strips separators.
   * Callers: decode_base64_to_file is called from Component.save_flagged_file
   * (component.py:51) and File/Video/Audio preprocess (inputs.py:1003, 919, 1177);
   * create_tmp_copy_of_file from Video/Audio/File preprocess is_example branches
   * (inputs.py:917, 1001, 1175).
   */
  private predicate namedTemporaryFileNameSink(DataFlow::Node sink) {
    exists(Call call, Keyword kw |
      moduleCall(call, "tempfile", "NamedTemporaryFile") and
      inGradioFile(call, "processing_utils\\.py") and
      (
        inFunction(call, "decode_base64_to_file")
        or inFunction(call, "create_tmp_copy_of_file")
      ) and
      kw = call.getANamedArg() and
      kw.getArg() in ["prefix", "suffix"] and
      sink.asExpr() = kw.getValue()
    )
  }

  /**
   * K19 (tp 0.65): pydub AudioSegment.export(filename, format="wav") inside
   * audio_to_file (processing_utils.py:111-118) — audio file WRITE at
   * positional argument 0. In-package call sites pass tempfile-generated
   * names (inputs.py:1007, 1033, 1067, 1076, 1101).
   */
  private predicate audioExportFilenameSink(DataFlow::Node sink) {
    exists(Call call |
      call.getFunc() instanceof Attribute and
      call.getFunc().(Attribute).getName() = "export" and
      inGradioFile(call, "processing_utils\\.py") and
      inFunction(call, "audio_to_file") and
      argSink(sink, call, 0)
    )
  }

  /**
   * K26, K27, K35, K41 (tp 0.6-0.95): builtin open(path, ...) — file READ or
   * WRITE per the mode argument — at positional argument 0:
   *   - K26: get_url_or_file_as_bytes (processing_utils.py:28), open(path, "rb")
   *     in the requests.get fallback; no in-package callers (public helper).
   *   - K27: encode_file_to_base64 (processing_utils.py:41), open(f, "rb");
   *     fed by example values (interface.py:309-314) and model-output paths.
   *   - K35: the /file route handler `file` (networking.py:382),
   *     open(os.path.join(app.cwd, path), "rb") — request-derived path; the
   *     intended sanitizer secure_filename (networking.py:380) is NOT imported
   *     in this module and is not modeled as a barrier.
   *   - K41: process_single_file (inputs.py:1180), open(file_name, "rb") where
   *     file_name = f["name"], the client-supplied filename used whenever the
   *     client-settable is_example flag is true and File type is "bytes" —
   *     arbitrary file read returned into the response pipeline.
   */
  private predicate openPathSink(DataFlow::Node sink) {
    exists(Call call |
      plainCall(call, "open") and
      argSink(sink, call, 0) and
      (
        (inGradioFile(call, "processing_utils\\.py") and inFunction(call, "get_url_or_file_as_bytes"))
        or
        (inGradioFile(call, "processing_utils\\.py") and inFunction(call, "encode_file_to_base64"))
        or
        (inGradioFile(call, "networking\\.py") and inFunction(call, "file"))
        or
        (inGradioFile(call, "inputs\\.py") and inFunction(call, "process_single_file"))
      )
    )
  }

  /**
   * K42, K44 (tp 0.85/0.9): Flask send_file(path) — file READ served as an
   * HTTP file response — at positional argument 0:
   *   - K42: static_resource (networking.py:143),
   *     send_file(safe_join(STATIC_PATH_LIB, path)) — the path argument is the
   *     safe_join call; werkzeug safe_join enforces containment (barrier, see
   *     MySanitizers).
   *   - K44: the /file route handler (networking.py:388),
   *     send_file(os.path.join(app.cwd, path)) — no working sanitizer on the
   *     path.
   * K43 (send_file(io.BytesIO(...)) at networking.py:386) is labeled none/fp
   * (in-memory buffer) and not matched.
   */
  private predicate sendFilePathSink(DataFlow::Node sink) {
    exists(Call call |
      plainCall(call, "send_file") and
      argSink(sink, call, 0) and
      inGradioFile(call, "networking\\.py") and
      (
        inFunction(call, "static_resource")
        or inFunction(call, "file")
      )
    )
  }

  /**
   * K46 (tp 0.65): pydub AudioSegment.from_file(filename) inside audio_from_file
   * (processing_utils.py:100-101) — audio file READ at positional argument 0.
   * In-package call sites pass tempfile-generated names; note inputs.py:1052
   * passes the raw base64 string (latent bug, not a path traversal).
   */
  private predicate audioFromFileSink(DataFlow::Node sink) {
    exists(Call call |
      moduleCall(call, "AudioSegment", "from_file") and
      inGradioFile(call, "processing_utils\\.py") and
      inFunction(call, "audio_from_file") and
      argSink(sink, call, 0)
    )
  }

  /**
   * K47 (tp 0.95): shutil.copy2(file_path, file_obj.name) inside
   * create_tmp_copy_of_file (processing_utils.py:158-168) — file READ/COPY at
   * positional argument 0. file_path is the client-supplied `name` whenever
   * the client-settable is_example flag is true (inputs.py:917, 1001, 1175).
   * Argument 1 (the tempfile destination) is labeled none/fp and not matched;
   * the related candidate K25 (shutil.move destination in component.py:65) is
   * not modeled.
   */
  private predicate shutilCopySourceSink(DataFlow::Node sink) {
    exists(Call call |
      moduleCall(call, "shutil", "copy2") and
      inGradioFile(call, "processing_utils\\.py") and
      inFunction(call, "create_tmp_copy_of_file") and
      argSink(sink, call, 0)
    )
  }
}
