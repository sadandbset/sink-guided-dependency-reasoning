import python
import semmle.python.dataflow.new.DataFlow

module MySanitizers {
  /**
   * Holds if data flow through `node` is prohibited for the given pass key.
   * Interface consumed by queries/Pass1_PathTraversal.ql via
   * `MySanitizers::isBarrier(node, "path_traversal")`.
   */
  predicate isBarrier(DataFlow::Node node, string passKey) {
    passKey = "path_traversal" and
    safeJoinContainmentBarrier(node)
  }

  /**
   * Barrier for S62/K42: werkzeug.security.safe_join(STATIC_PATH_LIB, path)
   * at gradio/networking.py:143, in the /static/<path:path> route handler
   * `static_resource` (safe_join is imported at networking.py:30).
   *
   * Why this blocks the specific traversal mechanisms (verified semantics of
   * werkzeug safe_join, not just the function name):
   *   - it joins the base directory with the request path and rejects the
   *     result unless it is strictly contained under the base directory;
   *   - `..` segments, absolute paths, and separator variants that would
   *     escape STATIC_PATH_LIB cause a NotFound (404) exception instead of a
   *     file response — no file is opened in that case;
   *   - the check happens on the joined value BEFORE send_file reads the file
   *     (single expression, no check/use gap).
   * The barrier node is the safe_join CALL node itself: the request-derived
   * `path` taint flows into the call arguments, and removing the call node
   * from the flow graph stops propagation to the send_file path argument
   * (which is this same call expression).
   *
   * Symlink note: safe_join does not resolve symlinks; on a compromised
   * static directory a symlink could bypass containment. No symlinks exist in
   * the packaged template tree, and the package itself never creates any —
   * recorded as not applicable for this codebase.
   */
  private predicate safeJoinContainmentBarrier(DataFlow::Node node) {
    exists(Call call |
      plainCall(call, "safe_join") and
      inGradioFile(call, "networking\\.py") and
      call.getScope() instanceof Function and
      call.getScope().getName() = "static_resource" and
      node.asExpr() = call
    )
  }

  /** Holds if `n` is located in the gradio package file with the given (regexp-escaped) base name. */
  bindingset[baseName]
  private predicate inGradioFile(AstNode n, string baseName) {
    n.getLocation().getFile().getAbsolutePath().regexpMatch(".*[\\\\/]gradio[\\\\/]" + baseName)
  }

  /** Holds if `call` is a plain call to the (imported-by-name) function `callee`. */
  private predicate plainCall(Call call, string callee) {
    call.getFunc() instanceof Name and
    call.getFunc().(Name).getId() = callee
  }
}
