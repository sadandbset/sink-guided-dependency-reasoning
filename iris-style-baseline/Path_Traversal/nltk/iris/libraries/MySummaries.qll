    /* p1-k-280 (candidate, conf 0.50) */
    (c.getFunc().(Attribute).getName() = "join" and
      normalizedPathOf(c).matches("%/nltk/tokenize/stanford_segmenter.py") and
      c.getLocation().getStartLine() = 181)
    or
    /* ---- nltk/twitter/twitterclient.py ---- */
    /* p1-k-290 (tp, conf 0.70) */
    (c.getFunc().(Attribute).getName() = "join" and
      normalizedPathOf(c).matches("%/nltk/twitter/twitterclient.py") and
      c.getLocation().getStartLine() = 499)
    or
    /* ---- nltk/twitter/util.py ---- */
    /* p1-k-307 (tp, conf 0.70) */
    (c.getFunc().(Attribute).getName() = "normpath" and
      normalizedPathOf(c).matches("%/nltk/twitter/util.py") and
      c.getLocation().getStartLine() = 84)
    or
    /* p1-k-308 (tp, conf 0.70) */
    (c.getFunc().(Attribute).getName() = "join" and
      normalizedPathOf(c).matches("%/nltk/twitter/util.py") and
      c.getLocation().getStartLine() = 85)
    or
    /* p1-k-311 (fp, conf 0.80) */
    (c.getFunc().(Attribute).getName() = "join" and
      normalizedPathOf(c).matches("%/nltk/twitter/util.py") and
      c.getLocation().getStartLine() = 130)
    or
    /* p1-k-314 (tp, conf 0.55) */
    (c.getFunc().(Attribute).getName() = "expanduser" and
      normalizedPathOf(c).matches("%/nltk/twitter/util.py") and
      c.getLocation().getStartLine() = 152)
    or
    /* p1-k-315 (tp, conf 0.55) */
    (c.getFunc().(Attribute).getName() = "join" and
      normalizedPathOf(c).matches("%/nltk/twitter/util.py") and
      c.getLocation().getStartLine() = 152)
  }
  /** Cross-function handoff edges (see class docs). Each edge group is
   *  anchored to audited source parameters and audited attribute loads. */
  private predicate auditedHandoffStep(DataFlow::Node nodeFrom, DataFlow::Node nodeTo) {
    /* Edge A (labels p1-s-023..p1-s-028, evidence cites downloader.py:270,
     * :700, :710, :718, :740): the **xml.attrib expansions of
     * Package.fromxml (:288) / Collection.fromxml (:330) pass the network
     * index attributes into the constructor parameters; default dataflow
     * does not model **kwargs dict expansion, so the audited source nodes
     * are connected to the Package/Collection constructor parameters
     * (id/url/name/subdir/children - the path-relevant subset). */
    exists(Attribute a |
      a.getName() = "attrib" and
      a.getObject().(Name).getId() = "xml" and
      normalizedPathOf(a).matches("%/nltk/downloader.py") and
      a.getLocation().getStartLine() in [288, 330] and
      nodeFrom.asExpr() = a and
      nodeTo instanceof IndexCtorParam
    )
    or
    /* Edge B1 (labels p1-s-023..p1-s-028 + summary p1-k-147: filename =
     * join(subdir, id + ext) :270): Package constructor params subdir/id ->
     * the info.filename attribute loads that feed join(download_dir, ...)
     * at :700 and :888 (summary p1-k-148 feeds sinks p1-k-157/p1-k-181). */
    exists(Attribute a, IndexCtorParam pn |
      pn.getParam().getName() in ["subdir", "id"] and
      a.getName() = "filename" and
      a.getObject().(Name).getId() = "info" and
      normalizedPathOf(a).matches("%/nltk/downloader.py") and
      a.getLocation().getStartLine() in [700, 888] and
      nodeFrom = pn and
      nodeTo.asExpr() = a
    )
    or
    /* Edge B2 (same labels; evidence cites mkdir :710 / zipdir :740):
     * Package param subdir -> info.subdir loads at :709/:710/:740. */
    exists(Attribute a, IndexCtorParam pn |
      pn.getParam().getName() = "subdir" and
      a.getName() = "subdir" and
      a.getObject().(Name).getId() = "info" and
      normalizedPathOf(a).matches("%/nltk/downloader.py") and
      a.getLocation().getStartLine() in [709, 710, 740] and
      nodeFrom = pn and
      nodeTo.asExpr() = a
    )
    or
    /* Edge B3 (labels p1-s-023..p1-s-028; evidence cites :743): Package param
     * id -> the info.id load of the unzip-existence probe at :743. */
    exists(Attribute a, IndexCtorParam pn |
      pn.getParam().getName() = "id" and
      a.getName() = "id" and
      a.getObject().(Name).getId() = "info" and
      normalizedPathOf(a).matches("%/nltk/downloader.py") and
      a.getLocation().getStartLine() = 743 and
      nodeFrom = pn and
      nodeTo.asExpr() = a
    )
    or
    /* Edge E1 (labels p1-s-012, p1-s-013; evidence cites data.py:354 -> :345):
     * FileSystemPathPointer.__init__ param _path -> the self._path field
     * loads in open (:345), file_size (:351), join (:354) and the
     * GzipFileSystemPathPointer.open variant (:482/:484). Guarantees the
     * audited pointer-join channel even where default field flow is limited. */
    exists(Attribute a, PointerParamNode pn |
      pn.getParam().getName() = "_path" and
      a.getName() = "_path" and
      a.getObject().(Name).getId() = "self" and
      normalizedPathOf(a).matches("%/nltk/data.py") and
      a.getLocation().getStartLine() in [345, 351, 354, 482, 484] and
      nodeFrom = pn and
      nodeTo.asExpr() = a
    )
    or
    /* Edge E2 (labels p1-s-001/p1-s-002; evidence cites api.py:213 ->
     * data.py:354 -> :345): CorpusReader.__init__ param root -> the
     * self._root loads in abspath (:168) and open (:213), and the self.root
     * property loads of the crubadan reader (:78/:97) and the mte reader
     * (:269) whose hand-rolled joins are audited summaries. */
    exists(Attribute a, CorpusRootParamNode pn |
      (
        (a.getName() = "_root" and a.getObject().(Name).getId() = "self" and
          normalizedPathOf(a).matches("%/nltk/corpus/reader/api.py") and
          a.getLocation().getStartLine() in [168, 213])
        or
        (a.getName() = "root" and a.getObject().(Name).getId() = "self" and
          normalizedPathOf(a).matches("%/nltk/corpus/reader/crubadan.py") and
          a.getLocation().getStartLine() in [78, 97])
        or
        (a.getName() = "_root" and a.getObject().(Name).getId() = "self" and
          normalizedPathOf(a).matches("%/nltk/corpus/reader/mte.py") and
          a.getLocation().getStartLine() = 269)
      ) and
      nodeFrom = pn and
      nodeTo.asExpr() = a
    )
  }

  /** Parameter nodes of Package.__init__ / Collection.__init__ (the XML index
   *  attribute receivers; path-relevant names only). */
  private class IndexCtorParam extends DataFlow::ParameterNode {
    Parameter p;

    IndexCtorParam() {
      p = getParameter() and
      exists(Function f |
        p = f.getAnArg() and
        f.getName() = "__init__" and
        f.getEnclosingScope() instanceof Class and
        f.getEnclosingScope().(Class).getName() in ["Package", "Collection"] and
        normalizedPathOf(f).matches("%/nltk/downloader.py") and
        p.getName() in ["id", "url", "name", "subdir", "children"]
      )
    }

    /** The wrapped audited parameter (QL fields are class-local). */
    Parameter getParam() { result = p }
  }

  /** Parameter node of FileSystemPathPointer.__init__ (_path). */
  private class PointerParamNode extends DataFlow::ParameterNode {
    Parameter p;

    PointerParamNode() {
      p = getParameter() and
      exists(Function f |
        p = f.getAnArg() and
        f.getName() = "__init__" and
        f.getEnclosingScope() instanceof Class and
        f.getEnclosingScope().(Class).getName() = "FileSystemPathPointer" and
        normalizedPathOf(f).matches("%/nltk/data.py") and
        p.getName() = "_path"
      )
    }

    /** The wrapped audited parameter (QL fields are class-local). */
    Parameter getParam() { result = p }
  }

  /** Parameter node of CorpusReader.__init__ (root). */
  private class CorpusRootParamNode extends DataFlow::ParameterNode {
    Parameter p;

    CorpusRootParamNode() {
      p = getParameter() and
      exists(Function f |
        p = f.getAnArg() and
        f.getName() = "__init__" and
        f.getEnclosingScope() instanceof Class and
        f.getEnclosingScope().(Class).getName() = "CorpusReader" and
        normalizedPathOf(f).matches("%/nltk/corpus/reader/api.py") and
        p.getName() = "root"
      )
    }

    /** The wrapped audited parameter (QL fields are class-local). */
    Parameter getParam() { result = p }
  }
}
