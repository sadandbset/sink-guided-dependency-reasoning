 * Rendering rule: every label entry is matched by an AST-level, location-anchored
 * predicate using only API shapes proven against codeql CLI 2.25.1 +
 * codeql/python-all (see extraction/sources.ql): AstNode.getLocation().getFile().
 * getAbsolutePath(), Location.getStartLine(), Call.getFunc()/getArg()/getAnArg(),
 * Attribute.getName()/getObject(), Name.getId(), Function.getName()/getAnArg()/
 * getEnclosingScope(), Class.getName(), Parameter.getName()/isSelf()/getPosition().
 */

import python
import semmle.python.dataflow.new.DataFlow

/** Forward-slash-normalized absolute path of the file containing n (same
 *  proven shape as extraction/sources.ql). */
private string normalizedPathOf(AstNode n) {
  result = n.getLocation().getFile().getAbsolutePath().replaceAll("\\", "/")
}


module MySummaries {
  /**
   * Pass 1 additional taint steps. Two kinds, both evidence-anchored:
   *
   * 1. propagationCallStep: each role=summary label entry (os.path.join /
   *    abspath / normpath / expanduser / url2pathname / unquote_plus call
   *    sites) contributes ANY-ARGUMENT -> CALL-RESULT edges. Rationale: at
   *    every audited site the traversal-bearing component may be any operand
   *    of the pure path-construction call (e.g. find() joins
   *    os.path.join(path_, url2pathname(resource_name)) at data.py:650,
   *    where the tainted operand is the SECOND argument), so an arg0-only
   *    rendering would miss the audited flow. This is local, per-callsite
   *    propagation of the audited nodes only - no unconditional cross-function
   *    taint. The labels record arg_index 0 for these rows; the any-argument
   *    widening is a documented rendering decision (report/
   *    query_generation_notes.md), not a label change.
   *
   * 2. auditedHandoffStep: the six cross-function handoffs that the audited
   *    labels' evidence strings cite but that syntax-level extraction cannot
   *    span (detection.json uncoveredCases: "a MySummaries step is needed to
   *    trace info.filename/info.subdir end-to-end"). Each is anchored to
   *    specific audited source parameters and specific consuming attribute
   *    loads, listed in edgeTable below with the label ids that cite them.
   */
  predicate isAdditionalTaintStep(DataFlow::Node nodeFrom, DataFlow::Node nodeTo, string passKey) {
    passKey = "path_traversal" and
    (propagationCallStep(nodeFrom, nodeTo) or auditedHandoffStep(nodeFrom, nodeTo))
  }

  /** Any-argument -> result edges at the audited call sites. */
  private predicate propagationCallStep(DataFlow::Node nodeFrom, DataFlow::Node nodeTo) {
    exists(Call c |
      auditedSummaryCall(c) and
      nodeFrom.asExpr() = c.getAnArg() and
      nodeTo.asExpr() = c
    )
  }

