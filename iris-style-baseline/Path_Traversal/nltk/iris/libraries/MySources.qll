 */

import python
import semmle.python.dataflow.new.DataFlow

/** Forward-slash-normalized absolute path of the file containing n (same
 *  proven shape as extraction/sources.ql). */
private string normalizedPathOf(AstNode n) {
  result = n.getLocation().getFile().getAbsolutePath().replaceAll("\\", "/")
}

module MySources {
  /**
   * True iff `node` is a Pass 1 (path_traversal) taint source per the audited
   * labels/labels.json entries. Sources are exactly the reviewed, externally
   * controllable input boundaries: the wordnet browser HTTP request path, the
   * downloader's network XML index attributes and package zip entry names, and
   * the public library API parameters (the application-facing boundary of the
   * nltk library). Operator-trust rows (os.environ.get, input()) were labeled
   * role=none and are deliberately NOT sources. `passKey` gates the pass.
   */
  predicate isSource(DataFlow::Node node, string passKey) {
    passKey = "path_traversal" and
    (
      httpPathSource(node) or
      netXmlAttrSource(node) or
      netFetchSource(node) or
      archiveEntrySource(node) or
      node instanceof AuditedSourceParameter
    )
  }

  /* p1-s-068 (source/tp 0.95): the ONLY remotely reachable boundary - the raw
   * request path read in MyServerHandler.do_GET; HTTPServer(('', port),
   * MyServerHandler) at wordnet_app.py:247 binds all interfaces. */
  private predicate httpPathSource(DataFlow::Node node) {
    exists(Attribute a |
      a.getName() = "path" and
      a.getObject().(Name).getId() = "self" and
      normalizedPathOf(a).matches("%/nltk/app/wordnet_app.py") and
      a.getLocation().getStartLine() = 98 and
      node.asExpr() = a
    )
  }

  /* p1-s-023..p1-s-028 (source/tp 0.85): xml.attrib reads in Package.fromxml
   * (:286/:287/:288) and Collection.fromxml (:327/:328/:330) - attributes of
   * the index XML downloaded at downloader.py:962; they become Package
   * filename/subdir path components (see MySummaries edges for the handoff). */
  private predicate netXmlAttrSource(DataFlow::Node node) {
    exists(Attribute a |
      a.getName() = "attrib" and
      a.getObject().(Name).getId() = "xml" and
      normalizedPathOf(a).matches("%/nltk/downloader.py") and
      a.getLocation().getStartLine() in [286, 287, 288, 327, 328, 330] and
      node.asExpr() = a
    )
  }

  /* p1-s-035 (source/tp 0.7): urlopen(self._url) at :962 - the network entry
   * point of the downloader index channel (ElementTree.parse -> xml.attrib). */
  private predicate netFetchSource(DataFlow::Node node) {
    exists(Call c |
      c.getFunc().(Name).getId() = "urlopen" and
      normalizedPathOf(c).matches("%/nltk/downloader.py") and
      c.getLocation().getStartLine() = 962 and
      node.asExpr() = c
    )
  }

  /* p1-s-046 (source/tp 0.9): zf.namelist() at :2264 in _unzip_iter - entry
   * names of the DOWNLOADED package zip; they drive the unfiltered
   * join(root, *pieces) -> mkdir/open extraction (zip-slip, CWE-22). */
  private predicate archiveEntrySource(DataFlow::Node node) {
    exists(Call c, Attribute func |
      func = c.getFunc().(Attribute) and
      func.getName() = "namelist" and
      normalizedPathOf(c).matches("%/nltk/downloader.py") and
      c.getLocation().getStartLine() = 2264 and
      node.asExpr() = c
    )
  }

  /* The 37 role=source lib_api_param entries: definition-side Parameters of
   * the library's path-taking public APIs, ported 1:1 from the proven
   * extraction/sources.ql fileApiParamShape, minus the 3 entries the labels
   * classified role=none: build_index root (operator tooling),
   * ZipFilePathPointer entry + ZipFilePathPointer.join fileid (in-archive
   * member names that never become filesystem paths). */
  private class AuditedSourceParameter extends DataFlow::ParameterNode {
    Parameter p;

    AuditedSourceParameter() {
      p = getParameter() and
      exists(Function f | p = f.getAnArg() and auditedSourceParameter(f, p))
    }
  }

