import python
import semmle.python.dataflow.new.DataFlow

/** Forward-slash-normalized absolute path of the file containing n (same
 *  proven shape as extraction/sources.ql). */
private string normalizedPathOf(AstNode n) {
  result = n.getLocation().getFile().getAbsolutePath().replaceAll("\\", "/")
}


module MySinks {
  /**
   * True iff `node` is the dangerous path ARGUMENT (always position 0 in the
   * audited labels) of an audited filesystem-access call: file open
   * (open/codecs.open/GzipFile/BufferedGzipFile/gzip.open), archive open
   * (zipfile.ZipFile/OpenOnDemandZipFile), sqlite db open, directory
   * create/list/walk, or file remove. The node is the path TEXT argument,
   * never the opened file object. Guard reads (exists/isfile/stat/...) and
   * pure path construction (join/normpath/decode) are NOT sinks - they are
   * rendered in MySummaries/absent per the audited labels.
   */
  predicate isSink(DataFlow::Node node, string passKey) {
    passKey = "path_traversal" and
    exists(Call c | auditedSinkCall(c) and node.asExpr() = c.getArg(0))
  }

