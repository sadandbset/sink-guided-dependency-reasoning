   */
  private predicate reviewedSqlConstruction(DataFlow::Node sink) {
    // % formatting — arches/app/models/concept.py:635 (p5-k-091, tp)
    exists(BinaryExpr b |
      b.getLocation().getFile().getRelativePath() = "arches/app/models/concept.py" and
      b.getLocation().getStartLine() = 635 and
      b.getOp() instanceof Mod and
      (
        sink = DataFlow::exprNode(b)
        or sink = DataFlow::exprNode(b.getLeft())
        or sink = DataFlow::exprNode(b.getRight())
      )
    )
    or
    // .format(...) template calls — the seven reviewed sites
    exists(Call c |
      c.getFunc().(Attribute).getName() = "format" and
      reviewedFormatConstructionSite(c) and
      (
        sink = DataFlow::exprNode(c)
        or
        exists(int i |
          i in [0 .. 8] and
          sink = DataFlow::exprNode(c.getPositionalArg(i))
        )
        or
        exists(Keyword k |
          k = c.getANamedArg() and
          sink = DataFlow::exprNode(k.getValue())
        )
      )
    )
  }

  /** Holds if `c` is one of the reviewed .format SQL-construction call sites. */
  private predicate reviewedFormatConstructionSite(Call c) {
    (
      c.getLocation().getFile().getRelativePath() = "arches/app/views/concept.py" and
      c.getLocation().getStartLine() = 424                          // p5-k-140 tp
    )
    or
    (
      c.getLocation().getFile().getRelativePath() = "arches/app/models/concept.py" and
      c.getLocation().getStartLine() in [653, 1180]                 // p5-k-092 / p5-k-099 tp
    )
    or
    (
      c.getLocation().getFile().getRelativePath() = "arches/management/commands/export.py" and
      c.getLocation().getStartLine() in [55, 61, 67]                // p5-k-182/184/187 candidate
    )
    or
    (
      c.getLocation().getFile().getRelativePath() = "arches/app/utils/v3migration.py" and
      c.getLocation().getStartLine() = 49                           // p5-k-129 candidate
    )
