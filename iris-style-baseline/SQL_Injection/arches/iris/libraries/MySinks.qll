  /* ------------------------------------------------------------------ */
  /* Family C: general django.db cursor execute channel (API-bound)     */
  /* ------------------------------------------------------------------ */

  /**
   * Sink node: the query-text argument (argument 0) of `execute` calls on a
   * django.db `connection.cursor()` cursor, resolved through API graphs
   * (alias-aware: `from django.db import connection`,
   * `with connection.cursor() as cursor`, local cursor variables). This is
   * the same binding the stock PEP249/Django framework models use, verified
   * against semmle/python/frameworks/Django.qll (DjangoDbConnection) and
   * Pep249.qll (DefaultDatabaseCursor / ExecuteMethodCall).
   *
   * The channel is receiver-accurate (not name-only inference): the receiver
   * must resolve to django.db.connection.cursor(). The reviewed v3migration
   * psycopg2 cursor is NOT covered here (it is covered by its pinned site in
   * family A); `callproc` is not a sink (constant procedure names, labels fp).
   */
  private predicate djangoCursorExecuteSqlText(DataFlow::Node sink) {
    exists(API::CallNode call |
      call =
        API::moduleImport("django").getMember("db").getMember("connection")
            .getMember("cursor").getReturn().getMember("execute").getACall()
      and
      sink = call.getArg(0)
    )
  }
}
