import python
import semmle.python.ApiGraphs
import semmle.python.dataflow.new.DataFlow

module MySinks {

  /** Pass key of the formal pass-5 query (single key this round). */
  private string formalKey() { result = "sql_injection" }

  /**
   * Holds if `sink` is a reviewed pass-5 SQL-injection sink for `passKey`.
   *
   * The sink node is either the query-text argument (positional argument 0) of
   * an SQL execution call, or a reviewed SQL construction expression.
   */
  predicate isSink(DataFlow::Node sink, string passKey) {
    passKey = formalKey() and
    (
      reviewedExecuteSqlText(sink)
      or reviewedSqlConstruction(sink)
      or djangoCursorExecuteSqlText(sink)
    )
  }

  /* ------------------------------------------------------------------ */
  /* Family A: reviewed execute() query-text argument sites             */
  /* ------------------------------------------------------------------ */

  /**
   * The authoritative reviewed execute-site table: (file, line) of every
   * `cursor.execute` call whose argument 0 is a reviewed (tp or candidate)
   * SQL-text sink. Sites and receivers verified in the tree:
   *   arches/app/views/concept.py:426           cursor.execute(sql)
   *   arches/app/models/concept.py:723          cursor.execute(sql)
   *   arches/app/models/concept.py:1216         cursor.execute(sql)
   *   arches/management/commands/export.py:55   cursor.execute("SELECT * FROM {0}".format(table))
   *   arches/management/commands/export.py:61   cursor.execute("SELECT count(*) ...".format(table, ...))
   *   arches/management/commands/packages.py:611 cursor.execute(sql)   [sql = f.read()]
   *   arches/management/commands/packages.py:623 cursor.execute(sql)   [sql = f.read()]
   *   arches/app/utils/v3migration.py:54        self.dbcursor.execute(sql)  [direct psycopg2]
   *   arches/app/utils/index_database.py:343    cursor.execute(sql)
   *   arches/app/utils/index_database.py:370    cursor.execute("SELECT count(*) ...".format(valueTypes))
   */
  private predicate reviewedExecuteSite(string file, int line) {
    file = "arches/app/views/concept.py" and line = 426                  // p5-k-141 tp
    or
    file = "arches/app/models/concept.py" and line = 723                 // p5-k-094 tp
    or
    file = "arches/app/models/concept.py" and line = 1216                // p5-k-100 tp
    or
    file = "arches/management/commands/export.py" and line = 55          // p5-k-183 candidate
    or
    file = "arches/management/commands/export.py" and line = 61          // p5-k-185 candidate
    or
    file = "arches/management/commands/packages.py" and line = 611       // p5-k-193 candidate
    or
    file = "arches/management/commands/packages.py" and line = 623       // p5-k-195 candidate
    or
    file = "arches/app/utils/v3migration.py" and line = 54              // p5-k-130 candidate
    or
    file = "arches/app/utils/index_database.py" and line = 343          // p5-k-116 candidate
    or
    file = "arches/app/utils/index_database.py" and line = 370          // p5-k-118 candidate
  }

  /**
   * Sink node: positional argument 0 (the query text) of the reviewed
   * `cursor.execute(...)` call sites. Argument 1 — the bound-parameter
   * tuple/list — is never matched here (see MySanitizers).
   */
  private predicate reviewedExecuteSqlText(DataFlow::Node sink) {
    exists(Call c, string file, int line |
      reviewedExecuteSite(file, line) and
      c.getLocation().getFile().getRelativePath() = file and
      c.getLocation().getStartLine() = line and
      c.getFunc().(Attribute).getName() = "execute" and
      sink = DataFlow::exprNode(c.getPositionalArg(0))
    )
  }

  /* ------------------------------------------------------------------ */
  /* Family B: reviewed SQL construction sites                           */
  /* ------------------------------------------------------------------ */

  /**
   * Sink node: the reviewed SQL *construction* expressions — the taint
   * interpolation points themselves.
   *
   * %-formatting sites (BinaryExpr with Mod operator; sink is the BinaryExpr
   * and its operands — CodeQL's built-in Mod taint step flows the operands
   * into the BinaryExpr, so matching either node ends a path at the site):
   *   arches/app/models/concept.py:635  (p5-k-091, tp)
   *     `"..., results as (... WHERE LOWER(values.value) like '%%%s%%' ...)"`
   *     `% query.lower()` — the request-derived query in the LIKE literal.
   *
   * .format(...) template call sites (sink is the format call node and its
   * arguments — CodeQL's built-in str.format taint step flows the arguments
   * into the call result):
   *   arches/app/views/concept.py:424   (p5-k-140, tp)  sql.format(query=...)
   *   arches/app/models/concept.py:653  (p5-k-092, tp)  sql.format(..., subquery=...)
   *   arches/app/models/concept.py:1180 (p5-k-099, tp)  "...'{0}'".format(conceptid)
   *   arches/management/commands/export.py:55 (p5-k-182, candidate) "SELECT * FROM {0}".format(table)
   *   arches/management/commands/export.py:61 (p5-k-184, candidate) "SELECT count(*) ... {0} ... {1}".format(...)
