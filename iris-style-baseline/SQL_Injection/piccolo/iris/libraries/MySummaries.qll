 *
 * Project : piccolo (piccolo_vuln source tree, CodeQL DB sha e4946d8)
 * Pass    : 5 (CWE-089 SQL Injection)
 * Pass key: "sql_injection"
 * Labels  : iris/labels/labels.json, run `piccolo-iris-pass5-20261021`
 *
 * Additional taint steps compiled from the reviewed Pass 5 `role=summary`
 * label entries. Every step is code-evidenced and conditional; no
 * unconditional receiver-to-member propagation is introduced.
 *
 * The library stores SQL-relevant identifiers in dataclasses whose __init__
 * is GENERATED by @dataclass (no explicit store is visible to local data
 * flow), and then interpolates `self.<field>` into SQL text inside
 * ddl/querystring/target_string properties. Three precise steps bridge the
 * reviewed source boundaries (p5-src-008/012/013) to the reviewed sinks
 * (p5-snk-004a/009/013):
 *
 *  1. ctorArgToFieldRead (snk-09/13 evidence):
 *     an argument of a construction call to a labeled dataclass
 *     (RenameTable/RenameColumn/SetColumnType/DropConstraint/SetSchema in
 *     alter.py; Savepoint in the engine files; AsOf/OnConflictItem in
 *     mixins.py) flows to the `self.<field>` read inside that class (or its
 *     same-file base class), where <field> is an annotated dataclass field.
 *     Keyword arguments are matched by name; positional arguments are
 *     matched to any declared field of the same class (a documented,
 *     bounded over-approximation - the labeled call sites use
 *     `RenameColumn(column, new_name)` positional form).
 *
 *  2. initParamToFieldRead (src-08 Savepoint.__init__ name param):
 *     for classes with an EXPLICIT __init__ (Savepoint:
 *     `def __init__(self, name, transaction): self.name = name`), the
 *     __init__ parameter flows to `self.<field>` reads in other methods of
 *     the class (rollback_to/release read `self.name` and build the
 *     unquoted SAVEPOINT f-strings).
 *
 *  3. propertyReadHop (rename_column `column` param):
 *     `@property` methods that read `self.<field>` (e.g.
 *     AlterColumnStatement.column_name reading `self.column`) propagate to
 *     `self.<propertyName>` reads in the same-file class hierarchy, because
 *     property invocation is not tracked by default data flow.
 *
 * Not modeled (documented limitations, see report/query_generation_notes.md):
 *  - attribute-chain metadata reads (e.g. `self.old_column._meta.
 *    db_column_name` in SetColumnType.ddl) - receiver taint through
 *    attribute chains is not established;
 *  - QueryString object -> compiled string (template flows are instead
 *    caught at the raw-template construction sinks, label snk-015);
 *  - ORDER BY / WhereRaw chains beyond the labeled boundaries.
 */

import python
import semmle.python.dataflow.new.DataFlow

module MySummaries {
  private string normalizedPath(AstNode n) {
    result = n.getLocation().getFile().getAbsolutePath().replaceAll("\\", "/")
  }

  /**
   * Same scope exclusions as the Phase 1 extraction queries. Takes the AST
   * node (not the path string) so that every `matches` receiver is a bound
   * function result.
   */
  private predicate excludedNode(AstNode n) {
    normalizedPath(n).matches("%/tests/%")
    or normalizedPath(n).matches("%/piccolo-db/%")
    or normalizedPath(n).matches("%/piccolo-safe-db/%")
    or normalizedPath(n).matches("%/piccolo_migrations/%")
    or normalizedPath(n).matches("%/docs/%")
  }

  private predicate inPiccoloLibrary(AstNode n) {
    normalizedPath(n).matches("%/piccolo_vuln/piccolo/%")
    and not excludedNode(n)
  }

  /**
   * Additional taint step for all passes; this run only defines the
   * "sql_injection" pass key.
   */
  predicate isAdditionalTaintStep(DataFlow::Node fromNode, DataFlow::Node toNode, string passKey) {
    passKey = "sql_injection"
    and (
      ctorArgToFieldRead(fromNode, toNode)
      or initParamToFieldRead(fromNode, toNode)
      or propertyReadHop(fromNode, toNode)
    )
  }

  /** The dataclasses carrying reviewed SQL-identifier parameters. */
  private predicate labeledDataclass(Class c) {
    (
      c.getName() = "RenameTable"
      or c.getName() = "RenameColumn"
      or c.getName() = "SetColumnType"
      or c.getName() = "DropConstraint"
      or c.getName() = "SetSchema"
    )
    and normalizedPath(c).matches("%/piccolo_vuln/piccolo/query/methods/alter.py")
    or
    c.getName() = "Savepoint"
    and (
      normalizedPath(c).matches("%/piccolo_vuln/piccolo/engine/postgres.py")
      or normalizedPath(c).matches("%/piccolo_vuln/piccolo/engine/sqlite.py")
    )
    or
    (
      c.getName() = "AsOf"
      or c.getName() = "OnConflictItem"
    )
    and normalizedPath(c).matches("%/piccolo_vuln/piccolo/query/mixins.py")
  }

  /** A field declared by an annotated class attribute or an __init__ parameter. */
  private predicate declaredField(Class c, string field) {
    exists(AnnAssign a |
      c.contains(a)
      and a.getTarget().(Name).getId() = field
    )
    or
    exists(Function init, Parameter p |
      init = c.getMethod("__init__")
      and p = init.getAnArg()
      and p.getName() = field
    )
  }

  /** The read occurs in class c or in a same-file one-level base class of c. */
  private predicate readInClassOrSameFileBase(Class c, AstNode read) {
    c.contains(read)
    or
    exists(Class base, Name baseName |
      base.contains(read)
      and baseName = c.getABase()
      and base.getName() = baseName.getId()
      and normalizedPath(base) = normalizedPath(c)
    )
  }

  /** The read occurs in class c or in a same-file one-level subclass of c. */
  private predicate readInClassOrSameFileDerived(Class c, AstNode read) {
    c.contains(read)
    or
    exists(Class derived, Name baseName |
      derived.contains(read)
      and baseName = derived.getABase()
      and baseName.getId() = c.getName()
      and normalizedPath(derived) = normalizedPath(c)
    )
  }

  /**
   * Step 1: construction-site argument -> `self.<field>` read in the labeled
   * dataclass (or its same-file base class).
   *
   * Evidence: @dataclass-generated __init__ stores each argument in the
   * matching field (e.g. `RenameTable(new_name=new_name)` at alter.py:372 ->
   * `self.new_name` read in RenameTable.ddl at alter.py:36;
   * `Savepoint(name=savepoint_name, ...)` at postgres.py:229 ->
   * `self.name` read in Savepoint.rollback_to at postgres.py:133;
   * `AsOf(interval)` at mixins.py:321 -> `self.interval` read in
   * AsOf.querystring at mixins.py:119; `OnConflictItem(target=target, ...)`
   * at mixins.py:783 -> `self.target` read in target_string at mixins.py:649).
   */
  private predicate ctorArgToFieldRead(DataFlow::Node fromNode, DataFlow::Node toNode) {
    exists(Class c, string field, Call ctor, Attribute read |
      labeledDataclass(c)
      and declaredField(c, field)
      and ctor.getFunc().(Name).getId() = c.getName()
      and inPiccoloLibrary(ctor)
      and read.getName() = field
      and read.getObject().(Name).getId() = "self"
      and readInClassOrSameFileBase(c, read)
      and (
        exists(Keyword kw |
          kw = ctor.getAKeyword()
          and kw.getArg() = field
          and fromNode.asExpr() = kw.getValue()
        )
        or
        fromNode.asExpr() = ctor.getAnArg()
      )
      and toNode.asExpr() = read
    )
  }

  /**
   * Step 2: explicit `__init__` parameter -> `self.<field>` read in another
   * method of the same class.
   *
   * Evidence: Savepoint.__init__ stores `self.name = name`
   * (postgres.py:127-130, sqlite.py:307-310); rollback_to/release read
   * `self.name` and build the unquoted statements (postgres.py:132-139,
   * sqlite.py:311-319). Cross-method self-field flow is not tracked by
   * default data flow, hence this step.
   */
  private predicate initParamToFieldRead(DataFlow::Node fromNode, DataFlow::Node toNode) {
    exists(Class c, Function init, Parameter p, Attribute read |
      labeledDataclass(c)
      and init = c.getMethod("__init__")
      and p = init.getAnArg()
      and declaredField(c, p.getName())
      and read.getName() = p.getName()
      and read.getObject().(Name).getId() = "self"
      and readInClassOrSameFileBase(c, read)
      and fromNode = DataFlow::parameterNode(p)
      and toNode.asExpr() = read
    )
  }

  /**
   * Step 3: `self.<field>` read inside a @property method ->
   * `self.<propertyName>` read in the same-file class hierarchy.
   *
   * Evidence: AlterColumnStatement.column_name (@property, alter.py:45-52)
   * reads `self.column`; RenameColumn.ddl interpolates `self.column_name`
   * into the quoted-but-unescaped DDL (alter.py:63).
   */
  private predicate propertyReadHop(DataFlow::Node fromNode, DataFlow::Node toNode) {
    exists(Class c, Function prop, Attribute inner, Attribute outer, string field |
      prop.getScope() = c
      and prop.getADecorator().(Name).getId() = "property"
      and prop.contains(inner)
      and inner.getObject().(Name).getId() = "self"
      and field = inner.getName()
      and declaredField(c, field)
      and outer.getObject().(Name).getId() = "self"
      and outer.getName() = prop.getName()
      and readInClassOrSameFileDerived(c, outer)
      and fromNode.asExpr() = inner
      and toNode.asExpr() = outer
    )
  }
}
