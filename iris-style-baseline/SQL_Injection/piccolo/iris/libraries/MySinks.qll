  private predicate schemaDdlFstringSink(DataFlow::Node sink) {
    exists(Fstring fstr |
      normalizedPath(fstr).matches("%/piccolo_vuln/piccolo/schema.py")
      and not excludedNode(fstr)
      and interpolatedValue(fstr, sink)
