import python
import semmle.python.dataflow.new.DataFlow

module MySinks {
  private string normalizedPath(AstNode n) {
    result = n.getLocation().getFile().getAbsolutePath().replaceAll("\\", "/")
  }

  /**
   * Same scope exclusions as the Phase 1 extraction queries. Takes the AST
   * node (not the path string) so that every `matches` receiver is a bound
   * function result.
   */
  private predicate excludedNode(AstNode n) {
    normalizedPath(n).matches("%/tests/%")
    or normalizedPath(n).matches("%/piccolo-db/%")
    or normalizedPath(n).matches("%/piccolo-safe-db/%")
    or normalizedPath(n).matches("%/piccolo_migrations/%")
    or normalizedPath(n).matches("%/docs/%")
  }

  private predicate inPiccoloLibrary(AstNode n) {
    normalizedPath(n).matches("%/piccolo_vuln/piccolo/%")
    and not excludedNode(n)
  }

  /**
   * Sink predicate for all passes; this run only defines the
   * "sql_injection" pass key.
   */
  predicate isSink(DataFlow::Node sink, string passKey) {
    passKey = "sql_injection"
    and (
      engineSqlTextSink(sink)
      or runDdlTextSink(sink)
      or rawSqlTemplateSink(sink)
      or savepointStatementFstringSink(sink)
      or alterDdlFstringSink(sink)
      or schemaDdlFstringSink(sink)
      or rowidLookupFstringSink(sink)
      or dynamicIdentifierFstringSink(sink)
    )
  }

  /** Receiver display name: `x.m` -> "x" for Name and Attribute objects. */
  private string attributeName(Expr obj) {
    exists(Name n | n = obj and result = n.getId())
    or
    exists(Attribute a | a = obj and result = a.getName())
  }

  /**
   * p5-snk-001a-e: final driver execution layer, SQL text at argument 0.
   *
   * `execute` is matched for receivers named connection/conn/cursor
   * (covers aiosqlite cursor.execute at sqlite.py:575);
   * `fetch` and `cursor` are matched only for receivers named
   * connection/conn, which excludes postgres.py:41
   * (`self.cursor.fetch(self.batch_size)` - a batch-size argument, not SQL).
   *
   * Bound parameters (asyncpg *args after the query text, aiosqlite
   * `execute(query, args)` argument 1) never match: only argument 0 is a
   * sink, so correctly parameterized values cannot be reported.
   */
  private predicate engineSqlTextSink(DataFlow::Node sink) {
    exists(Call call, Attribute func, string callee, string receiver |
      call.getFunc() = func
      and func.getName() = callee
      and receiver = attributeName(func.getObject())
      and (
        normalizedPath(call).matches("%/piccolo_vuln/piccolo/engine/postgres.py")
        or normalizedPath(call).matches("%/piccolo_vuln/piccolo/engine/sqlite.py")
      )
      and (
        (
          callee = "execute"
          and (receiver = "connection" or receiver = "conn" or receiver = "cursor")
        )
        or
        (
          (callee = "fetch" or callee = "cursor")
          and (receiver = "connection" or receiver = "conn")
        )
      )
      and sink.asExpr() = call.getArg(0)
    )
  }

  /**
   * p5-snk-006: `Engine.run_ddl(ddl, ...)` - DDL text executed verbatim as SQL
   * (postgres.py:544 -> fetch at :553; sqlite.py:674). Call sites:
   * query/base.py DDL.run (`engine.run_ddl(...)`), schema.py:24
   * (`self.db.run_ddl(self.ddl, ...)`). Argument 0 is the DDL text.
   */
  private predicate runDdlTextSink(DataFlow::Node sink) {
    exists(Call call, Attribute func |
      call.getFunc() = func
      and func.getName() = "run_ddl"
      and inPiccoloLibrary(call)
      and sink.asExpr() = call.getArg(0)
    )
  }

  /**
   * p5-snk-015: raw-SQL template construction - `QueryString(sql, *args)`
   * argument 0 at the reviewed raw-channel sites. Argument 0 is the SQL text;
   * `*args` are bound parameters and are not sinks.
   */
  private predicate rawSqlTemplateSink(DataFlow::Node sink) {
    exists(Call call, Function f |
      call.getFunc().(Name).getId() = "QueryString"
      and f.contains(call)
      and (
        (
          f.getName() = "raw"
          and normalizedPath(f).matches("%/piccolo_vuln/piccolo/table.py")
        )
        or
        (
          f.getName() = "__init__"
          and f.getScope().(Class).getName() = "WhereRaw"
          and normalizedPath(f).matches("%/piccolo_vuln/piccolo/columns/combination.py")
        )
        or
        (
          f.getName() = "__init__"
          and f.getScope().(Class).getName() = "SelectRaw"
          and normalizedPath(f).matches("%/piccolo_vuln/piccolo/query/methods/select.py")
        )
      )
      and sink.asExpr() = call.getArg(0)
    )
  }

  /**
   * p5-snk-004a: unquoted savepoint names interpolated into executed engine
