   * name/columns), and the sqlite_querystrings (PRAGMA index_list) /
   * default_querystrings (DROP INDEX) functions.
   *
   * Guarded constructions (label snk-012: LIMIT/OFFSET ints, DISTINCT ON /
   * RETURNING / GROUP BY quoted column metadata, INSERT/UPDATE bound VALUES)
   * are deliberately NOT sinks.
   */
  private predicate dynamicIdentifierFstringSink(DataFlow::Node sink) {
    exists(Fstring fstr, Function f, Class c |
      f.contains(fstr)
      and f.getScope() = c
      and (
        c.getName() = "AsOf"
        or c.getName() = "OrderBy"
        or c.getName() = "OnConflictItem"
        or c.getName() = "OnConflict"
      )
      and normalizedPath(f).matches("%/piccolo_vuln/piccolo/query/mixins.py")
      and interpolatedValue(fstr, sink)
    )
    or
    exists(Fstring fstr |
      normalizedPath(fstr).matches("%/piccolo_vuln/piccolo/query/methods/create_index.py")
      and not excludedNode(fstr)
      and interpolatedValue(fstr, sink)
    )
    or
    exists(Fstring fstr, Function f |
      f.contains(fstr)
      and (f.getName() = "sqlite_querystrings" or f.getName() = "default_querystrings")
      and normalizedPath(f).matches("%/piccolo_vuln/piccolo/query/methods/%")
      and interpolatedValue(fstr, sink)
    )
  }

  /**
   * The data-flow node of an expression interpolated into an f-string.
   * Covers both the FormattedValue part and its inner value expression.
   */
  private predicate interpolatedValue(Fstring fstr, DataFlow::Node sink) {
    sink.asExpr() = fstr.getAValue()
    or
    exists(FormattedValue fv |
      fv = fstr.getAValue()
      and sink.asExpr() = fv.getValue()
    )
  }
