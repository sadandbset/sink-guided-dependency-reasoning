  }

  /**
   * p5-snk-008: the _get_inserted_pk ROWID lookup (sqlite.py:575-577)
   * interpolates the dynamic table/column identifiers into executed SQL text.
   */
  private predicate rowidLookupFstringSink(DataFlow::Node sink) {
    exists(Fstring fstr, Function f |
      f.contains(fstr)
      and f.getName() = "_get_inserted_pk"
      and normalizedPath(f).matches("%/piccolo_vuln/piccolo/engine/sqlite.py")
      and interpolatedValue(fstr, sink)
