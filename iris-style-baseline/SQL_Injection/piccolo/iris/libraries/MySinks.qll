   * label snk-002) are excluded by the function-name restriction.
   */
  private predicate savepointStatementFstringSink(DataFlow::Node sink) {
    exists(Fstring fstr, Function f |
      f.contains(fstr)
      and (
        f.getName() = "rollback_to"
        or f.getName() = "release"
        or f.getName() = "savepoint"
