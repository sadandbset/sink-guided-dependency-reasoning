  }

  /**
   * p5-snk-013: dynamic identifier/fragment constructions - f-strings in the
   * AsOf / OrderBy / OnConflictItem / OnConflict classes (mixins.py: AS OF
   * SYSTEM TIME interval, ORDER BY expression incl. OrderByRaw.sql, ON
