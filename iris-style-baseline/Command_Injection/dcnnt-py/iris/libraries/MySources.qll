   * signature-level confirmed families above — same call shapes at dead call sites,
   * producing no flow until the serializer/dispatcher is wired in.
   */
  private predicate candidateNetworkSource(DataFlow::Node source) {
    pluginHandlerParam(source, 3, "_receive_file")
    or
    pluginHandlerParam(source, 2, "receive_file_to_path")
    or
    exists(Function f, Parameter p |
      f.getName() = "dispatch" and
      f.getEnclosingScope().(Class).getName() = "RPCDispatcher" and
      f.getArg(1) = p and
      source.(DataFlow::ParameterNode).getParameter() = p
