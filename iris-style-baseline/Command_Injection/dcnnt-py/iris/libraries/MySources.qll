import python
import semmle.python.ApiGraphs
import semmle.python.dataflow.new.DataFlow

module MySources {
  /** Pass key of the formal pass-2 query. */
  private string formalKey() { result = "command_injection" }

  /** Pass key of the diagnostics variant; its results are not formal findings. */
  private string diagnosticsKey() { result = "command_injection_diagnostics" }

  /**
   * Holds if `source` is a taint source for the given pass key. Source nodes are
   * the return-value nodes of network-read/decode calls, the entry parameters of
   * externally reachable plugin handlers, or the `request.params` read expressions.
   */
  predicate isSource(DataFlow::Node source, string passKey) {
    passKey = formalKey() and confirmedNetworkSource(source)
    or
    passKey = diagnosticsKey() and
    (confirmedNetworkSource(source) or candidateNetworkSource(source))
  }

  /* ------------------------------------------------------------------ */
  /* Confirmed (tp) source families                                      */
  /* ------------------------------------------------------------------ */

  private predicate confirmedNetworkSource(DataFlow::Node source) {
    rawNetworkReadSource(source)
    or
    protocolDecodeSource(source)
    or
    handlerEntryParamSource(source)
    or
    requestParamReadSource(source)
  }

  /**
   * Family 1 — raw network reads (return values).
   *
   * p2-e-009/010 base.py:106/109 `self.handler.recv(...)`,
   * p2-e-060     tcp_server.py:35 `self.sock.recv(left)`,
   * p2-e-064     tcp_server.py:69 `self.recv(60)`,
   * p2-e-013/024 base.py:123/185 and p2-e-094 notifications.py:42 `self.read()`,
   * p2-e-018/025 base.py:148/189, p2-e-091 notifications.py:33,
   * p2-e-112     remote_commands.py:59 `self.rpc_read()`,
   * p2-e-011     base.py:114, p2-e-053 server_search.py:38, p2-e-065 tcp_server.py:85
   *              bare `decrypt(...)` (dcnnt.common, AES-GCM; decryption authenticates the
   *              paired phone but does not restrict command parameters — propagation,
   *              not sanitization, per review point 1).
   */
  private predicate rawNetworkReadSource(DataFlow::Node source) {
    /* any `<obj>.recv(n)` call result — length argument is numeric metadata (p2-e-059, fp) */
    exists(Call c |
      c.getFunc().(Attribute).getName() = "recv" and
      source.asExpr() = c
    )
    or
    /* `self.read()` — plugin socket message read (receiver restricted to `self` so that
       unrelated `f.read()` file reads are not matched) */
    exists(Call c |
      c.getFunc().(Attribute).getName() = "read" and
      c.getFunc().(Attribute).getObject().(Name).getId() = "self" and
      source.asExpr() = c
    )
    or
    /* `self.rpc_read()` — JSON-RPC request built from decrypted socket data */
    exists(Call c |
      c.getFunc().(Attribute).getName() = "rpc_read" and
      source.asExpr() = c
    )
    or
    /* bare `decrypt(...)` — dcnnt.common AES-GCM decryption of network bytes */
    exists(Call c |
      c.getFunc().(Name).getId() = "decrypt" and
      source.asExpr() = c
    )
  }

  /**
   * Family 2 — protocol decoding (return values).
   *
   * p2-e-015 base.py:128 and p2-e-050 server_search.py:17 `json.loads(...)` — member
   *   `loads` only; `json.load` of local config files is rejected (p2-e-043, fp);
   * p2-e-014 base.py:128 `RPCRequest.from_dict(...)` — the live construction site
   *   (jsonrpc.py:170 on the unused RPCSerializer path is subsumed by the same shape);
   * p2-e-052 server_search.py:25 `self.unpack_raw_request(...)`;
   * p2-e-054 server_search.py:38 `b64decode(...)` — `b64encode` is outbound (p2-e-055, fp).
   */
  private predicate protocolDecodeSource(DataFlow::Node source) {
    /* json.loads — resolved via API graphs (alias-aware), plus syntax-level fallback */
    exists(API::CallNode cn |
      cn = API::moduleImport("json").getMember("loads").getACall() and
      source.asExpr() = cn.getNode().getNode().(Call)
    )
    or
    exists(Call c |
      c.getFunc().(Attribute).getName() = "loads" and
      c.getFunc().(Attribute).getObject().(Name).getId() = "json" and
      source.asExpr() = c
    )
    or
    /* RPCRequest.from_dict(...) */
    exists(Call c |
      c.getFunc().(Attribute).getName() = "from_dict" and
      c.getFunc().(Attribute).getObject().(Name).getId() = "RPCRequest" and
      source.asExpr() = c
    )
    or
    /* self.unpack_raw_request(...) — UDP datagram field unpacking */
    exists(Call c |
      c.getFunc().(Attribute).getName() = "unpack_raw_request" and
      source.asExpr() = c
    )
    or
    /* base64.b64decode — resolved via API graphs (from-import alias-aware) + fallback */
    exists(API::CallNode cn |
      cn = API::moduleImport("base64").getMember("b64decode").getACall() and
      source.asExpr() = cn.getNode().getNode().(Call)
    )
    or
    exists(Call c |
      c.getFunc().(Name).getId() = "b64decode" and
      source.asExpr() = c
    )
  }

  /**
   * Family 3 — externally reachable plugin handler entry parameters.
   *
   * The connected (paired) phone is the attacker-facing principal: every handler below
   * receives an RPCRequest built from `rpc_read -> decrypt -> json.loads`. Position is
   * the 0-based parameter index in the function definition, self counted at 0 — matching
   * the labels' arg_index convention (labels.json metadata note).
   *
   * Positional precision matters: sibling parameters at the same functions were
   * explicitly rejected (e.g. p2-e-021/029 receive_file arg 2 = local config directory,
   * p2-e-031/032 send_file args 2/3 = server-side path / numeric size, p2-e-133
   * common_upload_handler arg 1 = constant section name).
   */
  private predicate handlerEntryParamSource(DataFlow::Node source) {
    pluginHandlerParam(source, 1, "process_request")
    or
    pluginHandlerParam(source, 1, "_receive_file")
    or
    pluginHandlerParam(source, 1, "receive_file")
    or
    pluginHandlerParam(source, 1, "receive_file_to_path")
    or
    pluginHandlerParam(source, 1, "send_file")
    or
    pluginHandlerParam(source, 2, "common_upload_handler")
    or
    exists(string name | name.matches("handle_%") and pluginHandlerParam(source, 1, name))
  }

  /**
   * Holds if `source` is the parameter at `position` of the plugin method `funcName`.
   * Restricted to classes named `%Plugin` so transport/handler classes
   * (`DConnectHandler.handle`, `ServerSearchHandler.handle`) are not matched.
   */
  private predicate pluginHandlerParam(DataFlow::Node source, int position, string funcName) {
    exists(Function f, Class cls, Parameter p |
      f.getName() = funcName and
      f.getEnclosingScope() = cls and
      cls.getName().matches("%Plugin") and
      f.getArg(position) = p and
      source.(DataFlow::ParameterNode).getParameter() = p
    )
  }

  /**
   * Family 4 — direct reads of attacker-controlled request parameters.
   *
   * `request.params['key']` (p2-e-023/086/125/138/147),
   * `request.params.get('key')` / `.pop('key')` (p2-e-093/095/096/103/111/117/126/130/131/
   * 139/140/149/150/155 — including notifications.py:42 packageIcon, :43 event, :45 title),
   * `request.get('pair')` on the decoded UDP JSON dict (p2-e-051, server_search.py:19),
   * bare `request.params` attribute load (p2-e-125, sync.py:278).
   *
   * Protocol decoding performs no content validation on params (review point 1), so these
   * values are unrestricted attacker input.
   */
  private predicate requestParamReadSource(DataFlow::Node source) {
    /* request.params['key'] */
    exists(Subscript s, Attribute params |
      params = s.getObject().(Attribute) and
      params.getName() = "params" and
      params.getObject().(Name).getId() = "request" and
      source.asExpr() = s
    )
    or
    /* request.params.get('key') / request.params.pop('key') */
    exists(Call c, Attribute func, Attribute params |
      func = c.getFunc().(Attribute) and
      func.getName() in ["get", "pop"] and
      params = func.getObject().(Attribute) and
      params.getName() = "params" and
      params.getObject().(Name).getId() = "request" and
      source.asExpr() = c
    )
    or
    /* request.get('key') / request.pop('key') on the decoded UDP JSON datagram dict */
    exists(Call c, Attribute func |
      func = c.getFunc().(Attribute) and
      func.getName() in ["get", "pop"] and
      func.getObject().(Name).getId() = "request" and
      source.asExpr() = c
    )
    or
    /* bare request.params attribute load (e.g. print(request.params)) */
    exists(Attribute params |
      params.getName() = "params" and
      params.getObject().(Name).getId() = "request" and
      source.asExpr() = params
    )
  }

  /* ------------------------------------------------------------------ */
  /* Candidate (unreviewed) sources — diagnostics pass key only          */
  /* ------------------------------------------------------------------ */

  /**
   * Entries classified `candidate` in labels.json (human review requested, phase1_review
