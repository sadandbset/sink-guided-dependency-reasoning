  /**
   * Family 4 — handler entry parameters (param labels): every non-self
   * parameter of a function decorated with @<name>.route(...) (Flask URL path
   * parameters) or @<name>.on(...) (Flask-SocketIO event payloads on the /pty
   * namespace: start_process / socket_input / resize / server_disconnect).
   * The route rule's <int:sid> converters restrict some values to numerals at
   * runtime; the labels judged the parameters themselves the input boundary
   * (label rationale), so no per-parameter filtering is applied.
   */
  private predicate handlerParamSource(DataFlow::Node source) {
    exists(Function f, Parameter p |
      handlerFunction(f) and
      p = f.getAnArg() and
      not p.isSelf() and
      source = DataFlow::parameterNode(p)
    )
  }

  /** Functions carrying a `@<name>.route(...)` or `@<name>.on(...)`
   *  decorator (the compile-verified Phase-1 extraction shapes). */
  private predicate handlerFunction(Function f) {
    appFile(f.getLocation().getFile()) and
    exists(Call dec, Attribute func, Name obj |
      dec = f.getADecorator() and
      func = dec.getFunc().(Attribute) and
      obj = func.getObject().(Name) and
      func.getName() in ["route", "on"]
    )
  }

  /**
   * Family 5 — user import-file decodes (2 tp labels, location-pinned):
   * import_export_servers/__init__.py:130 json.loads(j.read()) over a
   * user-supplied import file, and utils/__init__.py:613 json.load(f) in
   * load_database_servers (reached from the web import route and the setup
   * CLI). The decoded content becomes server-registration data, including
   * passexec_cmd (the operand of the passexec.py:36 candidate sink).
   */
  private predicate importFileDecodeSource(DataFlow::Node source) {
    exists(Call c |
      jsonDecodeCall(c) and
      (
        c.getLocation().getFile().getRelativePath() =
          "web/pgadmin/tools/import_export_servers/__init__.py" and
        c.getLocation().getStartLine() = 130
        or
        c.getLocation().getFile().getRelativePath() =
          "web/pgadmin/utils/__init__.py" and
        c.getLocation().getStartLine() = 613
      ) and
      source = DataFlow::exprNode(c)
    )
  }

  /**
   * Family 6 — executor command transport (1 tp label):
   * process_executor.py:414 `argv = [unescape_dquotes_process_arg(arg) for
   * arg in sys.argv]` — the sys.argv read is the inter-process handoff of the
   * BatchProcess command list spawned by the web process
   * (processes.py:290-291 `[interpreter, executor, self.cmd] + self.args`).
   * Labeling it a source keeps the executor-side half of the batch pipeline
   * traceable to the process_executor.py:330 Popen sink (CodeQL cannot cross
   * the fork boundary). Pinned to the only sys.argv read in the file.
   */
  private predicate executorArgvSource(DataFlow::Node source) {
    exists(Attribute a, Name obj |
      a.getName() = "argv" and
      obj = a.getObject().(Name) and
      obj.getId() = "sys" and
      a.getLocation().getFile().getRelativePath() =
        "web/pgadmin/misc/bgprocess/process_executor.py" and
      source = DataFlow::exprNode(a)
    )
  }

  /* ------------------------------------------------------------------ */
  /* Candidate (unreviewed) sources — diagnostics pass key only          */
  /* ------------------------------------------------------------------ */

  /**
   * Entries classified `candidate` in labels.json (human review requested,
   * retained pending a threat-model decision). Included only under
   * "command_injection_diagnostics": the remote cloud-provider response,
   * upgrade-check response and deploy-log decodes (hardcoded TLS endpoints,
   * no confirmed path to a command string) and the second-order binary-path
   * preference values feeding set_binary_path / get_utility_path. Per the
   * Phase-1 review these are recall seeds for review, not formal findings.
   */
  private predicate candidateSource(DataFlow::Node source) {
    exists(Call c |
      jsonDecodeCall(c) and
      pinnedCandidateDecodeSite(c) and
      source = DataFlow::exprNode(c)
    )
  }

  /** (file, line) pins of the 24 candidate json decode sites. */
  private predicate pinnedCandidateDecodeSite(Call c) {
    exists(string path, int line |
      candidateDecodePin(path, line) and
      c.getLocation().getFile().getRelativePath() = path and
      c.getLocation().getStartLine() = line
    )
  }

  private predicate candidateDecodePin(string path, int line) {
    path = "web/pgacloud/providers/biganimal.py" and line in [152, 190]
    or
    path = "web/pgadmin/browser/__init__.py" and line in [441]
    or
    path = "web/pgadmin/browser/server_groups/servers/types.py" and line in [83, 198, 229]
    or
    path = "web/pgadmin/misc/bgprocess/processes.py" and line in [547]
    or
    path = "web/pgadmin/misc/cloud/biganimal/__init__.py" and line in [205, 222, 238, 247, 263, 283, 307, 315, 327, 336, 348, 369, 386, 402, 424, 437, 445]
  }
}
