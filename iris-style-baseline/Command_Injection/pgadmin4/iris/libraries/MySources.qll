import python
import semmle.python.ApiGraphs
import semmle.python.dataflow.new.DataFlow

module MySources {
  /** Pass key of the formal pass-2 query. */
  private string formalKey() { result = "command_injection" }

  /** Pass key of the diagnostics variant; its results are not formal findings. */
  private string diagnosticsKey() { result = "command_injection_diagnostics" }

  /**
   * Holds if `source` is a taint source for the given pass key. Confirmed
   * (tp) sources are the Flask HTTP request surface, the Flask-SocketIO /pty
   * payloads, the reviewed json request decodes, the user import files and the
   * executor command transport; the diagnostics key additionally admits the
   * candidate remote/preference decodes.
   */
  predicate isSource(DataFlow::Node source, string passKey) {
    passKey = formalKey() and confirmedSource(source)
    or
    passKey = diagnosticsKey() and
    (confirmedSource(source) or candidateSource(source))
  }

  /* ------------------------------------------------------------------ */
  /* Confirmed (tp) source families                                      */
  /* ------------------------------------------------------------------ */

  private predicate confirmedSource(DataFlow::Node source) {
    flaskRequestStateSource(source)
    or
    flaskRequestParamSource(source)
    or
    jsonRequestDecodeSource(source)
    or
    handlerParamSource(source)
    or
    importFileDecodeSource(source)
    or
    executorArgvSource(source)
  }

  /** Observed spellings of the Flask request object: the canonical import,
   *  file_manager's 'from flask import request as req' and the browser
   *  get_delete_data helpers' request_object parameter convention. */
  private predicate requestObjectName(Name name) {
    name.getId() in ["request", "req", "request_object"]
  }

  /** Request-proxy state attributes read in pgadmin4 handlers. */
  private predicate requestStateName(string name) {
    name in ["data", "form", "args", "json", "values", "files", "cookies",
             "headers", "environ"]
  }

  /** Application files: the web/ tree minus the regression harness and
   *  per-module tests directories (the extraction's exclusion set; the
   *  repo-root tools/ scripts are outside web/ already). */
  private predicate appFile(File f) {
    f.getRelativePath().matches("web/%") and
    not f.getRelativePath().matches("%/regression/%") and
    not f.getRelativePath().matches("%/tests/%")
  }

  /**
   * Family 1 — Flask request-proxy state reads (http_request labels).
   *
   * `<request|req|request_object>.<data|form|args|json|values|files|cookies|
   * headers|environ>` attribute loads and `request.get_json(...)` call
   * results. The Flask request object is a runtime local proxy, so these match
   * at AST level only (same shape as the compile-verified extraction family
   * 2/2b); the receiver-name list is closed, so unrelated `request`-named
   * locals with other attributes cannot match.
   */
  private predicate flaskRequestStateSource(DataFlow::Node source) {
    exists(Attribute a, Name obj |
      obj = a.getObject().(Name) and
      requestObjectName(obj) and
      requestStateName(a.getName()) and
      appFile(a.getLocation().getFile()) and
      source = DataFlow::exprNode(a)
    )
    or
    exists(Call c, Attribute func, Name obj |
      func = c.getFunc().(Attribute) and
      func.getName() = "get_json" and
      obj = func.getObject().(Name) and
      requestObjectName(obj) and
      appFile(c.getLocation().getFile()) and
      source = DataFlow::exprNode(c)
    )
  }

  /**
   * Family 2 — Flask request field reads (request_param labels).
   *
   * `request.<collection>[key]` subscripts and
   * `request.<collection>.get/getlist(...)` call results — the raw query-
   * string / POST-body field values before any handler validation.
   */
  private predicate flaskRequestParamSource(DataFlow::Node source) {
    exists(Subscript s, Attribute coll, Name obj |
      coll = s.getObject().(Attribute) and
      obj = coll.getObject().(Name) and
      requestObjectName(obj) and
      requestStateName(coll.getName()) and
      appFile(s.getLocation().getFile()) and
      source = DataFlow::exprNode(s)
    )
    or
    exists(Call c, Attribute func, Attribute coll, Name obj |
      func = c.getFunc().(Attribute) and
      func.getName() in ["get", "getlist"] and
      coll = func.getObject().(Attribute) and
      obj = coll.getObject().(Name) and
      requestObjectName(obj) and
      requestStateName(coll.getName()) and
      appFile(c.getLocation().getFile()) and
      source = DataFlow::exprNode(c)
    )
  }

  /** json.loads / json.load call (module-qualified or bare from-imported name). */
  private predicate jsonDecodeCall(Call c) {
    exists(Attribute func, Name obj |
      func = c.getFunc().(Attribute) and
      func.getName() in ["loads", "load"] and
      obj = func.getObject().(Name) and
      obj.getId() = "json"
    )
    or
    c.getFunc().(Name).getId() = "loads"
  }

  /**
   * Family 3 — reviewed json request decodes (return-flow labels,
   * location-pinned): json.loads(request.data) / request.form['data'] /
   * request-assigned variables and the browser field-decode idiom. The pins
   * below are rendered directly from the 252 tp json-decode label entries;
   * the call-result node (not the argument) is the source, so the decoded
   * request fields inherit taint.
   */
  private predicate jsonRequestDecodeSource(DataFlow::Node source) {
    exists(Call c |
      jsonDecodeCall(c) and
      pinnedJsonDecodeSite(c) and
      source = DataFlow::exprNode(c)
    )
  }

  /** (file, line) pins of the 252 reviewed tp json decode sites. */
  private predicate pinnedJsonDecodeSite(Call c) {
    exists(string path, int line |
      jsonDecodePin(path, line) and
      c.getLocation().getFile().getRelativePath() = path and
      c.getLocation().getStartLine() = line
    )
  }

