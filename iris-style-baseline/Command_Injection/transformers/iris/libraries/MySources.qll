    exists(Attribute a |
      a.getName() = "argv" and
      a.getObject().(Name).getId() = "sys" and
      inTransformersScope(a) and
      source = DataFlow::exprNode(a)
    )
    or
    exists(Subscript s, Attribute a |
      a = s.getObject().(Attribute) and
      a.getName() = "argv" and
      a.getObject().(Name).getId() = "sys" and
      inTransformersScope(s) and
      source = DataFlow::exprNode(s)
