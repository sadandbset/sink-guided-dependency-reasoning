import python
import semmle.python.ApiGraphs
import semmle.python.dataflow.new.DataFlow

module MySinks {
  /** Pass key of the formal pass-2 query. */
  private string formalKey() { result = "command_injection" }

  /** Pass key of the diagnostics variant; its results are not formal findings. */
  private string diagnosticsKey() { result = "command_injection_diagnostics" }

  /**
   * Holds if `sink` is the command argument of a process-execution call for
   * the given pass key. For the formal key this is the command string of a
   * `subprocess.Popen(..., shell=True)` call (a shell command string); for
   * the diagnostics key every labeled exec-API argument-0 node qualifies
   * (shell string or argv list).
   */
  predicate isSink(DataFlow::Node sink, string passKey) {
    passKey = formalKey() and popenShellTrueCommand(sink)
    or
    passKey = diagnosticsKey() and
    (popenShellTrueCommand(sink) or execApiArg0Command(sink))
  }

  /** Restricts matching to the labeled scope (src/transformers, no tests). */
  private predicate inTransformersScope(AstNode n) {
    n.getLocation().getFile().getAbsolutePath().regexpMatch("(?i).*[\\\\/]src[\\\\/]transformers[\\\\/].*")
  }

  /**
   * Holds if `c` is a `subprocess.Popen` call: API-graph resolution
   * (from-import alias-aware) with a syntax-level `subprocess.Popen(...)`
   * fallback. This tree has no `from subprocess import Popen` sites, so both
   * clauses resolve the same call set.
   */
  private predicate popenCall(Call c) {
    exists(API::CallNode cn |
      cn = API::moduleImport("subprocess").getMember("Popen").getACall() and
      c = cn.getNode().getNode().(Call)
    )
    or
    (
      c.getFunc().(Attribute).getName() = "Popen" and
      c.getFunc().(Attribute).getObject().(Name).getId() = "subprocess"
    )
  }

  /**
   * snk-subprocess-popen-shell-true (tp 0.8): the command string (positional
   * argument 0) of a `subprocess.Popen(command, ..., shell=True)` call where
   * `shell` is the literal True. The single site in this snapshot is
   * onnx/__main__.py:59, where the joined command embeds unquoted
   * CLI-derived values (see MySummaries for the Namespace-unpacking steps
   * that carry parsed CLI values to this argument).
   */
  private predicate popenShellTrueCommand(DataFlow::Node sink) {
    exists(Call c, Keyword kw |
      popenCall(c) and
      inTransformersScope(c) and
      kw = c.getAKeyword() and
      kw.getArg() = "shell" and
      kw.getValue().(Name).getId() = "True" and
      sink = DataFlow::exprNode(c.getArg(0))
    )
  }

  /**
   * Holds if `c` is a `subprocess.<member>` call for member Popen / run /
   * check_output: API-graph resolution plus syntax-level fallback.
   */
  private predicate subprocessMemberCall(Call c, string member) {
    member in ["Popen", "run", "check_output"] and
    (
      exists(API::CallNode cn |
        cn = API::moduleImport("subprocess").getMember(member).getACall() and
        c = cn.getNode().getNode().(Call)
      )
      or
      (
        c.getFunc().(Attribute).getName() = member and
        c.getFunc().(Attribute).getObject().(Name).getId() = "subprocess"
      )
    )
  }

  /**
   * Argument-list shapes (candidate, diagnostics key):
   *   - snk-subprocess-popen-arg0 / run-arg0 / check-output-arg0:
   *     positional argument 0 of the subprocess member calls (the argv list,
   *     or a command string for the no-shell string form);
   *   - snk-asyncio-create-subprocess-exec-arg0: positional argument 0 of
