   * Known limitation (documented in query_generation_notes.md): the starred
   * spread `*cmd[1:]` is not an argument-0 node, so tainted elements spread
   * via `*args` are not matched; only taint reaching cmd[0] (or the list
   * itself) connects.
   */
  private predicate execApiArg0Command(DataFlow::Node sink) {
    exists(Call c, string member |
      subprocessMemberCall(c, member) and
      inTransformersScope(c) and
      sink = DataFlow::exprNode(c.getArg(0))
    )
    or
    exists(Call c |
      c.getFunc().(Attribute).getName() = "create_subprocess_exec" and
      c.getFunc().(Attribute).getObject().(Name).getId() = "asyncio" and
      inTransformersScope(c) and
      sink = DataFlow::exprNode(c.getArg(0))
    )
  }
