     * p2-src-006 (FileInputSource.read) — flow_kind=return.
     */
    module InputSourceFunctionReturns {

      predicate isSource(DataFlow::Node source) {
        exists(Function f, Class cls, Return r |
          inFile(f, "bikeshed/InputSource.py") and
          cls = f.getScope() and
