import python
import semmle.python.dataflow.new.DataFlow

module MySources {

  /**
   * Holds if `source` is a taint source for the pass identified by `passKey`.
   *
   * Only the CWE-78 pass ("command_injection") is enabled for this
   * experiment; every other pass key deliberately resolves to no sources.
