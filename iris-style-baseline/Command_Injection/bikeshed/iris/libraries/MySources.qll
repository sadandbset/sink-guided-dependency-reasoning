  /** Defensive test-directory filter (tests/ holds no .py in this database). */
  predicate inProductionCode(AstNode n) {
    not n.getLocation().getFile().getRelativePath().matches("tests/%") and
    not n.getLocation().getFile().getRelativePath().matches("%/tests/%") and
    not n.getLocation().getFile().getRelativePath().matches("test/%") and
    not n.getLocation().getFile().getRelativePath().matches("%/test/%")
