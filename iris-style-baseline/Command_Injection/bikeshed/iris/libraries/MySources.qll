          method = c.getFunc() and
          method.getName() = "get" and
          receiver = method.getObject() and
          receiver.getId() = "requests" and
          inFile(c, "bikeshed/InputSource.py") and
          atLine(c, 137) and
          source = DataFlow::exprNode(c)
        )
        or
        // p2-src-007: FileInputSource.read -> open(self.sourceName)
        exists(Call c, Name func |
          func = c.getFunc() and
          func.getId() = "open" and
          inFile(c, "bikeshed/InputSource.py") and
