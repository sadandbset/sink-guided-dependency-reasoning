     */
    module InputSourcePrimitives {

      predicate isSource(DataFlow::Node source) {
        // p2-src-002: StdinInputSource.read -> sys.stdin.readlines()
        exists(Call c, Attribute method, Attribute stdin, Name sysName |
          method = c.getFunc() and
          method.getName() = "readlines" and
          stdin = method.getObject() and
          stdin.getName() = "stdin" and
          sysName = stdin.getObject() and
          sysName.getId() = "sys" and
          inFile(c, "bikeshed/InputSource.py") and
          atLine(c, 119) and
          source = DataFlow::exprNode(c)
