  /**
   * Family 1 — HTTP request state on ReqHandler (core/httpd.py).
   *
   * Every `self.<attr>` below is set by the socketserver machinery from the client's
   * request line / headers / body / connection before handler code runs (labels:
   * self.path :125/:156/:194, self.data :131/:232, self.headers :162/:206/:229/:237/
   * :257/:546/:547/:647, self.rfile :230, self.client_address :244/:388/:399,
   * self.request :706/:707/:708 in SSLReqHandler.setup). Includes the
   * `self.headers.get(...)` call results (:162/:206/:229/:237/:257/:546/:647) and the
   * `self.rfile.read(n)` call result (:230, do_POST body read).
   */
  private predicate requestStateSource(DataFlow::Node source) {
    /* self.<request-state attribute> loads (and the :232/:707 stores, which flow to
       the already-sourced load sites) — restricted to core/httpd.py so unrelated
       self.path/self.request uses elsewhere cannot match */
    exists(Attribute a |
      a.getObject().(Name).getId() = "self" and
      a.getName() in ["path", "data", "headers", "rfile", "client_address", "request"] and
      a.getLocation().getFile().getRelativePath() = "core/httpd.py" and
      source = DataFlow::exprNode(a)
    )
    or
    /* self.headers.get(...) — p2-e-066/071/073/079/083/130/135 */
    exists(Call c, Attribute get, Attribute headers |
      get = c.getFunc().(Attribute) and
      get.getName() = "get" and
      headers = get.getObject().(Attribute) and
      headers.getName() = "headers" and
      headers.getObject().(Name).getId() = "self" and
      c.getLocation().getFile().getRelativePath() = "core/httpd.py" and
      source = DataFlow::exprNode(c)
    )
    or
    /* self.rfile.read(n) — p2-e-075 (do_POST body read at :230) */
