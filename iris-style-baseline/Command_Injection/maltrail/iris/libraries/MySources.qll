  private predicate handlerEntryParamSource(DataFlow::Node source) {
    exists(string handler |
      handler in ["_login", "_logout", "_whoami", "_check_ip", "_trails", "_ping",
                  "_fail2ban", "_events", "_counts"] and
      functionParamAt(source, "core/httpd.py", handler, 1)
    )
  }

  /**
   * Family 5 — packet boundary (sensor.py, the monitored-wire input).
   *
   * p2-e-323/324/325 packet_handler(datalink, header, packet) args 0/1/2 (:1092, the
   * pcapy callback); p2-e-227/228/229/230 _process_packet(packet, sec, usec,
   * ip_offset) args 0-3 (:274); p2-e-327 `_cap.next()` (:1169, the outermost pcapy
   * read); p2-e-235/236/237/270/272/273/279 `struct.unpack(fmt, data)` data arg
   * (:331/:341/:350/:654/:681/:702/:758 — header field extraction from the raw
   * packet buffer); p2-e-256/258/260/261 `_urllib.parse.unquote(x)` data arg
   * (:486/:528/:554/:555 — URL-decode of captured HTTP request fields).
   */
  private predicate packetBoundarySource(DataFlow::Node source) {
    functionParamAt(source, "sensor.py", "packet_handler", 0)
    or
    functionParamAt(source, "sensor.py", "packet_handler", 1)
    or
    functionParamAt(source, "sensor.py", "packet_handler", 2)
    or
    functionParamAt(source, "sensor.py", "_process_packet", 0)
    or
    functionParamAt(source, "sensor.py", "_process_packet", 1)
    or
    functionParamAt(source, "sensor.py", "_process_packet", 2)
    or
    functionParamAt(source, "sensor.py", "_process_packet", 3)
    or
    /* _cap.next() — pcapy raw packet read (only .next() call in sensor.py) */
    exists(Call c |
      c.getFunc().(Attribute).getName() = "next" and
      c.getLocation().getFile().getRelativePath() = "sensor.py" and
      source = DataFlow::exprNode(c)
    )
    or
    /* struct.unpack(fmt, data) — argument 1 is the wire-data buffer */
    exists(Call c |
      c.getFunc().(Attribute).getName() = "unpack" and
      c.getFunc().(Attribute).getObject().(Name).getId() = "struct" and
      c.getLocation().getFile().getRelativePath() = "sensor.py" and
      source = DataFlow::exprNode(c.getPositionalArg(1))
    )
    or
    /* _urllib.parse.unquote(x) — argument 0 is the URL-encoded wire field
       (unquote_plus is covered by family 2 in core/httpd.py; unquote appears only
       in sensor.py) */
    exists(Call c |
      c.getFunc().(Attribute).getName() = "unquote" and
      c.getLocation().getFile().getRelativePath() = "sensor.py" and
      source = DataFlow::exprNode(c.getPositionalArg(0))
