      read = c.getFunc().(Attribute) and
      read.getName() = "read" and
      rfile = read.getObject().(Attribute) and
      rfile.getName() = "rfile" and
      rfile.getObject().(Name).getId() = "self" and
      c.getLocation().getFile().getRelativePath() = "core/httpd.py" and
      source = DataFlow::exprNode(c)
