  /**
   * Remote feed/update content (67 candidate entries): `retrieve_content(...)`
   * call results — 54 feed files, core/common.py:64 (https→http retry recursion)
   * and :220 (ipcat_lookup static fetch), core/update.py:89/:186 — plus the
   * urlopen/resp.read decodes inside retrieve_content (core/common.py:50/:51/:59/
   * :61) and core/update.py:354 (ipcat database download). Endpoints are hardcoded,
   * but the content travels over plain HTTP from remote servers.
   */
  private predicate candidateRemoteFeedSource(DataFlow::Node source) {
    /* retrieve_content(...) — bare-name call (feeds use `from core.common import
       retrieve_content`); API-graph resolution catches alias variants */
    exists(Call c |
      c.getFunc().(Name).getId() = "retrieve_content" and
      source = DataFlow::exprNode(c)
    )
    or
    exists(API::CallNode cn |
      cn = API::moduleImport("core.common").getMember("retrieve_content").getACall() and
      source = DataFlow::exprNode(cn.getNode().getNode().(Call))
    )
    or
    /* urlopen / resp.read / ex.read inside retrieve_content and update.py — the
       location-pinned lines where remote content enters the process */
    exists(Call c |
      c.getLocation().getFile().getRelativePath() = "core/common.py" and
      c.getLocation().getStartLine() in [50, 51, 59, 61] and
      source = DataFlow::exprNode(c)
    )
    or
    exists(Call c |
      c.getLocation().getFile().getRelativePath() = "core/update.py" and
      c.getLocation().getStartLine() = 354 and
      source = DataFlow::exprNode(c)
    )
  }

  /**
   * Second-order network-derived file reads (11 candidate entries,
   * location-pinned): event-log reads in _fail2ban (core/httpd.py:483), _events
