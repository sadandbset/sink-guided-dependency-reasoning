    exists(Call c |
      c.getFunc().(Attribute).getName() = "get" and
      c.getFunc().(Attribute).getObject().(Name).getId() = "params" and
      c.getLocation().getFile().getRelativePath() = "core/httpd.py" and
      source = DataFlow::exprNode(c)
