  /**
   * Holds if `source` is the parameter at `position` of the function `funcName`
   * defined in `relPath` (0-based position with self counted at 0 — the labels'
   * arg_index convention; matches Parameter.getPosition()).
   */
  private predicate functionParamAt(DataFlow::Node source, string relPath, string funcName, int position) {
    exists(Function f, Parameter p |
      f.getName() = funcName and
      f.getLocation().getFile().getRelativePath() = relPath and
      p = f.getArg(position) and
      source = DataFlow::parameterNode(p)
    )
  }

