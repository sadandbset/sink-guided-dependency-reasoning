  private predicate candidateSecondOrderFileSource(DataFlow::Node source) {
    exists(Call c |
      c.getLocation().getFile().getRelativePath() = "core/httpd.py" and
      c.getLocation().getStartLine() in [451, 483, 516, 531, 532, 563, 638, 694, 695] and
      (
        c.getFunc().(Name).getId() = "open"
        or
        c.getFunc().(Attribute).getName() = "read"
      ) and
      source = DataFlow::exprNode(c)
    )
    or
    exists(Call c |
      c.getLocation().getFile().getRelativePath() = "core/common.py" and
      c.getLocation().getStartLine() = 245 and
      c.getFunc().(Name).getId() = "open" and
      source = DataFlow::exprNode(c)
    )
    or
    exists(Call c |
      c.getLocation().getFile().getRelativePath() = "core/update.py" and
      c.getLocation().getStartLine() = 368 and
      c.getFunc().(Name).getId() = "open" and
      source = DataFlow::exprNode(c)
