import python
import semmle.python.ApiGraphs
import semmle.python.dataflow.new.DataFlow

module MySinks {
  /** Pass key of the formal pass-2 query. */
  private string formalKey() { result = "command_injection" }

  /** Pass key of the diagnostics variant; its results are not formal findings. */
  private string diagnosticsKey() { result = "command_injection_diagnostics" }

  /**
   * Holds if `sink` is the command argument of a process-execution call for the given
   * pass key. The sink node is the data-flow node of positional argument 0 (the shell
   * command string, or the argv list for non-shell invocations).
   */
  predicate isSink(DataFlow::Node sink, string passKey) {
    passKey = formalKey() and
    exists(Call c |
      commandExecCall(c) and
      sink = DataFlow::exprNode(c.getPositionalArg(0)) and
      reviewedSinkSite(c)
    )
    or
    passKey = diagnosticsKey() and
    exists(Call c |
      commandExecCall(c) and
      sink = DataFlow::exprNode(c.getPositionalArg(0))
    )
  }

  /**
   * Holds if `c` is a call into a subprocess process-execution API. Resolved through
   * API graphs (alias-aware, handles import variants — the idiom verified against
   * this database by the Phase-1 extraction queries) with a syntax-level
   * `subprocess.<member>(...)` fallback.
   */
  private predicate commandExecCall(Call c) {
    exists(string member, API::CallNode cn |
      member in ["call", "check_call", "check_output", "run", "Popen"] and
      cn = API::moduleImport("subprocess").getMember(member).getACall() and
      c = cn.getNode().getNode().(Call)
    )
    or
    exists(string member |
      member in ["call", "check_call", "check_output", "run", "Popen"] and
      c.getFunc().(Attribute).getName() = member and
      c.getFunc().(Attribute).getObject().(Name).getId() = "subprocess"
    )
  }

  /**
   * Restricts the formal query to the single human-reviewed (tp) sink site:
   * core/httpd.py:399, the `logger` shell command in ReqHandler._login. The call
   * also passes shell=True (verified by the shell_true extraction row merged into
   * p2-e-522); the keyword check is kept as redundant pinning.
   */
  private predicate reviewedSinkSite(Call c) {
    c.getLocation().getFile().getRelativePath() = "core/httpd.py" and
    c.getLocation().getStartLine() = 399 and
    shellTrueCall(c)
  }

  /** Holds if call `c` passes the keyword argument shell=True. */
  private predicate shellTrueCall(Call c) {
    exists(Keyword k |
      k = c.getANamedArg().(Keyword) and
      k.getArg() = "shell" and
      k.getValue() instanceof True
    )
  }
}
