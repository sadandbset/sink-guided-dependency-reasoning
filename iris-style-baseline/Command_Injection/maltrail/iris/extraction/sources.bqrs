      isExtensionPack: false
      localPath: file:///E:/codeql-codeql-cli-2.25.2/python/ql/lib/
      localPackDefinitionFile: file:///E:/codeql-codeql-cli-2.25.2/python/ql/lib/qlpack.yml
      runDataExtensions: []
    codeql/threat-models#2:
