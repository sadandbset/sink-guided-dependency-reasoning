import python
import semmle.python.dataflow.new.DataFlow

module MySinks {
  /** Pass key of the formal pass-2 query. */
  private string formalKey() { result = "command_injection" }

  /** Pass key of the diagnostics variant; its results are not formal findings. */
  private string diagnosticsKey() { result = "command_injection_diagnostics" }

  /**
   * Holds if `sink` is the command argument of a process-execution call (or
   * the exec-relevant parameter of a reviewed wrapper) for the given pass
   * key.
   */
  predicate isSink(DataFlow::Node sink, string passKey) {
    passKey = formalKey() and (execApiSink(sink) or wrapperParamSink(sink))
    or
    passKey = diagnosticsKey() and execApiSink(sink)
  }

  /* ------------------------------------------------------------------ */
  /* Raw process-execution API sinks (both pass keys)                    */
  /* ------------------------------------------------------------------ */

  private predicate execApiSink(DataFlow::Node sink) {
    osExecSink(sink)
    or
    subprocessSink(sink)
    or
    shellExecuteCmdSink(sink)
  }

  /**
   * `os.system(cmd)` / `os.popen(cmd)` — argument 0 is the shell command
   * string. The 14 matched sites per API are exactly the extraction's rows:
   * tp sites pslib/__init__.py:814/:834 (hadoop fs string from fleet_desc
   * config, phase1_review §2.3) and fleet_util.py:1320/:1321 ("echo -n " +
   * days/hours parameters); the remaining fixed-literal sites (core.py,
   * role_maker.py, main.py:983/:989) carry no taint and alert nothing.
   */
  private predicate osExecSink(DataFlow::Node sink) {
    exists(Call c |
      osExecCall(c) and
      sink = DataFlow::exprNode(c.getPositionalArg(0))
    )
  }

  /**
   * subprocess.Popen / run / call / check_call / check_output — argument 0,
   * in both shapes:
   *
   *   - shell command string (e.g. manager.py:364
   *     Popen(self.args.elastic_pre_hook, shell=True), download.py:204
   *     Popen(f'wget ... {url}', shell=True), prune.py:521
   *     subprocess.run(memory_estimation_cmd, shell=True)): the string node
   *     itself is the sink;
   *   - argv list without shell (launch_utils.py:833
   *     Popen([sys.executable, '-u', args.training_script] +
   *     args.training_script_args), extension_utils.py:1408
   *     check_output(['which', compiler])): each list element is a sink
   *     (argument injection), and the list node is also a sink because
   *     python-all's containerStep propagates element taint to the list.
   *
   * The extraction exec_mode column was cross-checked against these sites
   * during Phase 1 (phase1_review.md §5.3); shlex.split+argv-list sites
   * (optimization_tuner.py:462/:477, parallelizer.py:412-417) are a recorded
   * structural mitigation, not a barrier (see MySanitizers.qll).
   */
  private predicate subprocessSink(DataFlow::Node sink) {
    exists(Call c |
      subprocessExecCall(c) and
      (
        /* shell-string (or scalar argv) shape: the command argument itself */
        sink = DataFlow::exprNode(c.getPositionalArg(0))
        or
        /* non-shell argv-list shape: every element is an injectable argument */
        c.getPositionalArg(0) instanceof List and
        sink = DataFlow::exprNode(c.getPositionalArg(0).(List).getAnElt())
      )
    )
  }

  /**
   * `core.shell_execute_cmd(exe_cmd, ...)` — argument 0 is the hadoop fs
   * shell string. Single repo site: fleet/utils/fs.py:506
   * `core.shell_execute_cmd(exe_cmd, 0, 0, redirect_stderr)` where
   * `exe_cmd = f'{self._base_cmd} -{cmd}'` embeds hadoop_bin/fs_ugi from the
   * fleet distributed-strategy config (label p2-snk-shell-execute-cmd, tp
   * 0.65). The C++-backed binding is not import-resolvable, so the match is
   * on the attribute call name (grep-verified unique in python/paddle/).
   */
  private predicate shellExecuteCmdSink(DataFlow::Node sink) {
    exists(Call c |
      c.getFunc() instanceof Attribute and
      c.getFunc().(Attribute).getName() = "shell_execute_cmd" and
      sink = DataFlow::exprNode(c.getPositionalArg(0))
    )
  }

  /** `os.system`/`os.popen` module-attribute call, plus from-import fallback. */
  private predicate osExecCall(Call c) {
    exists(string member |
      member in ["system", "popen"] and
      c.getFunc().(Attribute).getName() = member and
      c.getFunc().(Attribute).getObject().(Name).getId() = "os"
    )
    or
    exists(string member, Import i |
      member in ["system", "popen"] and
      c.getFunc().(Name).getId() = member and
      i.getAnImportedModuleName() = "os." + member and
      i.getScope().(Module) = c.getEnclosingModule()
    )
  }

  /** subprocess exec-family module-attribute call, plus from-import fallback. */
  private predicate subprocessExecCall(Call c) {
    exists(string member |
      member in ["Popen", "run", "call", "check_call", "check_output"] and
      c.getFunc().(Attribute).getName() = member and
      c.getFunc().(Attribute).getObject().(Name).getId() = "subprocess"
    )
    or
    exists(string member, Import i |
      member in ["Popen", "run", "call", "check_call", "check_output"] and
      c.getFunc().(Name).getId() = member and
      i.getAnImportedModuleName() = "subprocess." + member and
      i.getScope().(Module) = c.getEnclosingModule()
    )
  }

  /* ------------------------------------------------------------------ */
  /* Wrapper-parameter sinks (formal pass key only)                      */
  /* ------------------------------------------------------------------ */

  /**
   * The exec-relevant parameter of each reviewed wrapper — taint reaching
   * the wrapper call argument lands here (native call->parameter flow) and
   * the wrapper demonstrably passes it to shell execution:
   *
   *   run_shell_command cmd (core.py:184-189): Popen(cmd, shell=True);
   *   run_cmd command (extension_utils.py:1379-1393): check_call(command,
   *     shell=True);
   *   HDFSClient._run_cmd cmd (fs.py:500-514): f'{self._base_cmd} -{cmd}'
   *     -> core.shell_execute_cmd (CSV arg_index 2 was manually corrected to
   *     0 by the review — first non-self parameter);
   *   call_cmd cmd (topology.py:20-33): Popen(cmd, shell=True);
   *   _jit_compile file_path (extension_utils.py:1325-1354): 'cd {ext_dir}
   *     && {interpreter} {setup_file} build' -> run_cmd (CSV arg_index 1 was
   *     manually corrected to 0 by the review);
   *   check_abi_compatibility compiler (extension_utils.py:1399-1440):
   *     check_output argv lists (argument-injection-only exposure).
   *
   * Index convention: labels' arg_index counts the first non-self parameter
   * as 0 (CodeQL Function.getArg counts self at 0, hence the +1 shift for
   * methods).
   */
  private predicate wrapperParamSink(DataFlow::Node sink) {
    moduleFunctionParam(sink, "python/paddle/base/core.py", "run_shell_command", 0)
    or
    moduleFunctionParam(sink, "python/paddle/utils/cpp_extension/extension_utils.py", "run_cmd", 0)
    or
    methodParam(sink, "python/paddle/distributed/fleet/utils/fs.py", "HDFSClient", "_run_cmd", 0)
    or
    moduleFunctionParam(sink, "python/paddle/distributed/auto_parallel/static/topology.py", "call_cmd", 0)
    or
    moduleFunctionParam(sink, "python/paddle/utils/cpp_extension/extension_utils.py", "_jit_compile", 0)
    or
    moduleFunctionParam(sink, "python/paddle/utils/cpp_extension/extension_utils.py", "check_abi_compatibility", 0)
  }

  /**
   * Holds if `sink` is the parameter at `index` (0-based, first non-self
   * parameter is 0) of the module-level function `funcName` defined in
   * `relPath`.
   */
  private predicate moduleFunctionParam(DataFlow::Node sink, string relPath, string funcName, int index) {
    exists(Function f, Parameter p |
      f.getName() = funcName and
      f.getLocation().getFile().getRelativePath() = relPath and
      not f.getEnclosingScope() instanceof Class and
      p = f.getArg(index) and
      sink = DataFlow::parameterNode(p)
    )
  }

  /**
   * Holds if `sink` is the parameter at non-self position `nonSelfIndex` of
   * the method `funcName` of class `className` defined in `relPath`.
   */
  private predicate methodParam(DataFlow::Node sink, string relPath, string className, string funcName, int nonSelfIndex) {
    exists(Function f, Parameter p |
      f.getName() = funcName and
      f.getLocation().getFile().getRelativePath() = relPath and
      f.getEnclosingScope().(Class).getName() = className and
      f.getArg(0).isSelf() and
      p = f.getArg(nonSelfIndex + 1) and
      sink = DataFlow::parameterNode(p)
    )
  }
}