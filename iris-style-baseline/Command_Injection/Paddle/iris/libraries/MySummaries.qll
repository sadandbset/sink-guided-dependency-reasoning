import python
import semmle.python.ApiGraphs
import semmle.python.dataflow.new.DataFlow

module MySummaries {
  /**
   * Holds if taint may additionally flow from `nodeFrom` to `nodeTo` for the
   * given pass key. All five families connect already-tainted nodes; no
   * step creates taint from nothing and none is unconditional.
   */
  predicate isAdditionalTaintStep(DataFlow::Node nodeFrom, DataFlow::Node nodeTo, string passKey) {
    passKey in ["command_injection", "command_injection_diagnostics"] and
    (
      parsedNamespaceAttrStep(nodeFrom, nodeTo)
      or
      downloadDispatchStep(nodeFrom, nodeTo)
      or
      jitCompileStep(nodeFrom, nodeTo)
      or
      runCmdStep(nodeFrom, nodeTo)
      or
      runShellCommandStep(nodeFrom, nodeTo)
