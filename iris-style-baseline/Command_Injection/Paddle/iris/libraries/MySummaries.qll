    moduleFunctionParam(nodeFrom, "python/paddle/base/core.py", "run_shell_command", 0)
    and
    exists(Call c |
      c.getFunc().(Attribute).getName() = "Popen" and
      c.getFunc().(Attribute).getObject().(Name).getId() = "subprocess" and
      c.getLocation().getFile().getRelativePath() = "python/paddle/base/core.py" and
      c.getLocation().getStartLine() = 187 and
      nodeTo = DataFlow::exprNode(c.getPositionalArg(0))
    )
  }

  /**
   * Holds if `node` is the parameter at `index` (0-based, first non-self
   * parameter is 0) of the module-level function `funcName` defined in
   * `relPath`.
