  private predicate jitCompileStep(DataFlow::Node nodeFrom, DataFlow::Node nodeTo) {
    moduleFunctionParam(nodeFrom, "python/paddle/utils/cpp_extension/extension_utils.py", "_jit_compile", 0)
    and
    exists(Call c |
      c.getFunc().(Name).getId() = "run_cmd" and
      c.getLocation().getFile().getRelativePath() = "python/paddle/utils/cpp_extension/extension_utils.py" and
      c.getLocation().getStartLine() = 1354 and
      nodeTo = DataFlow::exprNode(c.getPositionalArg(0))
    )
  }

  /**
   * Family 4: run_cmd command parameter -> the check_call(command, shell=True)
   * arguments at extension_utils.py:1389 and :1393 (label p2-sum-run-cmd-call).
   */
  private predicate runCmdStep(DataFlow::Node nodeFrom, DataFlow::Node nodeTo) {
    moduleFunctionParam(nodeFrom, "python/paddle/utils/cpp_extension/extension_utils.py", "run_cmd", 0)
    and
    exists(Call c |
      c.getFunc().(Attribute).getName() = "check_call" and
      c.getFunc().(Attribute).getObject().(Name).getId() = "subprocess" and
      c.getLocation().getFile().getRelativePath() = "python/paddle/utils/cpp_extension/extension_utils.py" and
      c.getLocation().getStartLine() in [1389, 1393] and
      nodeTo = DataFlow::exprNode(c.getPositionalArg(0))
    )
  }

  /**
   * Family 5: run_shell_command cmd parameter -> the Popen(cmd, shell=True)
