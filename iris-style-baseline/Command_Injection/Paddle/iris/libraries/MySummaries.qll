  /**
   * Family 1: parse_known_args Namespace -> attribute reads.
   *
   * Mirrors python-all's Stdlib ArgumentParserAnyAttributeStep (which covers
   * parse_args only): any value reachable from the return of
   * `ArgumentParser().parse_known_args()` taints the attribute reads whose
   * object it is. Together with the native tuple-unpack, return, parameter
   * and attribute store->load steps this carries
   * fleet/launch.py:257 `known_args, _ = parser.parse_known_args()` through
   * `args = _parse_args()` (:743) and `launch_elastic(args, ...)` (:768)
   * into `ElasticManager.__init__`'s `self.args = args` (manager.py:127-128)
   * and onto `self.args.elastic_pre_hook` (manager.py:359/:365).
   */
  private predicate parsedNamespaceAttrStep(DataFlow::Node nodeFrom, DataFlow::Node nodeTo) {
    nodeFrom =
      API::moduleImport("argparse").getMember("ArgumentParser").getReturn()
        .getMember("parse_known_args").getReturn().getAValueReachableFromSource()
    and
    nodeTo.(DataFlow::AttrRead).getObject() = nodeFrom
  }

  /**
   * Family 2: `_download_methods[method](url, fullname)` at
   * utils/download.py:254 — taint on argument 0 (url) or 1 (fullname) flows
   * to the corresponding parameter (0/1) of `_get_download` (:164) and
   * `_wget_download` (:199), the two functions in the dispatch dict
   * (:219-222). The wget branch reaches
   * `Popen(f'wget -O {tmp_fullname} ... {url}', shell=True)` at :204.
   */
  private predicate downloadDispatchStep(DataFlow::Node nodeFrom, DataFlow::Node nodeTo) {
    exists(Call c, int position |
      position in [0, 1] and
      c.getFunc() instanceof Subscript and
      c.getLocation().getFile().getRelativePath() = "python/paddle/utils/download.py" and
      c.getLocation().getStartLine() = 254 and
      nodeFrom = DataFlow::exprNode(c.getPositionalArg(position)) and
      (
        moduleFunctionParam(nodeTo, "python/paddle/utils/download.py", "_get_download", position)
        or
        moduleFunctionParam(nodeTo, "python/paddle/utils/download.py", "_wget_download", position)
      )
    )
  }

  /**
   * Family 3: `_jit_compile` file_path parameter -> the run_cmd argument at
