  /* ------------------------------------------------------------------ */
  /* Reviewed (formal) source families                                   */
  /* ------------------------------------------------------------------ */

  private predicate reviewedSource(DataFlow::Node source) {
    sysArgvSource(source)
    or
    parsedCliSource(source)
