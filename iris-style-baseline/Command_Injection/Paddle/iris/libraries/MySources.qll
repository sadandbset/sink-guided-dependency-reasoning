  /**
   * Family 4 — `getenv_or_backup(...)` calls (p2-src-getenv-or-backup, 0.6;
   * 7 raw rows in 4 files).
   *
   * backup_env.py:21-31 returns `os.getenv(name)` (or the value restored from
   * the JSON env backup file written by process_context). The 7 call sites
   * (executor.py:635, fleet/base/role_maker.py:871/:1095, elastic/manager.py:154,
   * parallel.py:709/:910/:1086) are exactly the bare-name calls of this
   * function in the tree (grep-verified), so an unpinned name match
   * reproduces the reviewed rows. Equivalent to the env->return summary the
   * label mentions; sourcing the call result is the reviewed rendering.
   */
  private predicate backupEnvSource(DataFlow::Node source) {
    exists(Call c |
      c.getFunc().(Name).getId() = "getenv_or_backup" and
      source = DataFlow::exprNode(c)
    )
  }

  /**
   * Family 5 — JSON config decodes (p2-src-json-load / p2-src-json-loads,
   * 0.55; 25 source raw rows in 12 files).
   *
   * Decoded values parameterize process launching: fleet/launch_utils.py:930-931
   * and launch/main.py:322-323 feed worker/server config into subprocess
   * command lists; auto_tuner config values flow into the prune.py:513-521
   * shell command. The 10 in-process metadata rows (profiler, quanter,
   * checkpoint, storable, cost_model, autotune, reader, extension_utils) are
   * role=none and excluded by the file pinning.
   */
  private predicate jsonConfigSource(DataFlow::Node source) {
    exists(Call c |
      c.getFunc().(Attribute).getName() in ["load", "loads"] and
      c.getFunc().(Attribute).getObject().(Name).getId() = "json" and
      c.getLocation().getFile().getRelativePath() in [
        /* json.load source rows */
        "python/paddle/distributed/auto_parallel/static/cluster.py",
        "python/paddle/distributed/auto_parallel/static/engine.py",
        "python/paddle/distributed/auto_tuner/utils.py",
        "python/paddle/distributed/backup_env.py",
        "python/paddle/distributed/fleet/launch_utils.py",
        "python/paddle/distributed/launch/main.py",
        /* json.loads source rows */
        "python/paddle/distributed/launch/controllers/collective.py",
        "python/paddle/distributed/launch/controllers/master.py",
        "python/paddle/distributed/launch/controllers/ps.py",
        "python/paddle/distributed/launch/controllers/rpc.py",
        "python/paddle/incubate/distributed/fleet/fleet_util.py"
      ] and
      source = DataFlow::exprNode(c)
    )
  }

  /**
   * Family 6 — etcd cluster-state reads (p2-src-etcd, 0.55; 13 raw rows in
   * 5 files).
   *
   * `self.etcd.get_prefix(self.node_prefix)` (fleet/elastic/manager.py:242/
   * :264/:354/:418) and the master/main.py rendezvous reads fetch node lists
   * and endpoints from the external etcd service. The labels kept the family
   * candidate at 0.55 ("values drive launch decisions and endpoint lists;
   * direct flow into command strings not observed").
   */
  private predicate etcdStateSource(DataFlow::Node source) {
    exists(Call c |
      c.getFunc() instanceof Attribute and
      c.getFunc().(Attribute).getName() = "get_prefix" and
      c.getLocation().getFile().getRelativePath() in [
        "python/paddle/distributed/fleet/elastic/manager.py",
        "python/paddle/distributed/launch/controllers/master.py",
        "python/paddle/distributed/launch/main.py",
        "python/paddle/distributed/launch/utils/etcd_client.py",
        "python/paddle/distributed/launch/utils/kv_client.py"
      ] and
      source = DataFlow::exprNode(c)
    )
  }

  /**
   * Family 7 — socket peer-data reads (p2-src-socket-recv, 0.5; 2 raw rows).
   *
   * auto_parallel/static/utils.py:1809/:1829 `client_socket.recv(buff_size)
   * .decode()` in get_cluster(): rank/host strings received from peer
   * cluster nodes over TCP. Kept candidate for recall; the other 20
   * socket.recv rows (tensor/record/sync receives) are role=none and are not
   * matched by this location-pinned predicate.
   */
  private predicate socketPeerSource(DataFlow::Node source) {
    exists(Call c |
      c.getFunc().(Attribute).getName() = "recv" and
      c.getLocation().getFile().getRelativePath() =
        "python/paddle/distributed/auto_parallel/static/utils.py" and
      c.getLocation().getStartLine() in [1809, 1829] and
      source = DataFlow::exprNode(c)
    )
  }

  /* ------------------------------------------------------------------ */
  /* Wrapper / public-API parameter seeds — diagnostics pass key only    */
  /* ------------------------------------------------------------------ */

  /**
   * Internal-wrapper and public-API parameters that the reviewed labels
   * recorded as Step-4 coverage gaps (labels.json metadata notes;
   * phase1_review.md §7): "function parameters of public APIs ... were not
   * extractable as source candidates by the syntactic extraction; consider
   * param-source or summary edges". Per the task directive these are NOT
   * formal sources — they exist only under "command_injection_diagnostics"
   * to verify parameter -> dangerous-call propagation. None of their results
   * may be counted as formal CWE-78 findings.
   *
   * Index convention (labels.json): 0-based position of the first non-self
   * parameter (`arg_index` 0 = first non-self param; `self` counts at 0 in
   * CodeQL `Function.getArg`, hence the +1 shift in methodParam).
   */
  private predicate wrapperParamSource(DataFlow::Node source) {
    execWrapperParamSource(source)
    or
    publicApiParamSource(source)
  }

  /** Sink-side wrapper parameters (the same functions MySinks formalizes). */
  private predicate execWrapperParamSource(DataFlow::Node source) {
    /* run_shell_command(cmd) — base/core.py:184, wraps Popen(cmd, shell=True) */
    moduleFunctionParam(source, "python/paddle/base/core.py", "run_shell_command", 0)
    or
    /* run_cmd(command) — extension_utils.py:1379, wraps check_call(shell=True) */
    moduleFunctionParam(source, "python/paddle/utils/cpp_extension/extension_utils.py", "run_cmd", 0)
    or
    /* HDFSClient._run_cmd(cmd) — fs.py:500, cmd -> f'{_base_cmd} -{cmd}' -> core.shell_execute_cmd */
    methodParam(source, "python/paddle/distributed/fleet/utils/fs.py", "HDFSClient", "_run_cmd", 0)
    or
    /* call_cmd(cmd) — topology.py:20, wraps Popen(cmd, shell=True) */
    moduleFunctionParam(source, "python/paddle/distributed/auto_parallel/static/topology.py", "call_cmd", 0)
    or
    /* _jit_compile(file_path) — extension_utils.py:1325, file_path -> 'cd {ext_dir} && ...' */
    moduleFunctionParam(source, "python/paddle/utils/cpp_extension/extension_utils.py", "_jit_compile", 0)
    or
    /* check_abi_compatibility(compiler) — extension_utils.py:1399, argv-list check_output */
    moduleFunctionParam(source, "python/paddle/utils/cpp_extension/extension_utils.py", "check_abi_compatibility", 0)
    or
    /* HDFSClient.__init__(hadoop_home, configs) — fs.py:475; hadoop_bin/
       -D config values are concatenated into _base_cmd and executed via
       core.shell_execute_cmd (phase1_review.md §7 coverage gap) */
    methodParam(source, "python/paddle/distributed/fleet/utils/fs.py", "HDFSClient", "__init__", 0)
    or
    methodParam(source, "python/paddle/distributed/fleet/utils/fs.py", "HDFSClient", "__init__", 1)
  }

  /** Public-API parameters feeding the reviewed tp-shaped sinks. */
  private predicate publicApiParamSource(DataFlow::Node source) {
    /* download API: get_path_from_url(url) -> _download(url, ...) ->
       _download_methods[method](url, fullname) -> _wget_download(url, ...)
       -> Popen(f'wget -O {tmp} {url}', shell=True) (utils/download.py:204) */
    moduleFunctionParam(source, "python/paddle/utils/download.py", "get_path_from_url", 0)
    or
    moduleFunctionParam(source, "python/paddle/utils/download.py", "_download", 0)
    or
    moduleFunctionParam(source, "python/paddle/utils/download.py", "_wget_download", 0)
    or
    /* FleetUtil.get_online_pass_interval(days, hours) — fleet_util.py:1290;
       days/hours are concatenated into os.popen("echo -n " + ...) at
       fleet_util.py:1320/:1321 */
    methodParam(source, "python/paddle/incubate/distributed/fleet/fleet_util.py", "FleetUtil", "get_online_pass_interval", 0)
    or
    methodParam(source, "python/paddle/incubate/distributed/fleet/fleet_util.py", "FleetUtil", "get_online_pass_interval", 1)
    or
    /* IrGraph.draw(save_path, name) — framework.py:5554 (label says
       "Graph.draw"); paths reach subprocess.call('dot -Tpdf ' + ...,
       shell=True) at framework.py:5570 via _convert_to_pdf */
    methodParam(source, "python/paddle/base/framework.py", "IrGraph", "draw", 0)
    or
    methodParam(source, "python/paddle/base/framework.py", "IrGraph", "draw", 1)
    or
    /* PSLib model-loading API: load_one_table(model_path) ->
       _load_one_table_from_paddle_model(model_path, model_proto_file) ->
       os.system(hadoop fs shell string) at pslib/__init__.py:814/:834 */
    methodParam(source, "python/paddle/incubate/distributed/fleet/parameter_server/pslib/__init__.py", "PSLib", "load_one_table", 1)
    or
    methodParam(source, "python/paddle/incubate/distributed/fleet/parameter_server/pslib/__init__.py", "PSLib", "_load_one_table_from_paddle_model", 2)
    or
    methodParam(source, "python/paddle/incubate/distributed/fleet/parameter_server/pslib/__init__.py", "PSLib", "_load_one_table_from_paddle_model", 3)
  }

  /**
   * Holds if `source` is the parameter at `index` (0-based, first non-self
   * parameter is 0) of the module-level function `funcName` defined in
   * `relPath`.
   */
  private predicate moduleFunctionParam(DataFlow::Node source, string relPath, string funcName, int index) {
    exists(Function f, Parameter p |
      f.getName() = funcName and
      f.getLocation().getFile().getRelativePath() = relPath and
      not f.getEnclosingScope() instanceof Class and
      p = f.getArg(index) and
      source = DataFlow::parameterNode(p)
    )
  }

  /**
   * Holds if `source` is the parameter at non-self position `nonSelfIndex`
   * of the method `funcName` of class `className` defined in `relPath`
   * (labels' arg_index convention: `self` is not counted, CodeQL
   * `Function.getArg` counts `self` at 0).
   */
  private predicate methodParam(DataFlow::Node source, string relPath, string className, string funcName, int nonSelfIndex) {
    exists(Function f, Parameter p |
      f.getName() = funcName and
      f.getLocation().getFile().getRelativePath() = relPath and
      f.getEnclosingScope().(Class).getName() = className and
      f.getArg(0).isSelf() and
      p = f.getArg(nonSelfIndex + 1) and
      source = DataFlow::parameterNode(p)
    )
  }
}
