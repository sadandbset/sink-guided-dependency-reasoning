  /**
   * Family 1 — `sys.argv` field reads (p2-src-sysargv, 0.75).
   *
   * The 7 `sys.argv` sites under python/paddle/ (grep-verified) are exactly
   * the 7 labeled rows in 3 files: fleet/launch.py:364/:512/:517 (sys.argv[1:]
   * packed into PADDLE_ORIGINAL_CMD_ARGS and re-expanded into the
   * parallelizer.py:412-417 relaunch command), launch/controllers/master.py:107
   * (cmd.extend(sys.argv[1:]) into the printed launch command) and
   * base/__init__.py:193/:195/:196 (init_glog argv). Store-position matches
   * (base/__init__.py:195 `sys.argv = [""]`) are excluded — only reads carry
   * the CLI value.
   */
  private predicate sysArgvSource(DataFlow::Node source) {
    exists(Attribute a |
      a.getObject().(Name).getId() = "sys" and
      a.getName() = "argv" and
      not exists(Assign asgn | asgn.getATarget() = a) and
      a.getLocation().getFile().getRelativePath() in [
        "python/paddle/base/__init__.py",
        "python/paddle/distributed/fleet/launch.py",
        "python/paddle/distributed/launch/controllers/master.py"
      ] and
      source = DataFlow::exprNode(a)
    )
  }

  /**
   * Family 2 — argparse parse results (p2-src-parse-args 0.7,
   * p2-src-parse-known 0.7; 9 raw rows in 9 files).
   *
   * The source node is the parse call result (the argparse Namespace). Taint
   * on a Namespace flows to attribute reads of it natively for
   * `parse_args` (python-all Stdlib ArgumentParserAnyAttributeStep); for
   * `parse_known_args` the equivalent step is rendered in MySummaries.qll
   * (parsedNamespaceAttrStep) because the stdlib modeling covers parse_args
   * only. The load-bearing reviewed chain is fleet/launch.py:257
   * `known_args, _ = parser.parse_known_args()` -> args (via _parse_args,
   * fleet/launch.py:743) -> launch_elastic -> ElasticManager.__init__
   * (elastic/manager.py:127-128 `self.args = args`) ->
   * self.args.elastic_pre_hook -> Popen(..., shell=True) at
   * elastic/manager.py:364 (label p2-snk-popen, tp-shaped 0.85).
   */
  private predicate parsedCliSource(DataFlow::Node source) {
    exists(Call c |
      c.getFunc() instanceof Attribute and
      c.getFunc().(Attribute).getName() in ["parse_args", "parse_known_args"] and
      c.getLocation().getFile().getRelativePath() in [
        /* parse_args rows */
        "python/paddle/distributed/auto_parallel/static/profiler_helper_static.py",
        "python/paddle/distributed/auto_parallel/static/tuner/profiler.py",
        "python/paddle/distributed/auto_tuner/memory_cost_model.py",
        "python/paddle/distributed/elastic.py",
        "python/paddle/distributed/fleet/utils/pp_parallel_adaptor.py",
        "python/paddle/distributed/launch/controllers/ipu_controller.py",
        "python/paddle/incubate/autograd/generate_op_map.py",
        /* parse_known_args rows */
        "python/paddle/distributed/fleet/launch.py",
        "python/paddle/distributed/launch/context/args_envs.py"
      ] and
      source = DataFlow::exprNode(c)
    )
  }

  /**
   * Family 3 — environment-variable reads in command-construction modules
   * (p2-src-getenv / p2-src-environ-get / p2-src-environ-getitem, 0.6;
   * 304 Tier-A raw rows across 43 files).
   *
   * The Tier A/B split is the reviewed per-row decision in
   * labels_raw_pass2.json: 304 env reads sit in process-launch /
   * command-construction modules (source-candidate), 129 in compute modules
   * (none). Restricting this family to the 43 Tier-A files reproduces that
   * split exactly. The demonstrable chain is fleet/launch.py:364-365
   * (sys.argv[1:] -> PADDLE_ORIGINAL_CMD_ARGS env -> parallelizer.py:405-417
   * relaunch command) and extension_utils.py:669+ (CC/CXX/CUDA toolchain
   * selection -> compiler command construction).
   *
   * Shapes: `os.getenv(...)`, `os.environ.get(...)` (call results) and
   * `os.environ[...]` (subscript reads; store-position matches excluded).
   */
  private predicate envReadSource(DataFlow::Node source) {
    /* os.getenv(...) — p2-src-getenv */
    exists(Call c |
      c.getFunc().(Attribute).getName() = "getenv" and
      c.getFunc().(Attribute).getObject().(Name).getId() = "os" and
      tierAFile(c.getLocation().getFile().getRelativePath()) and
      source = DataFlow::exprNode(c)
    )
    or
    /* os.environ.get(...) — p2-src-environ-get */
    exists(Call c |
      c.getFunc().(Attribute).getName() = "get" and
      c.getFunc().(Attribute).getObject() instanceof Attribute and
      c.getFunc().(Attribute).getObject().(Attribute).getName() = "environ" and
      c.getFunc().(Attribute).getObject().(Attribute).getObject().(Name).getId() = "os" and
      tierAFile(c.getLocation().getFile().getRelativePath()) and
      source = DataFlow::exprNode(c)
    )
    or
    /* os.environ[...] — p2-src-environ-getitem (reads only) */
    exists(Subscript s |
      s.getObject() instanceof Attribute and
      s.getObject().(Attribute).getName() = "environ" and
      s.getObject().(Attribute).getObject().(Name).getId() = "os" and
      not exists(Assign asgn | asgn.getATarget() = s) and
      tierAFile(s.getLocation().getFile().getRelativePath()) and
      source = DataFlow::exprNode(s)
    )
  }

