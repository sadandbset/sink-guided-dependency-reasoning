  /** Syntactic name of the callee of a call ("<expr>" if neither Name nor Attribute). */
  private string calledNameOf(Call c) {
    result = c.getFunc().(Name).getId()
    or
    result = c.getFunc().(Attribute).getName()
    or
    not c.getFunc() instanceof Name and
    not c.getFunc() instanceof Attribute and
    result = "<expr>"
  }

  /**
   * Additional taint steps for the 14 rendered tp summary labels
   * (labels/labels.json pass 2). Each hop connects a wrapper parameter to
   * the terminal execution node documented in the label's evidence; the
   * steps are pinned by (file, function name, parameter position) and
   * (file, line) exactly as reviewed. Within-function hops are also
   * covered by local dataflow; they are rendered anyway because the labels
   * model them explicitly and the explicit edge guarantees the path if
   * join/format indirection breaks native flow. Cross-function hops
   * (pyfuncServeStep, joinCommandsStep) are NOT natively tracked and rely
   * on these edges.
   *
   * Recorded but NOT rendered (documented, no edge invented):
   *   - snk-026 _serve_mleap (models/container/__init__.py:212): the wrapper
   *     has no taint-carrying parameter and its exec site (:224, shell=True)
   *     is a reviewed fp (all fixed literals) - there is no edge to model.
   *   - snk-074 Runner.start (gateway/runner.py:58): start(self) takes only
   *     self; the carriers are Runner fields set from the gateway CLI (whose
   *     parameters are already isCliParamSource), and the terminal Popen at
   *     :59 is a candidate-only sink (isSinkDiagnostic).
   *   - snk-010 run_local (sagemaker/__init__.py:1048) and snk-052
   *     _build_image_from_context (models/docker_utils.py:227): candidate
   *     labels; their terminals are the diagnostic-tier argv sinks.
   */
  predicate isAdditionalTaintStep(
    DataFlow::Node nodeFrom, DataFlow::Node nodeTo, string passKey
  ) {
    passKey = "command_injection" and
    (
      execCmdStep(nodeFrom, nodeTo)
      or
      environmentExecuteStep(nodeFrom, nodeTo)
      or
      runEntryPointStep(nodeFrom, nodeTo)
      or
      runMlflowRunCmdStep(nodeFrom, nodeTo)
      or
      joinCommandsStep(nodeFrom, nodeTo)
      or
      pyfuncServeStep(nodeFrom, nodeTo)
      or
      servePyfuncContainerStep(nodeFrom, nodeTo)
      or
      installPyfuncDepsStep(nodeFrom, nodeTo)
      or
      rfuncExecuteStep(nodeFrom, nodeTo)
      or
      databricksRunCmdStep(nodeFrom, nodeTo)
      or
      pushImageToEcrStep(nodeFrom, nodeTo)
      or
      requirementsRunCommandStep(nodeFrom, nodeTo)
      or
      downloadWheelsStep(nodeFrom, nodeTo)
    )
  }

