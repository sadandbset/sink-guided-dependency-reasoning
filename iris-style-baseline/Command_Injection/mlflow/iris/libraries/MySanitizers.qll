/**
 * Augur-generated sanitizer library - Pass 2 (CWE-077/078/088) for MLflow.
 *
 * Machine-generated by scripts/render_libraries.py (Augur 0.3.0 workflow,
 * Step 4) from labels/labels.json pass 2 (run mlflow-iris-pass2-labeling-20261015) - do not edit by
 * hand; re-render instead.
 *
 * Snapshot: mlflow 2.5.1.dev0, sha 330bf0b38b07d4adf3fae99af1b44c8e857f514a.
 * 2 sanitizer tp labels rendered (quote, EntryPoint._sanitize_param_dict).
 */

private import python
private import semmle.python.dataflow.new.DataFlow

module MySanitizers {
  /** Syntactic name of the callee of a call ("<expr>" if neither Name nor Attribute). */
  private string calledNameOf(Call c) {
    result = c.getFunc().(Name).getId()
    or
    result = c.getFunc().(Attribute).getName()
    or
    not c.getFunc() instanceof Name and
    not c.getFunc() instanceof Attribute and
    result = "<expr>"
  }

  /**
   * Two reviewed barrier labels (labels/labels.json san-001, san-002):
   *
   *   - san-001 quote (mlflow/utils/string_utils.py:131): shlex.quote (POSIX)
   *     / mslex_quote (Windows). Barrier = the value of a quote(...) call at
   *     the reviewed application sites: MLproject declared parameters and
   *     entry-point script names (mlflow/projects/_project_spec.py:167/:172/
   *     :241), the R backend model path (mlflow/rfunc/backend.py:41/:80/:119)
   *     and the Databricks mlflow run argv (mlflow/projects/databricks.py:361).
   *     These three files import quote via
   *     `from mlflow.utils.string_utils import quote`, so a bare callee named
   *     quote in them resolves to the barrier function.
   *   - san-002 EntryPoint._sanitize_param_dict
   *     (mlflow/projects/_project_spec.py:241): applies quote() to every
   *     declared/extra parameter value before str.format substitution into
   *     the MLproject command template. Barrier = the value of a
   *     self._sanitize_param_dict(...) call in _project_spec.py.
   *
   * Label caveats (kept): the command template itself and the unquoted
   * extra-parameter fragments '--{key} {value}' (_project_spec.py:236) still
   * flow into bash -c unescaped, and host/port values in the R backend are
   * interpolated raw - those paths are intentionally NOT blocked here.
   *
   * Deliberate scope limitation (documented, not a label): quote() also runs
   * at mlflow/projects/kubernetes.py:57, which the reviewed label set does
   * not cover; that call site is therefore not a barrier - this can only add
   * findings (false positives), never hide a path.
   */
  predicate isBarrier(DataFlow::Node node, string passKey) {
    passKey = "command_injection" and
    (
      isQuoteCallBarrier(node)
      or
      isSanitizeParamDictBarrier(node)
    )
  }

  /** san-001: value of a string_utils.quote(...) call at the reviewed sites. */
  predicate isQuoteCallBarrier(DataFlow::Node node) {
    exists(Call c |
      calledNameOf(c) = "quote" and
      quoteBarrierFile(c.getLocation().getFile().getRelativePath()) and
      node = DataFlow::exprNode(c)
    )
  }

  private predicate quoteBarrierFile(string path) {
    path = "mlflow/projects/_project_spec.py" // san-001 sites :167/:172/:241
    or
    path = "mlflow/rfunc/backend.py"           // san-001 sites :41/:80/:119
    or
    path = "mlflow/projects/databricks.py"     // san-001 site  :361
  }

  /**
   * san-002: value of an EntryPoint._sanitize_param_dict(...) call (the
   * quote()-wrapped parameter dict returned to compute_command).
   */
  predicate isSanitizeParamDictBarrier(DataFlow::Node node) {
    exists(Call c |
      calledNameOf(c) = "_sanitize_param_dict" and
      c.getLocation().getFile().getRelativePath() = "mlflow/projects/_project_spec.py" and
      node = DataFlow::exprNode(c)
    )
  }

}
