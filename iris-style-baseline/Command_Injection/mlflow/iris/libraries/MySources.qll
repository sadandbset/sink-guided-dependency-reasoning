  /**
   * Parameter pinned by (file, line) and the label's 0-based argument index
   * (self is excluded from label indexes, so the declared position shifts by
   * one for bound methods).
   *
   * Note: Parameter has no getScope() in codeql/python-all 7.1.x (that
   * accessor exists on Function), so the enclosing function is recovered via
   * f.getArg(p.getPosition()) = p instead.
   */
  private predicate labeledParam(Parameter p, string path, int line, int labelIndex) {
    p.getLocation().getFile().getRelativePath() = path and
    p.getLocation().getStartLine() = line and
    exists(Function f |
      f.getArg(p.getPosition()) = p and
      (
        f.getArg(0).isSelf() and p.getPosition() = labelIndex + 1
        or
        not f.getArg(0).isSelf() and p.getPosition() = labelIndex
      )
    )
  }

  /** Syntactic name of the callee of a call ("<expr>" if neither Name nor Attribute). */
  private string calledNameOf(Call c) {
    result = c.getFunc().(Name).getId()
    or
    result = c.getFunc().(Attribute).getName()
    or
    not c.getFunc() instanceof Name and
    not c.getFunc() instanceof Attribute and
    result = "<expr>"
  }

  /**
   * Tier 1 (strict) - classification=tp labels only. This is the tier the
   * formal pass-2 query (queries/Pass2_CommandInjection.ql) dispatches to
   * via isSource(node, "command_injection").
   *
   * 248 labels rendered into 8 buckets; every rule pins the labeled
   * (file, line) pair (parameters additionally pin the label's 0-based
   * argument index, self-shifted for bound methods). Generic name/derivation
   * rules were rejected: the repository contains far more open()/loads()/
   * click definitions than the reviewed label set, so a name-based rule
   * would bind unreviewed sites.
   */
  predicate isSource(DataFlow::Node source, string passKey) {
    passKey = "command_injection" and isSourceStrict(source)
  }

  /** Formal tier: the 248 tp labels, 8 buckets. */
  predicate isSourceStrict(DataFlow::Node source) {
    isFileOpenSource(source)
    or
    isDecodeReturnSource(source)
    or
    isRequestFieldSource(source)
    or
    isRequestDecodeSource(source)
    or
    isModelMetadataSource(source)
    or
    isEnvReadSource(source)
    or
    isHandlerParamSource(source)
    or
    isCliParamSource(source)
  }

