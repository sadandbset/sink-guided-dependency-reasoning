run:
  queries:
   -
    pack: iris/ansible-cwe78#0
    relativeQueryPath: extraction/sources.ql
    relativeBqrsPath: iris/ansible-cwe78/extraction/sources.bqrs
    metadata:
      name: "Ansible source candidate extraction (Pass 2, CWE-78)"
      description: |-
        Extracts input-boundary API candidates for CWE-78 labeling from the
           Ansible codebase. Boundaries are derived from repository evidence:
           AnsibleModule parameters (stdin/argv -> params), task/playbook args,
           environment variables, CLI args, stdin, deserialized remote/external
           data, and remote-command wrapper return values.
           Columns: node, kind, api, module, receiver, flow_kind, arg_index,
           file, line, boundary.
      kind: problem
      id: py/augur/ansible/extract-sources
      problem.severity: recommendation
  extensionPacks: []
  packs:
    codeql/util#3:
      name: codeql/util
      version: 2.0.34
      isLibrary: true
      isExtensionPack: false
      localPath: file:///E:/codeql-codeql-cli-2.25.2/shared/util/
      localPackDefinitionFile: file:///E:/codeql-codeql-cli-2.25.2/shared/util/qlpack.yml
      runDataExtensions: []
    codeql/threat-models#2:
      name: codeql/threat-models
      version: 1.0.47
