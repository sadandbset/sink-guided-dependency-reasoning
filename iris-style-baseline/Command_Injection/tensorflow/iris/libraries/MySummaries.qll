private import python
private import semmle.python.dataflow.new.DataFlow

module MySummaries {
  /** Syntactic name of the callee of a call ("<expr>" if neither Name nor Attribute). */
  private string calledNameOf(Call c) {
    result = c.getFunc().(Name).getId()
    or
    result = c.getFunc().(Attribute).getName()
    or
    not c.getFunc() instanceof Name and
    not c.getFunc() instanceof Attribute and
    result = "<expr>"
  }

  /** Files holding the reviewed on_* handler implementations. */
  private predicate handlerImplFile(string path) {
    path = "tensorflow/python/debug/lib/grpc_debug_server.py"      // EventListenerBaseStreamHandler base class (:52/:68/:87)
    or
    path = "tensorflow/python/debug/lib/grpc_debug_test_server.py" // grpc test-server stream handler (:87/:113/:131)
  }

  /**
   * Additional taint steps for the 3 tp summary labels
   * (labels/labels.json src-0509/0510/0511). Each hop connects the argument
   * of a stream_handler.on_* dispatch call inside
   * EventListenerBaseServicer.SendEvents (grpc_debug_server.py:157/:168/:177)
   * to the corresponding parameter of the on_* handler implementations.
   * The dispatch goes through the dynamically constructed stream-handler
   * class (self._stream_handler_class()), so these cross-class edges are
   * NOT natively tracked and rely on the explicit steps.
   *
   * Only the payload parameters are connected (event / graph_def /
   * device_name); the numeric wall_time argument (fp label) is not.
   *
   * Recorded but NOT rendered (documented, no edge invented): the 14
   * internal_exec_wrapper functions (labels role=none) - their parameters
   * reach the directly-labeled exec call arguments through native local
   * data flow, so unconditional or wrapper-level edges would be
   * unjustified.
   */
  predicate isAdditionalTaintStep(
    DataFlow::Node nodeFrom, DataFlow::Node nodeTo, string passKey
  ) {
    passKey = "command_injection" and
    (
      valueEventDispatchStep(nodeFrom, nodeTo)
      or
      graphDefDispatchStep(nodeFrom, nodeTo)
      or
      coreMetadataDispatchStep(nodeFrom, nodeTo)
    )
  }

  /** src-0509: stream_handler.on_value_event(<event>) argument at
   * grpc_debug_server.py:157 -> on_value_event(self, event) parameter */
  private predicate valueEventDispatchStep(
    DataFlow::Node nodeFrom, DataFlow::Node nodeTo
  ) {
    exists(Call c |
      c.getLocation().getFile().getRelativePath() = "tensorflow/python/debug/lib/grpc_debug_server.py" and
      c.getLocation().getStartLine() = 157 and
      calledNameOf(c) = "on_value_event" and
      nodeFrom = DataFlow::exprNode(c.getPositionalArg(0))
    )
    and
    exists(Parameter p, Function f |
      f.getName() = "on_value_event" and
      handlerImplFile(f.getLocation().getFile().getRelativePath()) and
      f.getArg(1) = p and
      nodeTo = DataFlow::parameterNode(p)
    )
  }

  /** src-0510: stream_handler.on_graph_def(<graph_def>, <device_name>, ...)
   * arguments at grpc_debug_server.py:168 -> on_graph_def(self, graph_def,
   * device_name, wall_time) parameters 1 and 2 (wall_time not connected);
   * call argument idx maps to declared parameter idx+1 */
  private predicate graphDefDispatchStep(
    DataFlow::Node nodeFrom, DataFlow::Node nodeTo
  ) {
    exists(Call c, Parameter p, Function f, int idx |
      c.getLocation().getFile().getRelativePath() = "tensorflow/python/debug/lib/grpc_debug_server.py" and
      c.getLocation().getStartLine() = 168 and
      calledNameOf(c) = "on_graph_def" and
      idx in [0, 1] and
      nodeFrom = DataFlow::exprNode(c.getPositionalArg(idx)) and
      f.getName() = "on_graph_def" and
      handlerImplFile(f.getLocation().getFile().getRelativePath()) and
      f.getArg(idx + 1) = p and
      nodeTo = DataFlow::parameterNode(p)
    )
  }

  /** src-0511: stream_handler.on_core_metadata_event(<event>) argument at
   * grpc_debug_server.py:177 -> on_core_metadata_event(self, event) parameter */
  private predicate coreMetadataDispatchStep(
    DataFlow::Node nodeFrom, DataFlow::Node nodeTo
  ) {
    exists(Call c |
      c.getLocation().getFile().getRelativePath() = "tensorflow/python/debug/lib/grpc_debug_server.py" and
      c.getLocation().getStartLine() = 177 and
      calledNameOf(c) = "on_core_metadata_event" and
      nodeFrom = DataFlow::exprNode(c.getPositionalArg(0))
    )
    and
    exists(Parameter p, Function f |
      f.getName() = "on_core_metadata_event" and
      handlerImplFile(f.getLocation().getFile().getRelativePath()) and
      f.getArg(1) = p and
      nodeTo = DataFlow::parameterNode(p)
    )
  }

