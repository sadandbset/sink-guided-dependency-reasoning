  /** Syntactic name of the callee of a call ("<expr>" if neither Name nor Attribute). */
  private string calledNameOf(Call c) {
    result = c.getFunc().(Name).getId()
    or
    result = c.getFunc().(Attribute).getName()
    or
    not c.getFunc() instanceof Name and
    not c.getFunc() instanceof Attribute and
    result = "<expr>"
  }

  /**
   * Parameter pinned by (file, line) and the label's 0-based argument index.
   * This run's labels count self as index 0 (extraction columnContract), so
   * the declared position equals the label index directly.
   */
  private predicate labeledParam(Parameter p, string path, int line, int labelIndex) {
    p.getLocation().getFile().getRelativePath() = path and
    p.getLocation().getStartLine() = line and
    exists(Function f |
      f.getArg(p.getPosition()) = p and
      p.getPosition() = labelIndex
    )
  }

