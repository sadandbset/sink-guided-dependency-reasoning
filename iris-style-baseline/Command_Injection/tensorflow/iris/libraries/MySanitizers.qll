   *   - san-001 shlex.quote / _shlex_quote
   *     (tensorflow/python/tools/saved_model_aot_compile.py:63-67): the only
   *     shell-quoting helper in the tree (pipes.quote on py2, shlex.quote on
   *     py3). Barrier = the value of a quote(...) / _shlex_quote(...) call
   *     inside saved_model_aot_compile.py: it wraps every interpolated value
   *     of the XLA makefile command template (_XLA_MAKEFILE_TEMPLATE.format
   *     at :137-141: tensorflow_includes, compiled_dir) and output_prefix
   *     (:358) before the makefile/pywrap compile step.
   *
   * Deliberate scope limitation (documented, not a label): the barrier is
   * pinned to saved_model_aot_compile.py, the only file where the reviewed
   * evidence applies; quote-named calls elsewhere are not barriers - this
   * can only add findings (false positives), never hide a path.
   */
  predicate isBarrier(DataFlow::Node node, string passKey) {
    passKey = "command_injection" and isQuoteCallBarrier(node)
  }

  /** san-001: value of a quote()/_shlex_quote() call at the reviewed sites. */
  predicate isQuoteCallBarrier(DataFlow::Node node) {
    exists(Call c |
      (calledNameOf(c) = "quote" or calledNameOf(c) = "_shlex_quote") and
      c.getLocation().getFile().getRelativePath() = "tensorflow/python/tools/saved_model_aot_compile.py" and
      node = DataFlow::exprNode(c)
