private import python
private import semmle.python.dataflow.new.DataFlow

module MySanitizers {
  /** Syntactic name of the callee of a call ("<expr>" if neither Name nor Attribute). */
  private string calledNameOf(Call c) {
    result = c.getFunc().(Name).getId()
    or
    result = c.getFunc().(Attribute).getName()
    or
    not c.getFunc() instanceof Name and
    not c.getFunc() instanceof Attribute and
    result = "<expr>"
  }

  /**
   * One reviewed barrier label (labels/labels.json san-001):
