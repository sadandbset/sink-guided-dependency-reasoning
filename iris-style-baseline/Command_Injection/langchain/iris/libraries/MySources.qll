    path = "langchain/vectorstores/starrocks.py" and line = 460
    or
    path = "langchain/vectorstores/tair.py" and line = 136
  }

  /**
   * Candidate tier: input parameters of BaseTool subclass
   * _run/_arun/run/__call__ methods that receive agent-dispatched tool
   * input (labels src-r002..src-r470, conf 0.55-0.7). NOT dispatched to by
   * the formal query: tool params double as wrapper-sink parameters in six
   * cases (reconciliation rule "sink role wins"), and blanket-marking every
   * tool parameter would fabricate trivial source==sink paths.
   */
  predicate isToolEntryParamCandidate(DataFlow::Node source) {
    exists(
      Function f, Parameter p, string path, string cls, string meth, int argIndex |
      labeledToolEntryMethod(path, cls, meth, argIndex) and
      f.getName() = meth and
      f.getScope() instanceof Class and
      f.getScope().(Class).getName() = cls and
      f.getLocation().getFile().getRelativePath() = path and
      p = f.getArg(argIndex) and
      source = DataFlow::parameterNode(p)
    )
  }

