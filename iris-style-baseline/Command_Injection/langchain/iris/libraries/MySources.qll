  /** `json.loads(...)` in module-attribute or from-import form. */
  private predicate isJsonLoadsCall(Call c) {
    c.getFunc() instanceof Attribute and
    c.getFunc().(Attribute).getName() = "loads" and
    c.getFunc().(Attribute).getObject() instanceof Name and
    c.getFunc().(Attribute).getObject().(Name).getId() = "json"
    or
    c.getFunc() instanceof Name and
    c.getFunc().(Name).getId() = "loads"
  }

  /** `json.load(...)` in module-attribute or from-import form. */
  private predicate isJsonLoadCall(Call c) {
    c.getFunc() instanceof Attribute and
    c.getFunc().(Attribute).getName() = "load" and
    c.getFunc().(Attribute).getObject() instanceof Name and
    c.getFunc().(Attribute).getObject().(Name).getId() = "json"
    or
    c.getFunc() instanceof Name and
    c.getFunc().(Name).getId() = "load"
  }
