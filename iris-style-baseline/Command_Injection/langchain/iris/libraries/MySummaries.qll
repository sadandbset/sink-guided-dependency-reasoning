private import python
private import semmle.python.dataflow.new.DataFlow

module MySummaries {
  /**
   * The 5 label-reviewed cross-function propagation steps. Together they
   * model the agent -> tool -> shell dispatch chain:
   *
   *   AgentExecutor dispatch -> BaseTool.run (virtual-dispatch summary)
   *   -> ShellTool._run / PythonREPLTool._run / PythonAstREPLTool._run
   *   -> BashProcess.run -> BashProcess._run / _run_persistent
   *   -> subprocess.run(shell=True) / pexpect sendline / exec / eval.
   *
   * Steps:
   *   - src-r057: BaseTool.run(tool_input) -> subclass _run input param.
   *     run() dispatches through _parse_input + _to_args_and_kwargs +
   *     `self._run(*tool_args, **tool_kwargs)`, which native dataflow does
   *     not resolve for virtual dispatch; this step carries agent tool
   *     input into every BaseTool subclass implementation.
   *   - src-r058: BaseTool.__call__(tool_input) -> BaseTool.run(tool_input).
   *   - snk-r03:  BashProcess.run(commands) -> BashProcess._run(command)
   *     and BashProcess._run_persistent(command).
   *   - snk-r07:  BashProcess._run_persistent(command) ->
   *     self.process.sendline(command) argument.
   *   - snk-r13:  PythonREPL.run(command) -> exec(command, ...) argument.
   *
   * The last three hops are also covered by native local dataflow; they are
   * rendered anyway because the labels model them explicitly, and the
   * explicit steps guarantee the path even if `";".join(commands)` or
   * call-object indirection breaks native flow.
   *
   * PATCH (2026-10-15, report/miss_diagnosis.md) - pydantic Field boundary
   * hops, not natively tracked (see file header):
   *   - JiraAction._run `instructions` -> JiraAPIWrapper.run `query`.
   *   - PythonREPLTool._run `query` -> PythonREPL.run `command`.
   *   - ShellTool._run `commands` -> BashProcess.run `commands`.
   */
  predicate isAdditionalTaintStep(
    DataFlow::Node nodeFrom, DataFlow::Node nodeTo, string passKey
  ) {
    passKey = "command_injection" and
    (
      baseToolRunToSubclassRunStep(nodeFrom, nodeTo)
      or
      baseToolDunderCallToRunStep(nodeFrom, nodeTo)
      or
      bashProcessRunToInternalStep(nodeFrom, nodeTo)
      or
      bashRunPersistentToSendlineStep(nodeFrom, nodeTo)
      or
      pythonReplRunToExecStep(nodeFrom, nodeTo)
      or
      jiraActionRunToApiWrapperRunStep(nodeFrom, nodeTo)
      or
      pythonReplToolRunToReplRunStep(nodeFrom, nodeTo)
      or
      shellToolRunToBashProcessRunStep(nodeFrom, nodeTo)
    )
  }

  /** src-r057: BaseTool.run `tool_input` -> subclass _run input param. */
  private predicate baseToolRunToSubclassRunStep(
    DataFlow::Node nodeFrom, DataFlow::Node nodeTo
  ) {
    exists(
      Function run, Parameter runInput, Function sub, Parameter subInput |
      run.getName() = "run" and
      run.getScope() instanceof Class and
      run.getScope().(Class).getName() = "BaseTool" and
      run.getLocation().getFile().getRelativePath() = "langchain/tools/base.py" and
      runInput = run.getArg(1) and
      sub.getName() = "_run" and
      sub.getScope() instanceof Class and
      classHasBaseNamed(sub.getScope().(Class), "BaseTool") and
      subInput = sub.getArg(1) and
      not subInput.getName() = "run_manager" and
      nodeFrom = DataFlow::parameterNode(runInput) and
      nodeTo = DataFlow::parameterNode(subInput)
    )
  }

  /** src-r058: BaseTool.__call__ `tool_input` -> BaseTool.run `tool_input`. */
  private predicate baseToolDunderCallToRunStep(
    DataFlow::Node nodeFrom, DataFlow::Node nodeTo
  ) {
    exists(
      Function dunder, Parameter callInput, Function run, Parameter runInput |
      dunder.getName() = "__call__" and
      dunder.getScope() instanceof Class and
      dunder.getScope().(Class).getName() = "BaseTool" and
      dunder.getLocation().getFile().getRelativePath() = "langchain/tools/base.py" and
      callInput = dunder.getArg(1) and
      run.getName() = "run" and
      run.getScope() instanceof Class and
      run.getScope().(Class).getName() = "BaseTool" and
      run.getLocation().getFile().getRelativePath() = "langchain/tools/base.py" and
      runInput = run.getArg(1) and
      nodeFrom = DataFlow::parameterNode(callInput) and
      nodeTo = DataFlow::parameterNode(runInput)
    )
  }

  /**
   * snk-r03: BashProcess.run `commands` -> BashProcess._run `command` /
   * BashProcess._run_persistent `command`.
   */
  private predicate bashProcessRunToInternalStep(
    DataFlow::Node nodeFrom, DataFlow::Node nodeTo
  ) {
    exists(
      Function run, Parameter runInput, Function inner, Parameter innerInput |
      run.getName() = "run" and
      run.getScope() instanceof Class and
      run.getScope().(Class).getName() = "BashProcess" and
      run.getLocation().getFile().getRelativePath() = "langchain/utilities/bash.py" and
      runInput = run.getArg(1) and
      inner.getName() in ["_run", "_run_persistent"] and
      inner.getScope() instanceof Class and
      inner.getScope().(Class).getName() = "BashProcess" and
      inner.getLocation().getFile().getRelativePath() = "langchain/utilities/bash.py" and
      innerInput = inner.getArg(1) and
      nodeFrom = DataFlow::parameterNode(runInput) and
      nodeTo = DataFlow::parameterNode(innerInput)
    )
  }

  /**
   * snk-r07: BashProcess._run_persistent `command` -> the sendline(command)
   * argument (the snk-r08 sink node).
   */
  private predicate bashRunPersistentToSendlineStep(
    DataFlow::Node nodeFrom, DataFlow::Node nodeTo
  ) {
    exists(
      Function f, Parameter p, Call c |
      f.getName() = "_run_persistent" and
      f.getScope() instanceof Class and
      f.getScope().(Class).getName() = "BashProcess" and
      f.getLocation().getFile().getRelativePath() = "langchain/utilities/bash.py" and
      p = f.getArg(1) and
      c.getFunc() instanceof Attribute and
      c.getFunc().(Attribute).getName() = "sendline" and
      c.getLocation().getFile().getRelativePath() = "langchain/utilities/bash.py" and
      c.getPositionalArg(0) instanceof Name and
      nodeFrom = DataFlow::parameterNode(p) and
      nodeTo = DataFlow::exprNode(c.getPositionalArg(0))
    )
  }

  /** snk-r13: PythonREPL.run `command` -> the exec(command) argument. */
  private predicate pythonReplRunToExecStep(
    DataFlow::Node nodeFrom, DataFlow::Node nodeTo
  ) {
    exists(
      Function f, Parameter p, Call c |
      f.getName() = "run" and
      f.getScope() instanceof Class and
      f.getScope().(Class).getName() = "PythonREPL" and
      f.getLocation().getFile().getRelativePath() = "langchain/utilities/python.py" and
      p = f.getArg(1) and
      c.getFunc() instanceof Name and
      c.getFunc().(Name).getId() = "exec" and
      c.getLocation().getFile().getRelativePath() = "langchain/utilities/python.py" and
      nodeFrom = DataFlow::parameterNode(p) and
      nodeTo = DataFlow::exprNode(c.getPositionalArg(0))
    )
  }

  /**
   * PATCH (2026-10-15): JiraAction._run `instructions` ->
   * JiraAPIWrapper.run `query`.
   *
   * The call `self.api_wrapper.run(self.mode, instructions)`
   * (tools/jira/tool.py:55) goes through the pydantic Field attribute
   * `api_wrapper: JiraAPIWrapper = Field(default_factory=JiraAPIWrapper)`,
   * whose type CodeQL cannot infer, so the call edge is never bound to
   * JiraAPIWrapper.run and taint stops at the call argument. Everything
   * downstream (run -> self.other(query) -> exec(f"result = {query}") at
   * utilities/jira.py:192, sink snk-r11 / CVE-2023-34540) is natively
   * tracked once this hop exists. Verified by work/DiagJiraChain3.ql.
   */
  private predicate jiraActionRunToApiWrapperRunStep(
    DataFlow::Node nodeFrom, DataFlow::Node nodeTo
  ) {
    exists(
      Function toolRun, Parameter toolInput, Function wrapRun, Parameter wrapInput |
      toolRun.getName() = "_run" and
      toolRun.getScope() instanceof Class and
      toolRun.getScope().(Class).getName() = "JiraAction" and
      toolRun.getLocation().getFile().getRelativePath() =
        "langchain/tools/jira/tool.py" and
      toolInput = toolRun.getArg(1) and
      wrapRun.getName() = "run" and
      wrapRun.getScope() instanceof Class and
      wrapRun.getScope().(Class).getName() = "JiraAPIWrapper" and
      wrapRun.getLocation().getFile().getRelativePath() =
        "langchain/utilities/jira.py" and
      wrapInput = wrapRun.getArg(2) and
      nodeFrom = DataFlow::parameterNode(toolInput) and
      nodeTo = DataFlow::parameterNode(wrapInput)
    )
  }

  /**
