/**
 * @name AutoGluon Pass 2: Command/Argument Injection (CWE-078)
 * @description Tracks candidate external input (environment variables) to the shell-enabled subprocess.check_output command in autogluon.core.utils.sync_remote. Sources are Phase 1 label candidates, not confirmed attacker-controlled input; any finding is a review candidate, not a confirmed vulnerability. Generated by Augur from labels run autogluon-pass2-phase1-20261012. v2 (post-triage remediation): additionally tracks the file-content source (open() of best_k_models.yaml, predictor.py:1123, label p2-supp-004) into the unsafe YAML deserialization sink (yaml.load with Loader=yaml.Loader, predictor.py:1124 in _top_k_average, label p2-sink-013) - the project's actual code-execution boundary (CWE-502-class arbitrary Python object construction, the mechanism recorded as CWE-78 impact for fix commit 23a37e7). Line anchors use CodeQL-DB-version lines (DB created at vulnerable parent sha 1a62b445).
 * @id py/augur/autogluon/pass2-command-injection
 * @kind path-problem
 * @problem.severity error
 * @precision low
 * @tags security
 *       external/cwe/cwe-078
 */

import python
import semmle.python.dataflow.new.DataFlow
import semmle.python.dataflow.new.TaintTracking

import libraries.MySources
import libraries.MySinks
import libraries.MySanitizers
import libraries.MySummaries

module Pass2Config implements DataFlow::ConfigSig {
  predicate isSource(DataFlow::Node source) {
    MySources::isSource(source, "command_injection")
  }

  predicate isSink(DataFlow::Node sink) {
    MySinks::isSink(sink, "command_injection")
  }

  predicate isBarrier(DataFlow::Node node) {
    MySanitizers::isBarrier(node, "command_injection")
  }

  predicate isAdditionalFlowStep(
    DataFlow::Node nodeFrom,
    DataFlow::Node nodeTo
  ) {
    MySummaries::isAdditionalTaintStep(
      nodeFrom, nodeTo, "command_injection"
    )
  }
}

module Pass2Flow = TaintTracking::Global<Pass2Config>;
import Pass2Flow::PathGraph

from Pass2Flow::PathNode source, Pass2Flow::PathNode sink
where Pass2Flow::flowPath(source, sink)
select sink.getNode(), source, sink,
  "Externally influenced data reaches a command-execution or unsafe-deserialization boundary (CWE-78 candidate): " +
  "either the shell-enabled subprocess.check_output in autogluon.core.utils.sync_remote, or (v2 remediation) " +
  "the unsafe YAML deserialization yaml.load(f, Loader=yaml.Loader) in multimodal predictor _top_k_average " +
  "(best_k_models.yaml; CWE-502-class arbitrary Python object construction -> code execution). " +
  "Sources are label candidates; review before treating as a vulnerability."
