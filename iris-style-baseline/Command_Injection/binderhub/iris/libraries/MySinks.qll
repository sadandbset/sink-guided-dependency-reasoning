/**
 * Machine-generated by Augur Phase 2 Step 4 from iris/labels/labels.json
 * (run binderhub-iris-pass2-step3-20261014, Pass 2 / CWE-077/078/088).
 *
 * Sink model for pass key "command_injection".
 *
 * All 5 sink-labeled entries are modeled:
 *   - snk-010: subprocess.run(command, ...) argument 0 - `git ls-remote
 *     <repo> <ref>` with spec-derived arguments (repoproviders.py:487-488).
 *   - snk-004: V1Container(args=...) - the repo2docker container argv
 *     (build.py:338-350).
 *   - snk-002: V1EnvVar(value=...) - env injection into the build pod
 *     (build.py:323-325); expected to stay cold in the formal query because
 *     git_credentials is server-side config (see query_generation_notes.md).
 *   - snk-005: CoreV1Api.create_namespaced_pod(namespace, body, ...) argument
 *     1 - pod submission embedding the command argv (build.py:375-380).
 *   - snk-003: Build.get_cmd() call result - the full repo2docker command
 *     list (build.py:146-171, consumed at :343).
 *
 * Keyword-position sinks from sinks.csv (arg_index -1) are matched on the
 * keyword name (Keyword.getArg()), which is how the CSV encodes them
 * ("V1Container.args", "V1EnvVar.value").
 */

import python
import semmle.python.dataflow.new.DataFlow

module MySinks {
  /** Restricts modeling to BinderHub production code (excludes tests/versioneer). */
  private predicate inBinderHubScope(AstNode n) {
    exists(string path |
      path = n.getLocation().getFile().getRelativePath() and
      path.matches("binderhub/%") and
      not path.matches("%/tests/%") and
      not path.matches("%_version.py")
    )
  }

  /**
   * Holds if `sink` is a sink node for the given pass key.
   */
  predicate isSink(DataFlow::Node sink, string passKey) {
    passKey = "command_injection" and
    (
      subprocessRunCommand(sink)
      or
      containerArgsKeyword(sink)
      or
      envVarValueKeyword(sink)
      or
      createNamespacedPodBody(sink)
      or
      getCmdResult(sink)
    )
  }

  /**
   * subprocess.run(command, ...) with the command list at positional argument 0
   * (repoproviders.py:488: `git ls-remote` with self.repo/self.unresolved_ref).
   */
  private predicate subprocessRunCommand(DataFlow::Node sink) {
    exists(Call c, Attribute func |
      func = c.getFunc().(Attribute) and
      func.getName() = "run" and
      func.getObject().(Name).getId() = "subprocess" and
      sink = DataFlow::exprNode(c.getArg(0)) and
      inBinderHubScope(c)
    )
  }

  /**
   * V1Container(args=...): the argv executed by the build pod. The keyword value
   * is the command list built by Build.get_cmd() (build.py:343).
   */
  private predicate containerArgsKeyword(DataFlow::Node sink) {
    exists(Call c, Keyword kw |
      kw = c.getAKeyword() and
      kw.getArg() = "args" and
      c.getFunc().(Attribute).getName() = "V1Container" and
      sink = DataFlow::exprNode(kw.getValue()) and
      inBinderHubScope(c)
    )
  }

  /**
   * V1EnvVar(value=...): environment-variable injection into the build pod
   * execution environment (GIT_CREDENTIAL_ENV, build.py:325).
   */
  private predicate envVarValueKeyword(DataFlow::Node sink) {
    exists(Call c, Keyword kw |
      kw = c.getAKeyword() and
      kw.getArg() = "value" and
      c.getFunc().(Attribute).getName() = "V1EnvVar" and
      sink = DataFlow::exprNode(kw.getValue()) and
      inBinderHubScope(c)
    )
  }

  /**
   * CoreV1Api.create_namespaced_pod(namespace, body, ...) with the pod spec at
   * positional argument 1; the body embeds the container argv and env
   * (build.py:376-380).
   */
  private predicate createNamespacedPodBody(DataFlow::Node sink) {
    exists(Call c |
      c.getFunc().(Attribute).getName() = "create_namespaced_pod" and
      sink = DataFlow::exprNode(c.getArg(1)) and
      inBinderHubScope(c)
    )
  }

  /**
   * Result of Build.get_cmd() calls: the wrapper returns the complete
   * repo2docker command list built from self.ref/self.repo_url/self.appendix/
   * self.image_name (build.py:146-171).
   */
  private predicate getCmdResult(DataFlow::Node sink) {
    exists(Call c |
      c.getFunc().(Attribute).getName() = "get_cmd" and
      sink = DataFlow::exprNode(c) and
      inBinderHubScope(c)
    )
  }
}
