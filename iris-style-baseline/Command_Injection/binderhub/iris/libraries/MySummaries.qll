/**
 * Machine-generated by Augur Phase 2 Step 4 from iris/labels/labels.json
 * (run binderhub-iris-pass2-step3-20261014, Pass 2 / CWE-077/078/088).
 *
 * Additional taint-step model for pass key "command_injection".
 *
 * Every step is conditional (no unconditional propagation) and grounded in
 * code evidence. Steps 1-3 map directly to summary-role labels:
 *   1. providerConstructionStep   <- src-019, src-040 (get_provider returns
 *      a provider constructed from the attacker spec; the spec->self.spec
 *      assignment happens inside traitlets config plumbing, which is library
 *      code not present in the database, so the edge is modeled here).
 *   2. specDerivedAttributeStep   <- the 22 provider-accessor summary labels
 *      (src-020..027, src-049..060, src-064/065, src-069/071/072/074): a
 *      tainted provider (or Build) object propagates to reads of its
 *      spec-derived attributes (repo, unresolved_ref, ref, repo_url, ...).
 *   3. executorDispatchStep       <- snk-006 (build_pool.submit(build.submit)
 *      carries the tainted Build object into the worker-thread invocation;
 *      concurrent.futures semantics: the bound method is called with the
 *      object as `self`).
 *
 * Steps 4-5 are model refinements derived from reading the real sources
 * (documented in report/query_generation_notes.md), required for the
 * snk-003/snk-004/snk-005 reachability that the labels assert:
 *   4. buildConstructionStep      <- BuildClass(repo_url=..., ref=...,
 *      appendix=..., image_name=..., git_credentials=...) passes tainted
 *      values into the Build object (build.py:404-422; Build.__init__ stores
 *      them as attributes read by get_cmd/submit). The callee is fetched
 *      from a settings dict (`self.settings.get('build_class')`), so default
 *      call resolution cannot connect the keyword arguments to the
 *      constructor.
 *   5. kubeModelStep              <- kubernetes.client model constructors
 *      (V1Container/V1Pod/V1PodSpec/V1EnvVar/V1ObjectMeta) are plain DTOs
 *      that store keyword arguments as attributes (library code not in the
 *      database). Needed for taint to reach the pod body at
 *      create_namespaced_pod (snk-005).
 */

import python
import semmle.python.dataflow.new.DataFlow

module MySummaries {
  /** Restricts modeling to BinderHub production code (excludes tests/versioneer). */
  private predicate inBinderHubScope(AstNode n) {
    exists(string path |
      path = n.getLocation().getFile().getRelativePath() and
      path.matches("binderhub/%") and
      not path.matches("%/tests/%") and
      not path.matches("%_version.py")
    )
  }

  /**
   * Holds if taint may additionally flow from `nodeFrom` to `nodeTo` for the
   * given pass key.
   */
  predicate isAdditionalTaintStep(DataFlow::Node nodeFrom, DataFlow::Node nodeTo, string passKey) {
    passKey = "command_injection" and
    (
      providerConstructionStep(nodeFrom, nodeTo)
      or
      specDerivedAttributeStep(nodeFrom, nodeTo)
      or
      buildConstructionStep(nodeFrom, nodeTo)
      or
      executorDispatchStep(nodeFrom, nodeTo)
      or
      kubeModelStep(nodeFrom, nodeTo)
    )
  }

  /**
   * BaseHandler.get_provider(provider_prefix, spec=...) constructs the provider
   * object from the attacker-controlled spec (base.py:159-166:
   * `providers[provider_prefix](config=..., spec=spec)`). The spec becomes the
   * provider's `spec` trait via traitlets, whose plumbing is invisible to the
   * dataflow analysis, so the spec value -> returned provider edge is modeled.
   */
  private predicate providerConstructionStep(DataFlow::Node nodeFrom, DataFlow::Node nodeTo) {
    exists(Call c |
      c.getFunc().(Attribute).getName() = "get_provider" and
      nodeTo = DataFlow::exprNode(c) and
      inBinderHubScope(c) and
      (
        // positional spec argument (get_provider's third parameter)
        nodeFrom = DataFlow::exprNode(c.getArg(2))
        or
        // keyword `spec=...`
        exists(Keyword kw |
          kw = c.getAKeyword() and
          kw.getArg() = "spec" and
          nodeFrom = DataFlow::exprNode(kw.getValue())
        )
      )
    )
  }

  /**
   * Reads of spec-derived / command-construction attributes on a tainted
   * object are tainted. The provider field names model the traitlets boundary
   * (spec kwarg -> self.spec and the provider __init__ derivations:
   * self.repo/self.unresolved_ref in GitRepoProvider,
   * self.namespace in GitLabRepoProvider, self.user/self.repo in
   * GitHubRepoProvider, self.gist_id in GistRepoProvider, etc.). The Build
   * field names model build.py's attribute stores in __init__ being read in
   * get_cmd()/submit() (self.ref, self.repo_url, self.appendix,
   * self.image_name, self.git_credentials).
   */
  private predicate specDerivedAttributeStep(DataFlow::Node nodeFrom, DataFlow::Node nodeTo) {
    exists(Attribute attr |
      attr.getName() in [
        // RepoProvider spec-derived fields
        "spec", "url", "repo", "unresolved_ref", "quoted_namespace", "namespace",
        "user", "gist_id", "record_id", "resource_id", "identifier",
        "resolved_ref", "resolved_spec", "resolved_ref_url",
        // Build command-construction fields
        "ref", "repo_url", "image_name", "appendix", "git_credentials"
      ] and
      nodeFrom = DataFlow::exprNode(attr.getObject()) and
      nodeTo = DataFlow::exprNode(attr) and
      inBinderHubScope(attr)
    )
  }

  /**
   * Construction of the Build object from tainted command-construction keyword
   * arguments (builder.py:404-422: BuildClass(q=..., repo_url=repo_url,
   * ref=ref, image_name=image_name, appendix=appendix,
   * git_credentials=provider.git_credentials, ...)). Build.__init__
   * (build.py:40-142) stores these parameters as attributes consumed by
   * get_cmd()/submit(); the callee is resolved through a settings dict, so the
   * argument -> object edge is modeled.
   */
  private predicate buildConstructionStep(DataFlow::Node nodeFrom, DataFlow::Node nodeTo) {
    exists(Call c, Keyword kw |
      kw = c.getAKeyword() and
      kw.getArg() in ["repo_url", "ref", "appendix", "image_name", "git_credentials"] and
      nodeTo = DataFlow::exprNode(c) and
      nodeFrom = DataFlow::exprNode(kw.getValue()) and
      inBinderHubScope(c)
    )
  }

  /**
   * build_pool.submit(build.submit) schedules Build.submit for execution on a
   * worker thread; the executor invokes the bound method with `build` as the
   * `self` parameter (builder.py:424-430). The dispatch through
   * concurrent.futures is library code not in the database, so the
   * object -> self-parameter edge for Build.submit is modeled.
   */
  private predicate executorDispatchStep(DataFlow::Node nodeFrom, DataFlow::Node nodeTo) {
    exists(Call submitCall, Attribute boundMethod, Class buildClass, Function submitFn, Parameter selfParam |
      submitCall.getFunc().(Attribute).getName() = "submit" and
      boundMethod = submitCall.getArg(0).(Attribute) and
      boundMethod.getName() = "submit" and
      nodeFrom = DataFlow::exprNode(boundMethod.getObject()) and
      buildClass.getName() = "Build" and
      submitFn = buildClass.getMethod("submit") and
      selfParam = submitFn.getArg(0) and
      nodeTo = DataFlow::parameterNode(selfParam) and
      inBinderHubScope(submitCall)
    )
  }

  /**
   * kubernetes.client model constructors are attribute-holder DTOs: keyword
   * values become attributes of the constructed object (library code not in
   * the database). Taint on a keyword value propagates to the constructed
   * model object, which is how tainted V1Container(args=...) reaches the pod
   * body submitted via create_namespaced_pod (snk-005).
   */
  private predicate kubeModelStep(DataFlow::Node nodeFrom, DataFlow::Node nodeTo) {
    exists(Call c, Keyword kw |
      c.getFunc().(Attribute).getName() in ["V1Container", "V1Pod", "V1PodSpec", "V1EnvVar", "V1ObjectMeta"] and
      kw = c.getAKeyword() and
      nodeFrom = DataFlow::exprNode(kw.getValue()) and
      nodeTo = DataFlow::exprNode(c) and
      inBinderHubScope(c)
    )
  }
}
