/**
 * @name BinderHub command/argument injection (Pass 2, CWE-78)
 * @description Flows of request-controlled data (raw repo spec from the URL path, provider prefixes, query arguments, request headers and external provider API responses) into command execution surfaces: the `git ls-remote` subprocess arguments, the repo2docker container argv, build-pod environment variables and the build pod submission. Generated by Augur Phase 2 Step 5 from the reviewed Pass 2 labels (CWE-78 argument injection family; list-form invocations, no shell).
 * @id py/augur/binderhub/pass2-command-injection
 * @kind path-problem
 * @problem.severity error
 * @precision medium
 * @tags security
 *       external/cwe/cwe-078
 *       external/cwe/cwe-077
 *       external/cwe/cwe-088
 */

import python
import semmle.python.dataflow.new.DataFlow
import semmle.python.dataflow.new.TaintTracking

import libraries.MySources
import libraries.MySinks
import libraries.MySanitizers
import libraries.MySummaries

module Pass2Config implements DataFlow::ConfigSig {
  predicate isSource(DataFlow::Node source) {
    MySources::isSource(source, "command_injection")
  }

  predicate isSink(DataFlow::Node sink) {
    MySinks::isSink(sink, "command_injection")
  }

  predicate isBarrier(DataFlow::Node node) {
    MySanitizers::isBarrier(node, "command_injection")
  }

  predicate isAdditionalFlowStep(DataFlow::Node nodeFrom, DataFlow::Node nodeTo) {
    MySummaries::isAdditionalTaintStep(nodeFrom, nodeTo, "command_injection")
  }
}

module Pass2Flow = TaintTracking::Global<Pass2Config>;
import Pass2Flow::PathGraph

from Pass2Flow::PathNode source, Pass2Flow::PathNode sink
where Pass2Flow::flowPath(source, sink)
select sink.getNode(), source, sink,
  "User-controlled request data flows into a command execution sink (CWE-78: command/argument injection). The tainted value is passed as a command or argument element, not necessarily through a shell."
