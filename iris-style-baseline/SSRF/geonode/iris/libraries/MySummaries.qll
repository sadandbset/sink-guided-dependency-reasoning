/**
 * Machine-generated by Augur (Phase 2, Step 4) for GeoNode — Pass 3 (CWE-918 SSRF).
 * Rendered deterministically from the reviewed labels in iris/labels/labels.json
 * (pass_id 3; entries with role=summary, plus the propagation glue documented in the
 * Phase 1 label rationales).
 *
 * Every edge below is conditioned on concrete functions/parameters in the GeoNode
 * source; there is no unconditional taint propagation. Each edge exists because the
 * standard data flow library cannot cross the corresponding construct:
 *   - dict-registry / classmethod dynamic dispatch (M1, M5),
 *   - cross-method object-field flow through unresolved constructors (M2, M4b, M4c),
 *   - Django model attribute persistence between functions (M3, M6),
 *   - DRF serializer round-trip (M4a),
 *   - URL normalization through unmodeled libraries (M0, M7).
 *
 * Summary-labeled entries NOT needing an additional edge (standard interprocedural
 * data flow covers them): P3-S-0159 (is_monochromatic_image image_url -> http_client.get),
 * P3-S-0137/P3-S-0138 (get_map/getmap -> openURL), P3-S-0030 (download_resource_file
 * url -> requests.get).
 */

import python
import semmle.python.dataflow.new.DataFlow

module MySummaries {
  // ---------- shared helpers ----------

  /** Holds if `n` is located in the file with this repo-relative path. */
  private predicate inFile(AstNode n, string relPath) {
    n.getLocation().getFile().getRelativePath() = relPath
  }

  /** Holds if `n` is located in a file matching this repo-relative glob. */
  bindingset[relPathGlob]
  private predicate inFileMatches(AstNode n, string relPathGlob) {
    n.getLocation().getFile().getRelativePath().matches(relPathGlob)
  }

  // ---------- pass 3 additional taint steps (pass key: "ssrf") ----------

  /**
   * M0 (P3-S-0300, summary label; realizes the flow described by P3-S-0302/P3-S-0303):
   * geonode/proxy/views.py proxy() forwards its `url` parameter and request.GET["url"]
   * (:97 `raw_url = url or request.GET["url"]`) to the outbound fetch at :194
   * (http_client.request(_url, ...)). The intermediate steps (:98-:192) are URL
   * normalization via urllib.parse and hyperlink (URL.from_text().normalize().to_text()),
   * none of which is modeled by the standard library, so the business-function summary
   * is established instead.
   */
  private predicate proxyUrlToOutboundRequest(DataFlow::Node nodeFrom, DataFlow::Node nodeTo) {
    exists(Call fetchCall, Function proxyView |
      proxyView.getName() = "proxy" and
      inFile(proxyView, "geonode/proxy/views.py") and
      fetchCall.getFunc().(Attribute).getName() = "request" and
      fetchCall.getFunc().(Attribute).getObject().(Name).getId() = "http_client" and
      inFile(fetchCall, "geonode/proxy/views.py") and
      nodeTo = DataFlow::exprNode(fetchCall.getPositionalArg(0)) and
      (
        nodeFrom = DataFlow::parameterNode(proxyView.getArg(1))
        or
        exists(Subscript s |
          inFile(s, "geonode/proxy/views.py") and
          s.getObject().(Attribute).getName() = "GET" and
          s.getObject().(Attribute).getObject().(Name).getId() = "request" and
          nodeFrom = DataFlow::exprNode(s)
        )
      )
    )
  }

  /**
   * M1 (P3-S-0001): get_service_handler dispatches to the concrete handler constructor
   * through a type->class registry (geonode/services/serviceprocessors/__init__.py:64-68:
   * `handler = handlers.get(service_type, {}).get("handler"); service = handler(base_url,
   * service_id)`). The dict-based dynamic dispatch is not resolvable, so the factory's
   * `base_url` parameter (arg 0) is connected to the `url` parameter (arg 1) of every
   * handler __init__ under geonode/services/serviceprocessors/.
   */
  private predicate serviceHandlerFactoryDispatch(DataFlow::Node nodeFrom, DataFlow::Node nodeTo) {
    exists(Function factory, Function init |
      factory.getName() = "get_service_handler" and
      inFile(factory, "geonode/services/serviceprocessors/__init__.py") and
      nodeFrom = DataFlow::parameterNode(factory.getArg(0)) and
      init.getName() = "__init__" and
      inFileMatches(init, "geonode/services/serviceprocessors/%") and
      nodeTo = DataFlow::parameterNode(init.getArg(1))
    )
  }

  /**
   * M2 (P3-S-0031, P3-S-0016, P3-S-0017, P3-S-0412, P3-S-0413): ServiceHandlerBase.__init__
   * stores the URL (`self.url = url`, base.py:69-70); the loads of `self.url` in the handler
   * methods (probe() at base.py:81, wms.py:63/95/271/282) feed the actual fetches.
   * Cross-method field flow through the unresolved registry dispatch needs this edge.
   */
  private predicate handlerInitUrlToSelfUrl(DataFlow::Node nodeFrom, DataFlow::Node nodeTo) {
    exists(Function init, Attribute load |
      init.getName() = "__init__" and
      inFileMatches(init, "geonode/services/serviceprocessors/%") and
      nodeFrom = DataFlow::parameterNode(init.getArg(1)) and
      load.getName() = "url" and
      load.getObject().(Name).getId() = "self" and
      inFileMatches(load, "geonode/services/serviceprocessors/%") and
      nodeTo = DataFlow::exprNode(load)
    )
  }

  /**
   * M3 (write side: P3-S-0266/P3-S-0267/P3-S-0268; load side: P3-S-0098):
   * set_thumbnail persists the user-supplied URL (`resource.thumbnail_url = file_data`,
   * geonode/base/api/views.py:1367); the loads of `instance.thumbnail_url` that feed
   * is_monochromatic_image (geonode/geoserver/signals.py:143, geonode/geoserver/helpers.py:2160)
   * read it back. Django model attribute persistence between functions needs this edge.
   */
  private predicate thumbnailUrlPersistence(DataFlow::Node nodeFrom, DataFlow::Node nodeTo) {
    exists(AssignStmt store, Attribute load |
      store.getATarget().(Attribute).getName() = "thumbnail_url" and
      inFile(store, "geonode/base/api/views.py") and
      nodeFrom = DataFlow::exprNode(store.getValue()) and
      load.getName() = "thumbnail_url" and
      load.getObject().(Name).getId() = "instance" and
      (
        inFile(load, "geonode/geoserver/signals.py") or
        inFile(load, "geonode/geoserver/helpers.py")
      ) and
      nodeTo = DataFlow::exprNode(load)
    )
  }

  /**
   * M4a (P3-S-0351/P3-S-0352 -> P3-K-0019): the DRF dataset metadata/replace/append actions
   * round-trip request.data through the serializer (layers/api/views.py:128
   * `serializer = self.serializer_class(data=request.data)`, :132 `data = serializer.data.copy()`)
   * before handing it to StorageManager(remote_files=data) (:135, :276). The serializer
   * machinery is Django REST Framework code outside the database, so the request.data read
   * is connected to the `remote_files` keyword value of the StorageManager calls.
   */
  private predicate requestDataToStorageManager(DataFlow::Node nodeFrom, DataFlow::Node nodeTo) {
    exists(Attribute reqData, Call c, Keyword k |
      reqData.getName() = "data" and
      reqData.getObject().(Name).getId() = "request" and
      inFile(reqData, "geonode/layers/api/views.py") and
      nodeFrom = DataFlow::exprNode(reqData) and
      c.getFunc().(Name).getId() = "StorageManager" and
      inFile(c, "geonode/layers/api/views.py") and
      k = c.getANamedArg().(Keyword) and
      k.getArg() = "remote_files" and
      nodeTo = DataFlow::exprNode(k.getValue())
    )
  }

  /**
   * M4b (P3-K-0019 chain): DataItemRetriever.__init__ stores the file URI
   * (`self._original_file_uri = _file`, geonode/storage/data_retriever.py:55); the load at
   * :115-117 (`smart_open.open(uri=self._original_file_uri, mode="rb")`) performs the fetch.
   * Cross-method field flow needs this edge.
   */
  private predicate retrieverFileParamToOriginalUri(DataFlow::Node nodeFrom, DataFlow::Node nodeTo) {
    exists(Function init, Attribute load |
      init.getName() = "__init__" and
      inFile(init, "geonode/storage/data_retriever.py") and
      init.getEnclosingScope().(Class).getName() = "DataItemRetriever" and
      nodeFrom = DataFlow::parameterNode(init.getArg(1)) and
      load.getName() = "_original_file_uri" and
      load.getObject().(Name).getId() = "self" and
      inFile(load, "geonode/storage/data_retriever.py") and
      nodeTo = DataFlow::exprNode(load)
    )
  }

  /**
   * M4c (P3-K-0019 chain): StorageManager.__init__ passes its `remote_files` mapping to
   * DataRetriever, which builds one DataItemRetriever per value
   * (geonode/storage/manager.py:129, geonode/storage/data_retriever.py:150). The dict-
   * comprehension indirection is condensed into this edge from the StorageManager
   * `remote_files` parameter (arg 1) to the DataItemRetriever `_file` parameter (arg 1).
   */
  private predicate storageManagerParamToItemRetriever(DataFlow::Node nodeFrom, DataFlow::Node nodeTo) {
    exists(Function smInit, Function itemInit |
      smInit.getName() = "__init__" and
      inFile(smInit, "geonode/storage/manager.py") and
      smInit.getEnclosingScope().(Class).getName() = "StorageManager" and
      nodeFrom = DataFlow::parameterNode(smInit.getArg(1)) and
      itemInit.getName() = "__init__" and
      inFile(itemInit, "geonode/storage/data_retriever.py") and
      itemInit.getEnclosingScope().(Class).getName() = "DataItemRetriever" and
      nodeTo = DataFlow::parameterNode(itemInit.getArg(1))
    )
  }

  /**
   * M5 (P3-S-0029, P3-S-0015): the harvester workers are constructed from the Django
   * record via classmethods (`cls(record.remote_url, record.id, ...)`,
   * geonode/harvesting/harvesters/wms.py:129-133 and the other from_django_record
   * factories); BaseHarvesterWorker.__init__ stores it as self.remote_url
   * (harvesters/base.py:79-80). The classmethod dispatch is not resolvable, so the
   * `record.remote_url` loads are connected directly to the `self.remote_url` loads
   * that build the fetch URLs in the worker methods.
   */
  private predicate harvesterRecordRemoteUrlToSelf(DataFlow::Node nodeFrom, DataFlow::Node nodeTo) {
    exists(Attribute rec, Attribute selfAttr |
      rec.getName() = "remote_url" and
      rec.getObject().(Name).getId() = "record" and
      inFileMatches(rec, "geonode/harvesting/harvesters/%") and
      nodeFrom = DataFlow::exprNode(rec) and
      selfAttr.getName() = "remote_url" and
      selfAttr.getObject().(Name).getId() = "self" and
      inFileMatches(selfAttr, "geonode/harvesting/harvesters/%") and
      nodeTo = DataFlow::exprNode(selfAttr)
    )
  }

  /**
   * M6 (P3-S-0103): Service.service_url is a Django property that re-parses self.base_url
   * (geonode/services/models.py:81-96, _get_service_url: `urlparse(self.base_url)` ->
   * ParseResult(...).geturl()). Property getters are not inlined, so the `self.base_url`
   * load inside _get_service_url is connected to the `service_url` attribute loads that
   * feed the fetch-relevant consumers (services/views.py:94 get_service_handler,
   * serviceprocessors/wms.py:106/149, arcgis.py service_url, thumbs/thumbnails.py:308).
   */
  private predicate serviceUrlPropertyEvaluation(DataFlow::Node nodeFrom, DataFlow::Node nodeTo) {
    exists(Attribute baseUrlLoad, Attribute serviceUrlLoad |
      baseUrlLoad.getName() = "base_url" and
      baseUrlLoad.getObject().(Name).getId() = "self" and
      inFile(baseUrlLoad, "geonode/services/models.py") and
      baseUrlLoad.getScope().(Function).getName() = "_get_service_url" and
      nodeFrom = DataFlow::exprNode(baseUrlLoad) and
      serviceUrlLoad.getName() = "service_url" and
      (
        inFile(serviceUrlLoad, "geonode/services/views.py") or
        inFileMatches(serviceUrlLoad, "geonode/services/serviceprocessors/%") or
        inFile(serviceUrlLoad, "geonode/thumbs/thumbnails.py")
      ) and
      nodeTo = DataFlow::exprNode(serviceUrlLoad)
    )
  }

  /**
   * M7 (P3-S-0383/P3-S-0384 -> P3-S-0300): geoserver_proxy builds the target from the
   * route-captured path segments (`raw_url = "".join([ogc_server_settings.LOCATION,
   * downstream_path, path])`, geonode/geoserver/views.py:374-376) and delegates to
   * proxy(request, url=raw_url, ...) (:466-468). The str.join/urlparse-based reassembly is
   * not modeled, so the proxy_path/downstream_path parameters are connected to the `url`
   * keyword value of the proxy() call.
   */
  private predicate geoserverProxyPathToProxyUrlArgument(DataFlow::Node nodeFrom, DataFlow::Node nodeTo) {
    exists(Function proxyView, Call c, Keyword k |
      proxyView.getName() = "geoserver_proxy" and
      inFile(proxyView, "geonode/geoserver/views.py") and
      (
        nodeFrom = DataFlow::parameterNode(proxyView.getArg(1)) or
        nodeFrom = DataFlow::parameterNode(proxyView.getArg(2))
      ) and
      c.getFunc().(Name).getId() = "proxy" and
      inFile(c, "geonode/geoserver/views.py") and
      k = c.getANamedArg().(Keyword) and
      k.getArg() = "url" and
      nodeTo = DataFlow::exprNode(k.getValue())
    )
  }

  /**
   * Entry point used by the pass 3 query configuration.
   * `passKey` must be "ssrf" (the single pass key used throughout pass 3).
   */
  predicate isAdditionalTaintStep(DataFlow::Node nodeFrom, DataFlow::Node nodeTo, string passKey) {
    passKey = "ssrf" and
    (
      proxyUrlToOutboundRequest(nodeFrom, nodeTo) or
      serviceHandlerFactoryDispatch(nodeFrom, nodeTo) or
      handlerInitUrlToSelfUrl(nodeFrom, nodeTo) or
      thumbnailUrlPersistence(nodeFrom, nodeTo) or
      requestDataToStorageManager(nodeFrom, nodeTo) or
      retrieverFileParamToOriginalUri(nodeFrom, nodeTo) or
      storageManagerParamToItemRetriever(nodeFrom, nodeTo) or
      harvesterRecordRemoteUrlToSelf(nodeFrom, nodeTo) or
      serviceUrlPropertyEvaluation(nodeFrom, nodeTo) or
      geoserverProxyPathToProxyUrlArgument(nodeFrom, nodeTo)
    )
  }
}
