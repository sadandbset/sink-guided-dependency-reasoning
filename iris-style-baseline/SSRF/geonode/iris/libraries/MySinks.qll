/**
 * Machine-generated by Augur (Phase 2, Step 4) for GeoNode — Pass 3 (CWE-918 SSRF).
 * Rendered deterministically from the reviewed labels in iris/labels/labels.json
 * (pass_id 3; entries with role=sink and classification tp/candidate).
 * Label-id -> predicate mapping and evidence: iris/report/query_generation_notes.md.
 *
 * Sink semantics: the dangerous URL argument position of a real network request API,
 * or a call into a wrapper with real code evidence that the URL is passed on to
 * network I/O (OWSLib / arcrest / smart_open / GeoNode HttpClient).
 *
 * Sinks are matched at API-signature level (module requests, the http_client singleton,
 * harvester sessions, OWSLib/arcrest/smart_open call sites). Sites whose URL is
 * settings/CLI-derived (fp-labeled call sites of the same signatures) also match, but
 * only actually tainted arguments produce alerts; the operator-config false-positive
 * heuristics are applied at the reporting stage (Step 6). Test files are excluded here,
 * mirroring the label scope.
 */

import python
import semmle.python.dataflow.new.DataFlow

module MySinks {
  // ---------- shared helpers ----------

  /** Holds if `n` is located in the file with this repo-relative path. */
  private predicate inFile(AstNode n, string relPath) {
    n.getLocation().getFile().getRelativePath() = relPath
  }

  /**
   * Holds if `n` is outside test files. The reviewed labels exclude tests
   * (WORKFLOW.md false-positive heuristic "test files -> FP"), so the generated
   * sink model excludes them as well.
   */
  private predicate notInTestFile(AstNode n) {
    not n.getLocation().getFile().getRelativePath().matches("%/tests/%") and
    not n.getLocation().getFile().getRelativePath().matches("%tests.py") and
    not n.getLocation().getFile().getRelativePath().matches("%/test_%.py")
  }

  // ---------- pass 3 sinks (pass key: "ssrf") ----------

  /**
   * requests.<get|post|put|delete>(url, ...) — URL at positional argument 0.
   * tp instances: P3-K-0075 (geonode/services/serviceprocessors/wms.py:284, user service URL).
   * candidate instances: P3-K-0015 (geonode/harvesting/harvesters/base.py:334, download_resource_file).
   */
  private predicate requestsModuleVerbUrl(DataFlow::Node sink) {
    exists(Call c, Attribute func, string verb |
      sink.asExpr() = c.getPositionalArg(0) and
      func = c.getFunc() and
      func.getName() = verb and
      (
        verb = "get" or
        verb = "post" or
        verb = "put" or
        verb = "delete"
      ) and
      func.getObject().(Name).getId() = "requests"
    )
  }

  /**
   * http_client.<request|get|post>(url, ...) — URL at positional argument 0 of the central
   * GeoNode HttpClient wrapper (requests.Session with verify=False downstream).
   * tp instances: P3-K-0016 (serviceprocessors/base.py:81 probe), P3-K-0065 (utils.py:1883
   * is_monochromatic_image), P3-K-0070 (proxy/views.py:194).
   * candidate instances: P3-K-0037..P3-K-0040 (geoserver/helpers.py:1012-1082, remote-service URLs).
   */
  private predicate httpClientWrapperUrl(DataFlow::Node sink) {
    exists(Call c, Attribute func, string verb |
      sink.asExpr() = c.getPositionalArg(0) and
      func = c.getFunc() and
      func.getName() = verb and
      (
        verb = "request" or
        verb = "get" or
        verb = "post"
      ) and
      func.getObject().(Name).getId() = "http_client"
    )
  }

  /**
   * Harvester session fetches: self.http_session.<get|post>(url, ...) and
   * http_session.<get|post>(url, ...) — URL at positional argument 0.
   * candidate instances: P3-K-0002/P3-K-0003 (arcgis.py:156,277),
   * P3-K-0027..P3-K-0035 (geonodeharvester.py), P3-K-0079 (harvesters/wms.py:203).
   */
  private predicate harvesterSessionUrl(DataFlow::Node sink) {
    exists(Call c, Attribute func, string verb |
      sink.asExpr() = c.getPositionalArg(0) and
      func = c.getFunc() and
      func.getName() = verb and
      (
        verb = "get" or
        verb = "post"
      ) and
      func.getObject().(Name).getId() = "http_session"
    )
    or
    exists(Call c, Attribute func, string verb |
      sink.asExpr() = c.getPositionalArg(0) and
      func = c.getFunc() and
      func.getName() = verb and
      (
        verb = "get" or
        verb = "post"
      ) and
      func.getObject().(Attribute).getName() = "http_session"
    )
  }

  /**
   * P3-K-0063 (tp 0.95): action(url=url, ...) — the `url` keyword argument of the final
   * requests.Session dispatch in geonode/utils.py HttpClient.request (arg_index 0 denotes
   * the keyword argument, per the label signature).
   */
  private predicate httpClientActionKeywordUrl(DataFlow::Node sink) {
    exists(Call c, Keyword k |
      k = c.getANamedArg().(Keyword) and
      k.getArg() = "url" and
      sink.asExpr() = k.getValue() and
      c.getFunc().(Name).getId() = "action" and
      inFile(c, "geonode/utils.py") and
      c.getScope().(Function).getName() = "request"
    )
  }

  /**
   * P3-K-0064 (tp 0.9): session.get(url, ...) — the fallback requests.Session dispatch in
   * geonode/utils.py HttpClient.request; URL at positional argument 0.
   */
  private predicate httpClientSessionGetUrl(DataFlow::Node sink) {
    exists(Call c |
      sink.asExpr() = c.getPositionalArg(0) and
      c.getFunc().(Attribute).getName() = "get" and
      c.getFunc().(Attribute).getObject().(Name).getId() = "session" and
      inFile(c, "geonode/utils.py") and
      c.getScope().(Function).getName() = "request"
    )
  }

  /**
   * OWSLib wrapper fetches — URL at positional argument 0; the network I/O happens inside
   * the external owslib library (wrapper sinks per labels).
   * tp instances: P3-K-0073/P3-K-0074 (WebMapService, serviceprocessors/wms.py:96,272).
   * candidate instances: P3-K-0076..P3-K-0078 (harvesters/wms.py:78,92,157), P3-K-0062
   * (openURL, thumbs/utils.py:421), P3-K-0002-family via http_post (catalogue).
   */
  private predicate owslibWrapperUrl(DataFlow::Node sink) {
    exists(Call c, string fname |
      sink.asExpr() = c.getPositionalArg(0) and
      c.getFunc().(Name).getId() = fname and
      (
        fname = "WebMapService" or
        fname = "WebFeatureService" or
        fname = "WebCoverageService" or
        fname = "openURL" or
        fname = "http_post"
      )
    )
    or
    exists(Call c, Attribute func, string cls, string mod |
      sink.asExpr() = c.getPositionalArg(0) and
      func = c.getFunc() and
      func.getName() = cls and
      (
        cls = "WebMapService_1_1_1" or
        cls = "WebMapService_1_3_0"
      ) and
      func.getObject().(Name).getId() = mod and
      (
        mod = "wms111" or
        mod = "wms130"
      )
    )
  }

  /**
   * arcrest.<MapService|ImageService|Catalog>(url, ...) — URL at positional argument 0;
   * network I/O inside the external arcrest library (wrapper sinks per labels).
   * candidate instances: P3-K-0004, P3-K-0005, P3-K-0006 (harvesters/arcgis.py:347,350,410).
   */
  private predicate arcrestWrapperUrl(DataFlow::Node sink) {
    exists(Call c, Attribute func, string cls |
      sink.asExpr() = c.getPositionalArg(0) and
      func = c.getFunc() and
      func.getName() = cls and
      (
        cls = "MapService" or
        cls = "ImageService" or
        cls = "Catalog"
      ) and
      func.getObject().(Name).getId() = "arcrest"
    )
  }

  /**
   * P3-K-0019 (tp 0.75): smart_open.open(uri=...) — the `uri` keyword argument
   * (arg_index 0 denotes the keyword argument, per the label signature) in
   * geonode/storage/data_retriever.py:115; server-side fetch/copy of an arbitrary URI.
   */
  private predicate smartOpenUri(DataFlow::Node sink) {
    exists(Call c, Keyword k |
      k = c.getANamedArg().(Keyword) and
      k.getArg() = "uri" and
      sink.asExpr() = k.getValue() and
      c.getFunc().(Attribute).getName() = "open" and
      c.getFunc().(Attribute).getObject().(Name).getId() = "smart_open"
    )
  }

  /**
   * Entry point used by the pass 3 query configuration.
   * `passKey` must be "ssrf" (the single pass key used throughout pass 3).
   */
  predicate isSink(DataFlow::Node sink, string passKey) {
    passKey = "ssrf" and
    notInTestFile(sink.asExpr()) and
    (
      requestsModuleVerbUrl(sink) or
      httpClientWrapperUrl(sink) or
      harvesterSessionUrl(sink) or
      httpClientActionKeywordUrl(sink) or
      httpClientSessionGetUrl(sink) or
      owslibWrapperUrl(sink) or
      arcrestWrapperUrl(sink) or
      smartOpenUri(sink)
    )
  }
}
