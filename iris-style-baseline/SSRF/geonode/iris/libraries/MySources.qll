  }

  /**
   * P3-S-0102, P3-S-0104 (candidate 0.55-0.6, second-order): Dataset.ows_url / MapLayer.ows_url
   * loads in geonode/thumbs/thumbnails.py — feed map/dataset thumbnail GetMap requests.
   */
  private predicate datasetOwsUrlSecondOrder(DataFlow::Node source) {
    exists(Attribute a |
      source.asExpr() = a and
      inFile(a, "geonode/thumbs/thumbnails.py") and
      a.getName() = "ows_url"
    )
  }

  /**
   * Entry point used by the pass 3 query configuration.
   * `passKey` must be "ssrf" (the single pass key used throughout pass 3).
   */
  predicate isSource(DataFlow::Node source, string passKey) {
    passKey = "ssrf" and
    (
      proxyUrlParameter(source) or
      serviceRegistrationFormUrlSubscript(source) or
      serviceRegistrationFormUrlGet(source) or
      registerServicePost(source) or
      setThumbnailFileUrlGet(source) or
      setThumbnailFileUrlSubscript(source) or
      datasetApiRequestData(source) or
      documentFormDocUrl(source) or
      proxyAuthorizationHeader(source) or
      proxyRequestBody(source) or
      getHeadersRequestFields(source) or
      cswDispatchRequestMeta(source) or
      managementCommandJobData(source) or
      geoserverProxyPathParams(source) or
      thumbnailUrlSecondOrder(source) or
      serviceBaseUrlSecondOrder(source) or
      harvesterRemoteUrlSecondOrder(source) or
      datasetOwsUrlSecondOrder(source)
    )
  }
