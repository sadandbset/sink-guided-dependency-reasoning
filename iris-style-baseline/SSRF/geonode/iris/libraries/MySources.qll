  }

  /**
   * P3-S-0139..P3-S-0153 (candidate 0.4): request header/cookie/META/method reads inside
   * geonode/utils.py get_headers() — forwarded as outbound headers (Pass 10 adjacency).
   */
  private predicate getHeadersRequestFields(DataFlow::Node source) {
    exists(Attribute a |
      source.asExpr() = a and
      inFile(a, "geonode/utils.py") and
      a.getObject().(Name).getId() = "request" and
      (
        a.getName() = "headers" or
        a.getName() = "COOKIES" or
        a.getName() = "META" or
        a.getName() = "method"
      ) and
      a.getScope().(Function).getName() = "get_headers"
    )
  }

  /**
