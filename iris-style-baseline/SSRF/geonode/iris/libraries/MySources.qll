  /**
   * P3-S-0383, P3-S-0384 (candidate 0.6): route-captured proxy_path / downstream_path of
   * geoserver_proxy (geonode/geoserver/views.py:417). Host/scheme are fixed to the configured
   * geoserver backend — attacker controls only the path/query of the internal backend URL.
   */
  private predicate geoserverProxyPathParams(DataFlow::Node source) {
    exists(Function f |
      f.getName() = "geoserver_proxy" and
      inFile(f, "geonode/geoserver/views.py") and
      (
        source = DataFlow::parameterNode(f.getArg(1)) or
        source = DataFlow::parameterNode(f.getArg(2))
      )
    )
  }

  /**
   * P3-S-0098 (tp 0.85, second-order): `instance.thumbnail_url` loads feeding
   * is_monochromatic_image (geonode/geoserver/signals.py:143, geonode/geoserver/helpers.py:2160).
   * Runtime realization of the ResourceBase.thumbnail_url field label.
   */
  private predicate thumbnailUrlSecondOrder(DataFlow::Node source) {
    exists(Attribute a |
      source.asExpr() = a and
      attrRead(a, "instance", "thumbnail_url") and
      (
        inFile(a, "geonode/geoserver/signals.py") or
        inFile(a, "geonode/geoserver/helpers.py")
      )
    )
  }

  /**
   * P3-S-0103 (tp 0.8, second-order): `self.base_url` load inside Service._get_service_url
   * (geonode/services/models.py) — runtime realization of the Service.base_url field label.
   */
  private predicate serviceBaseUrlSecondOrder(DataFlow::Node source) {
    exists(Attribute a |
      source.asExpr() = a and
      inFile(a, "geonode/services/models.py") and
      attrRead(a, "self", "base_url") and
      a.getScope().(Function).getName() = "_get_service_url"
    )
  }

  /**
   * P3-S-0101 (candidate 0.7, second-order): `record.remote_url` loads in the harvester
   * from_django_record factories (geonode/harvesting/harvesters/*.py) — runtime realization
   * of the Harvester.remote_url field label.
