  /**
   * P3-S-0061 (candidate 0.45): `self.cleaned_data.get("doc_url")` in
   * geonode/documents/forms.py:211 — user-supplied document URL persisted to Document.doc_url
   * (no verified server-side fetch consumer; kept per reviewed label).
   */
  private predicate documentFormDocUrl(DataFlow::Node source) {
    exists(Call c |
      source.asExpr() = c and
      inFile(c, "geonode/documents/forms.py") and
      c.getFunc().(Attribute).getName() = "get" and
      c.getFunc().(Attribute).getObject().(Attribute).getName() = "cleaned_data" and
      c.getFunc().(Attribute).getObject().(Attribute).getObject().(Name).getId() = "self" and
