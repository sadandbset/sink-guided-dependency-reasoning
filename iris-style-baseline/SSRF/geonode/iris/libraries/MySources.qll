/**
 * Machine-generated by Augur (Phase 2, Step 4) for GeoNode — Pass 3 (CWE-918 SSRF).
 * Rendered deterministically from the reviewed labels in iris/labels/labels.json
 * (pass_id 3; entries with role=source and classification tp/candidate).
 * Label-id -> predicate mapping and evidence: iris/report/query_generation_notes.md.
 *
 * Source semantics: untrusted external request/message/URL input boundaries only.
 * Internal wrapper parameters are NOT sources (they are modeled in MySummaries).
 * Second-order DB URL fields (Service.base_url, ResourceBase.thumbnail_url,
 * Harvester.remote_url, Dataset/MapLayer.ows_url) are instantiated at the concrete
 * attribute loads that feed the fetches, as recorded by their labels.
 */

import python
import semmle.python.dataflow.new.DataFlow

module MySources {
  // ---------- shared helpers ----------

  /** Holds if `n` is located in the file with this repo-relative path. */
  private predicate inFile(AstNode n, string relPath) {
    n.getLocation().getFile().getRelativePath() = relPath
  }

  /** Holds if `n` is located in a file matching this repo-relative glob. */
  bindingset[relPathGlob]
  private predicate inFileMatches(AstNode n, string relPathGlob) {
    n.getLocation().getFile().getRelativePath().matches(relPathGlob)
  }

  /** Holds if `a` is an attribute read `recv.name`. */
  private predicate attrRead(Attribute a, string recv, string name) {
    a.getName() = name and
    a.getObject().(Name).getId() = recv
  }

  // ---------- pass 3 sources (pass key: "ssrf") ----------

  /**
   * P3-S-0302, P3-S-0303 (tp 0.95): `request.GET["url"]` in geonode/proxy/views.py:97 —
   * the /proxy/?url= target. The view is reachable without login (only @requires_csrf_token);
   * attacker controls the complete outbound URL (scheme/host/port/path).
   */
  private predicate proxyUrlParameter(DataFlow::Node source) {
    exists(Subscript s |
      source.asExpr() = s and
      inFile(s, "geonode/proxy/views.py") and
      s.getObject().(Attribute).getName() = "GET" and
      s.getObject().(Attribute).getObject().(Name).getId() = "request"
    )
  }

  /**
   * P3-S-0063 (tp 0.9): `self.cleaned_data["url"]` in geonode/services/forms.py:55 —
   * user-supplied service URL read back by CreateServiceForm.clean_url.
   */
  private predicate serviceRegistrationFormUrlSubscript(DataFlow::Node source) {
    exists(Subscript s |
      source.asExpr() = s and
      inFile(s, "geonode/services/forms.py") and
      s.getObject().(Attribute).getName() = "cleaned_data" and
      s.getObject().(Attribute).getObject().(Name).getId() = "self" and
      s.getIndex().(StringLiteral).getS() = "url"
    )
  }

  /**
   * P3-S-0064 (tp 0.9): `self.cleaned_data.get("url")` in geonode/services/forms.py:64 —
   * feeds get_service_handler(base_url=url) whose probe() fetches the URL during form validation.
   */
  private predicate serviceRegistrationFormUrlGet(DataFlow::Node source) {
    exists(Call c |
      source.asExpr() = c and
      inFile(c, "geonode/services/forms.py") and
      c.getFunc().(Attribute).getName() = "get" and
      c.getFunc().(Attribute).getObject().(Attribute).getName() = "cleaned_data" and
      c.getFunc().(Attribute).getObject().(Attribute).getObject().(Name).getId() = "self" and
      c.getPositionalArg(0).(StringLiteral).getS() = "url"
    )
  }

  /**
   * P3-S-0356 (tp 0.85): `request.POST` bound into CreateServiceForm in
   * geonode/services/views.py:60 (register_service, @login_required — any authenticated user).
   */
  private predicate registerServicePost(DataFlow::Node source) {
    exists(Attribute a |
      source.asExpr() = a and
      inFile(a, "geonode/services/views.py") and
      attrRead(a, "request", "POST") and
      a.getScope().(Function).getName() = "register_service"
    )
  }

  /**
   * P3-S-0266 (tp 0.9): `request.data.get("file")` in geonode/base/api/views.py:1343 —
   * string branch of set_thumbnail; becomes resource.thumbnail_url.
   */
  private predicate setThumbnailFileUrlGet(DataFlow::Node source) {
    exists(Call c |
      source.asExpr() = c and
      inFile(c, "geonode/base/api/views.py") and
      c.getFunc().(Attribute).getName() = "get" and
      c.getFunc().(Attribute).getObject().(Attribute).getName() = "data" and
      c.getFunc().(Attribute).getObject().(Attribute).getObject().(Name).getId() = "request" and
      c.getPositionalArg(0).(StringLiteral).getS() = "file"
    )
  }

  /**
   * P3-S-0267, P3-S-0268 (tp 0.9): `request.data["file"]` in geonode/base/api/views.py:1346 —
   * same set_thumbnail boundary as the .get("file") read.
   */
  private predicate setThumbnailFileUrlSubscript(DataFlow::Node source) {
    exists(Subscript s |
      source.asExpr() = s and
      inFile(s, "geonode/base/api/views.py") and
      s.getObject().(Attribute).getName() = "data" and
      s.getObject().(Attribute).getObject().(Name).getId() = "request" and
      s.getIndex().(StringLiteral).getS() = "file"
    )
