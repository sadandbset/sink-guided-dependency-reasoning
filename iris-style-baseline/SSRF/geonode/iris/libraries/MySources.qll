   * (geonode/catalogue/views.py:58-59) — raw QUERY_STRING forwarded into the pycsw environment.
   */
  private predicate cswDispatchRequestMeta(DataFlow::Node source) {
    exists(Attribute a |
      source.asExpr() = a and
      inFile(a, "geonode/catalogue/views.py") and
      attrRead(a, "request", "META") and
