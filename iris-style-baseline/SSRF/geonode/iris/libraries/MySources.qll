  private predicate harvesterRemoteUrlSecondOrder(DataFlow::Node source) {
    exists(Attribute a |
      source.asExpr() = a and
      inFileMatches(a, "geonode/harvesting/harvesters/%") and
      attrRead(a, "record", "remote_url")
