  /**
   * P3-S-0304, P3-S-0305, P3-S-0306 (candidate 0.55): `request.META.get("HTTP_AUTHORIZATION"...)`
   * in geonode/proxy/views.py:160-161 — token minted from the header is appended to the outbound
   * URL query; not host control (kept for request-forgery recall).
   */
  private predicate proxyAuthorizationHeader(DataFlow::Node source) {
    exists(Call c |
      source.asExpr() = c and
      inFile(c, "geonode/proxy/views.py") and
      c.getFunc().(Attribute).getName() = "get" and
      c.getFunc().(Attribute).getObject().(Attribute).getName() = "META" and
      c.getFunc().(Attribute).getObject().(Attribute).getObject().(Name).getId() = "request"
    )
  }

  /**
