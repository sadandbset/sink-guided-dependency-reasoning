      localPath: file:///C:/Users/lzh/Desktop/github/PyVul-main/iris_manual/SSRF/geonode/iris/
      localPackDefinitionFile: file:///C:/Users/lzh/Desktop/github/PyVul-main/iris_manual/SSRF/geonode/iris/qlpack.yml
      runDataExtensions:
       -
