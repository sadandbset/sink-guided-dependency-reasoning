import python
import semmle.python.dataflow.new.DataFlow

/** Taint sinks for the fides CWE-918 pass, dispatched by pass key. */
module MySinks {
  /**
   * Holds if `sink` is a taint sink for the pass identified by `passKey`.
   *
   * Equivalent to the existence of a reviewed control scope for the node
   * (see `controlScope`). Only `ssrf` (Pass 3) is populated.
   */
  predicate isSink(DataFlow::Node sink, string passKey) {
    controlScope(sink, passKey, _)
  }

  /**
   * Holds if `sink` is a reviewed Pass 3 network-request URL sink whose
   * attacker control scope is `scope`, one of:
   *
   *   `full-url`     - the entire request URL (scheme, host, port, path) is
   *                    boundary-controlled (webhook HttpsSchema.url).
   *   `scheme+host`  - the base URI / host is boundary-controlled; the path
   *                    is fixed or derived separately (FidesConnector uri,
   *                    SaaS client host, OAuth token host, override domain,
   *                    constructor surrogate URI arguments).
   *   `host+path`    - both the host (saas config + secrets placeholders)
   *                    and the request path (config/secrets placeholders)
   *                    are boundary-controlled (SaaS transport).
   *   `path`         - host pinned to a fixed literal; only path segments
   *                    are boundary-controlled (yotpo, mailgun) - lower
   *                    severity, kept for recall per candidate labels.
   */
  predicate controlScope(DataFlow::Node sink, string passKey, string scope) {
    passKey = "ssrf" and (
      httpsWebhookPostUrlSink(sink, scope) or
      sessionSendRequestSink(sink, scope) or
      clientSendRequestSink(sink, scope) or
      httpxPostUrlSink(sink, scope) or
      asyncClientGetUrlSink(sink, scope) or
      barePostUrlKeywordSink(sink, scope) or
      authenticatedClientCtorUriSink(sink, scope) or
      fidesClientCtorUriSink(sink, scope) or
      mailgunUrlSink(sink, scope)
    )
  }

  /**
   * snk-026: `requests.post(url=config.url, headers=..., json=...)` in
   * HTTPSConnector.execute (http_connector.py:48). The url= keyword value
   * is the persisted HttpsSchema.url - the whole request target.
   */
  private predicate httpsWebhookPostUrlSink(DataFlow::Node sink, string scope) {
    exists(Call c, Keyword kw |
      requestsQualifiedCall(c, "post") and
      c.getScope().getEnclosingModule().getFile().getBaseName() =
        "http_connector.py" and
      c.getLocation().getStartLine() = 48 and
      kw = c.getAKeyword() and
      kw.getArg() = "url" and
      sink.asExpr() = kw.getValue()
    ) and
    scope = "full-url"
  }

  /**
   * `requests.Session.send(<request>)` sites - positional argument 0:
   *
   *   snk-011  authenticated_client.py:207  `self.session.send(prepared_request)`
   *            (host+path: url=f"{self.uri}{request_params.path}")
   *   snk-021/022/023  fides_client.py:125/227/271  `self.session.send(request)`
   *            (scheme+host: url=f"{self.uri}{path}")
   *   snk-034  request_runner_service.py:679  `client.session.send(request)`
   *            (scheme+host: FidesConnector uri base, fixed path)
   */
  private predicate sessionSendRequestSink(DataFlow::Node sink, string scope) {
    exists(Call c, string base, int line |
      c.getFunc() instanceof Attribute and
      c.getFunc().(Attribute).getName() = "send" and
      c.getFunc().(Attribute).getObject() instanceof Attribute and
      c.getFunc().(Attribute).getObject().(Attribute).getName() = "session" and
      base = c.getScope().getEnclosingModule().getFile().getBaseName() and
      line = c.getLocation().getStartLine() and
      sink.asExpr() = c.getPositionalArg(0) and
      (
        (
          base = "authenticated_client.py" and line = 207 and
          scope = "host+path"
        )
        or
        (
          base = "fides_client.py" and line in [125, 227, 271] and
          scope = "scheme+host"
        )
        or
        (
          base = "request_runner_service.py" and line = 679 and
          scope = "scheme+host"
        )
      )
    )
  }

  /**
   * `client.send(<request_params>, ...)` (AuthenticatedClient.send) sites -
   * positional argument 0. The wrapper issues the network request whose
   * base URI comes from build_uri() (saas config protocol/host + secrets
   * placeholders) and whose path is built from config/secrets-derived
   * placeholders:
   *
   *   snk-037/039/040/041  saas_connector.py:137/287/436/539 (test_connection,
   *                        execute_prepared_request, mask_data,
   *                        run_consent_request)
   *   snk-016              authentication_strategy_oauth2_base.py:92 (OAuth2
   *                        token request)
   *   snk-018/019/025/027/028/042/043  the SaaS request overrides
   *                        (braze:36, domo:40, friendbuy_nextgen:33,
   *                        mailchimp:58/97, twilio:41/80)
   */
  private predicate clientSendRequestSink(DataFlow::Node sink, string scope) {
    exists(Call c, string base, int line |
      c.getFunc() instanceof Attribute and
      c.getFunc().(Attribute).getName() = "send" and
      base = c.getScope().getEnclosingModule().getFile().getBaseName() and
      line = c.getLocation().getStartLine() and
      clientSendSite(base, line) and
      sink.asExpr() = c.getPositionalArg(0)
    ) and
    scope = "host+path"
  }

  /** The 13 reviewed `client.send(...)` wrapper sites. */
  private predicate clientSendSite(string base, int line) {
    (
      base = "saas_connector.py" and line in [137, 287, 436, 539]
    )
    or
    (
      base = "authentication_strategy_oauth2_base.py" and line = 92
    )
    or
    (
      base = "braze_request_overrides.py" and line = 36
    )
    or
    (
      base = "domo_request_overrides.py" and line = 40
    )
    or
    (
      base = "friendbuy_nextgen_request_overrides.py" and line = 33
    )
    or
    (
      base = "mailchimp_request_overrides.py" and line in [58, 97]
    )
    or
    (
      base = "twilio_request_overrides.py" and line in [41, 80]
    )
  }

  /**
   * snk-020: `httpx.post(f"{self.uri}{urls.V1_URL_PREFIX}{urls.LOGIN}",
   * json=...)` in FidesClient.login (fides_client.py:59) - positional
   * argument 0, the base URI from FidesConnectorSchema.uri.
   */
  private predicate httpxPostUrlSink(DataFlow::Node sink, string scope) {
    exists(Call c |
      c.getFunc() instanceof Attribute and
      c.getFunc().(Attribute).getName() = "post" and
      c.getFunc().(Attribute).getObject() instanceof Name and
      c.getFunc().(Attribute).getObject().(Name).getId() = "httpx" and
      c.getScope().getEnclosingModule().getFile().getBaseName() =
        "fides_client.py" and
      c.getLocation().getStartLine() = 59 and
      sink.asExpr() = c.getPositionalArg(0)
    ) and
    scope = "scheme+host"
  }

  /**
   * snk-035/036: `await client.get(url, headers=...)` /
