  /**
   * Bare `post(url=..., json=...)` calls imported from requests in the
   * override implementations - url= keyword value:
   *
   *   snk-013  authentication_strategy_friendbuy_nextgen.py:53
   *            f"https://{domain}/v1/authorization" - domain from secrets
   *            (scheme+host).
   *   snk-014  authentication_strategy_heap.py:49
   *            f"https://{domain}/api/public/v0/auth_token" (scheme+host).
   *   snk-017  authentication_strategy_yotpo_reviews.py:45
   *            f"https://api.yotpo.com/core/v3/stores/{store_id}/access_tokens"
   *            - host pinned, store_id path segment (path).
   */
  private predicate barePostUrlKeywordSink(DataFlow::Node sink, string scope) {
    exists(Call c, Keyword kw, string base, int line |
      c.getFunc() instanceof Name and
      c.getFunc().(Name).getId() = "post" and
      kw = c.getAKeyword() and
      kw.getArg() = "url" and
      base = c.getScope().getEnclosingModule().getFile().getBaseName() and
      line = c.getLocation().getStartLine() and
      sink.asExpr() = kw.getValue() and
      (
        (
          base = "authentication_strategy_friendbuy_nextgen.py" and line = 53 and
          scope = "scheme+host"
        )
        or
        (
          base = "authentication_strategy_heap.py" and line = 49 and
          scope = "scheme+host"
        )
        or
        (
          base = "authentication_strategy_yotpo_reviews.py" and line = 45 and
