  /**
   * Constructor surrogate sinks - `AuthenticatedClient(<uri>, ...)`
   * positional argument 0 (snk-015 at authentication_strategy_oauth2_
   * base.py:74, snk-038 at saas_connector.py:154). The constructor performs
   * no I/O, but the URI is stored on self.uri and interpolated into every
   * request URL (authenticated_client.py:63-69); matching this argument
   * lets the analysis catch the field-mediated flow even where the later
   * send() site itself is not tainted.
   */
  private predicate authenticatedClientCtorUriSink(DataFlow::Node sink, string scope) {
    exists(Call c, string base, int line |
      c.getFunc() instanceof Name and
      c.getFunc().(Name).getId() = "AuthenticatedClient" and
      base = c.getScope().getEnclosingModule().getFile().getBaseName() and
      line = c.getLocation().getStartLine() and
      (
        (base = "authentication_strategy_oauth2_base.py" and line = 74)
        or
        (base = "saas_connector.py" and line = 154)
      ) and
      sink.asExpr() = c.getPositionalArg(0)
    ) and
    scope = "scheme+host"
  }

  /**
   * snk-024: `FidesClient(uri=config.uri, username=..., ...)` in
   * FidesConnector.create_client (fides_connector.py:58) - uri= keyword
   * value (the first parameter; CSV arg_index -1 normalized to 0 in the
   * Phase 1 deviations record). Constructor surrogate for self.uri, which
   * shapes httpx.post at fides_client.py:59 and every session.send request.
   */
  private predicate fidesClientCtorUriSink(DataFlow::Node sink, string scope) {
    exists(Call c, Keyword kw |
      c.getFunc() instanceof Name and
      c.getFunc().(Name).getId() = "FidesClient" and
      c.getScope().getEnclosingModule().getFile().getBaseName() =
        "fides_connector.py" and
      c.getLocation().getStartLine() = 58 and
      kw = c.getAKeyword() and
      kw.getArg() = "uri" and
      sink.asExpr() = kw.getValue()
    ) and
    scope = "scheme+host"
  }

  /**
   * snk-030/031/032: the mailgun dispatcher fetches
   * (message_dispatch_service.py:471/492/512) - `requests.get`/`requests.post`
   * positional argument 0, the f"{base_url}/{api_version}/{domain}/..."
   * URL. The base host is the fixed literal api.mailgun.net /
   * api.eu.mailgun.net (chosen by the IS_EU_DOMAIN boolean); only the path
   * segments are MessagingConfig.details-derived.
   */
  private predicate mailgunUrlSink(DataFlow::Node sink, string scope) {
    exists(Call c |
      (
        requestsQualifiedCall(c, "get") or
        requestsQualifiedCall(c, "post")
      ) and
      c.getScope().getEnclosingModule().getFile().getBaseName() =
        "message_dispatch_service.py" and
      c.getLocation().getStartLine() in [471, 492, 512] and
      sink.asExpr() = c.getPositionalArg(0)
    ) and
    scope = "path"
  }

  /** A qualified `requests.<name>(...)` call. */
  private predicate requestsQualifiedCall(Call c, string name) {
    c.getFunc() instanceof Attribute and
    c.getFunc().(Attribute).getName() = name and
    c.getFunc().(Attribute).getObject() instanceof Name and
    c.getFunc().(Attribute).getObject().(Name).getId() = "requests"
  }
}
