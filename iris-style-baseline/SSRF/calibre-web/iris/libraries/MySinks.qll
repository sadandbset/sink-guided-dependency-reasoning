      c.getScope().getEnclosingModule().getFile().getBaseName() = "helper.py" and
      c.getLocation().getStartLine() = 740
    )
    or
    (
      c.getScope().getEnclosingModule().getFile().getBaseName() = "lubimyczytac.py" and
      c.getLocation().getStartLine() in [115, 203]
