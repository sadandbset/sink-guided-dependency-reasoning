import python
import semmle.python.dataflow.new.DataFlow

/** Additional taint propagation steps for the calibre-web passes. */
module MySummaries {
  /**
   * Holds if taint may additionally flow from `nodeFrom` to `nodeTo` for
   * the pass identified by `passKey`.
   *
   * Only `ssrf` (Pass 3) is populated. Every step is conditioned on a
   * concrete syntactic shape whose data path was verified in the source; no
   * step propagates taint unconditionally.
   *
   * Rendered steps:
   *   1. storeUrlStep               (labels src-089, src-091)
   *   2. providerSearchDispatchStep (label src-140)
   *   3. executorSubmitSearchStep   (label src-143)
   */
  predicate isAdditionalTaintStep(DataFlow::Node nodeFrom, DataFlow::Node nodeTo, string passKey) {
    passKey = "ssrf" and (
      storeUrlStep(nodeFrom, nodeTo) or
      providerSearchDispatchStep(nodeFrom, nodeTo) or
      executorSubmitSearchStep(nodeFrom, nodeTo)
    )
  }

  /**
   * Step 1 - Kobo store URL construction (labels src-089 and src-091, the
   * two call sites of get_store_url_for_current_request):
   *
   *   cps/kobo.py:67-73
   *   `def get_store_url_for_current_request():`
   *   `    __, __, request_path_with_auth_token = request.full_path.rpartition("/kobo/")`
   *   `    __, __, request_path = request_path_with_auth_token.rstrip("?").partition("/")`
   *   `    return KOBO_STOREAPI_URL + "/" + request_path`
   *   cps/kobo.py:96  `url=get_store_url_for_current_request(),`  (store request)
   *   cps/kobo.py:110 `return redirect(get_store_url_for_current_request(), 307)`
   *
   * Edge: taint at the `request.full_path` attribute read (kobo.py:69 - the
   * reviewed source src-087) flows to the result of any
   * get_store_url_for_current_request() call, i.e. to the url= keyword
   * value at kobo.py:96 (the snk-008 sink node) and to the 307 redirect
   * target at kobo.py:110. The chain rpartition -> tuple unpacking ->
   * rstrip -> partition -> string concatenation may partially be covered by
   * standard local flow through the in-database function; the edge
   * guarantees the propagation regardless of tuple-unpack modeling and is
   * conditioned on the exact source shape (not unconditional).
   */
  private predicate storeUrlStep(DataFlow::Node nodeFrom, DataFlow::Node nodeTo) {
    exists(Attribute a, Call c |
      requestFullPathRead(a) and
      nodeFrom.asExpr() = a and
      storeUrlWrapperCall(c) and
      nodeTo.asExpr() = c
    )
  }

  /** The `request.full_path` attribute read at cps/kobo.py:69. */
  private predicate requestFullPathRead(Attribute a) {
    a.getName() = "full_path" and
    a.getObject().(Name).getId() = "request" and
    a.getScope().getEnclosingModule().getFile().getBaseName() = "kobo.py" and
    a.getLocation().getStartLine() = 69
  }

  /** A `get_store_url_for_current_request()` call in cps/kobo.py. */
  private predicate storeUrlWrapperCall(Call c) {
    c.getFunc() instanceof Name and
    c.getFunc().(Name).getId() = "get_store_url_for_current_request" and
    c.getScope().getEnclosingModule().getFile().getBaseName() = "kobo.py"
  }

  /**
   * Step 2 - provider .search() dispatch (label src-140, the call site at
   * cps/search_metadata.py:109):
   *
   *   cps/search_metadata.py:109
   *   `data = provider.search(new_state.get("query", ""))`
   *
   * The receiver `provider` comes from `next((c for c in cl ...), None)`
   * where cl holds the Metadata subclasses instantiated at import time
   * (search_metadata.py:57-72), so the callee cannot be statically
   * resolved. Edge: taint in positional argument 0 of a `.search(...)` call
   * in cps/search_metadata.py flows to the `query` parameter (getArg(1);
   * self occupies getArg(0)) of every `search` method defined on a class in
   * cps/metadata_provider/ - Google.search, ComicVine.search,
   * LubimyCzytac.search, Amazon.search, scholar.search (and the abstract
   * Metadata.search in cps/services/Metadata.py, whose body is `pass` and
   * cannot propagate). This is a conservative approximation of the dynamic
   * dispatch: every provider in cl receives the same query argument.
   */
  private predicate providerSearchDispatchStep(DataFlow::Node nodeFrom, DataFlow::Node nodeTo) {
    exists(Call c, Function f, Parameter p |
      providerSearchDispatchCall(c) and
      nodeFrom.asExpr() = c.getPositionalArg(0) and
      providerSearchMethod(f) and
      p = f.getArg(1) and
      nodeTo = DataFlow::parameterNode(p)
    )
  }

  /** A `.search(...)` call in cps/search_metadata.py (the 109 dispatch). */
  private predicate providerSearchDispatchCall(Call c) {
    c.getFunc() instanceof Attribute and
    c.getFunc().(Attribute).getName() = "search" and
    c.getScope().getEnclosingModule().getFile().getBaseName() = "search_metadata.py"
  }

  /**
   * A `search` method of a class in the cps/metadata_provider package
   * (self occupies getArg(0), the query string is getArg(1)).
   */
  private predicate providerSearchMethod(Function f) {
    f.getName() = "search" and
    f.getEnclosingScope() instanceof Class and
    f.getEnclosingModule().getFile().getRelativePath().matches("cps/metadata_provider/%")
  }

  /**
   * Step 3 - thread-pool dispatch of the provider search (label src-143,
   * the submit call at cps/search_metadata.py:128):
   *
   *   cps/search_metadata.py:126-131
   *   `with concurrent.futures.ThreadPoolExecutor(max_workers=5) as executor:`
   *   `    meta = {`
   *   `        executor.submit(c.search, query, static_cover, locale): c`
   *   `        for c in cl`
   *   `        if active.get(c.__id__, True)`
   *   `    }`
   *
   * ThreadPoolExecutor.submit(fn, *args) invokes fn(*args), so
   * `executor.submit(c.search, query, ...)` calls `c.search(query, ...)`.
   * The call is dynamic (c iterates the provider instances in cl), so the
   * standard library cannot connect it. Edge: taint in positional argument
   * 1 of such a submit call (the query - argument 0 is the bound method
   * object c.search) flows to the `query` parameter (getArg(1)) of every
   * provider search method. Only the query argument is bridged;
   * static_cover / locale (submit arguments 2/3) never reach a request URL
   * and get no edge.
   */
  private predicate executorSubmitSearchStep(DataFlow::Node nodeFrom, DataFlow::Node nodeTo) {
    exists(Call c, Function f, Parameter p |
      executorSubmitSearchCall(c) and
      nodeFrom.asExpr() = c.getPositionalArg(1) and
      providerSearchMethod(f) and
      p = f.getArg(1) and
      nodeTo = DataFlow::parameterNode(p)
    )
  }

  /**
   * An `executor.submit(c.search, query, ...)` call in cps/search_metadata.py:
   * a submit call whose first positional argument is an attribute named
   * `search`.
   */
  private predicate executorSubmitSearchCall(Call c) {
    c.getFunc() instanceof Attribute and
    c.getFunc().(Attribute).getName() = "submit" and
    c.getScope().getEnclosingModule().getFile().getBaseName() = "search_metadata.py" and
    c.getPositionalArg(0) instanceof Attribute and
    c.getPositionalArg(0).(Attribute).getName() = "search"
  }
}
