import python
import semmle.python.dataflow.new.DataFlow

module MySources {
  // ---------- shared helpers ----------

  /** Holds if `n` is located in the file with this repo-relative path. */
  private predicate inFile(AstNode n, string relPath) {
    n.getLocation().getFile().getRelativePath() = relPath
  }

  /** Holds if `a` is an attribute read `request.<name>`. */
  private predicate requestAttrRead(Attribute a, string name) {
    a.getName() = name and
    a.getObject().(Name).getId() = "request"
  }

  /** Holds if the attribute read `a` sits in a method of the Resource class `className`. */
  private predicate inResourceClass(Attribute a, string className) {
    a.getScope().(Function).getEnclosingScope().(Class).getName() = className
  }

