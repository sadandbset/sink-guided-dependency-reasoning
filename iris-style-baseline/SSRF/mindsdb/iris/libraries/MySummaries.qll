/**
 * Machine-generated by Augur (Phase 2, Step 4) for mindsdb — Pass 3 (CWE-918 SSRF).
 * Rendered deterministically from the reviewed labels in iris/labels/labels.json
 * (pass_id 3) plus the propagation glue documented in the Phase 1 label rationales
 * and phase1_review.md §6.
 *
 * Every edge below is conditioned on concrete functions, parameters and attribute
 * loads in the mindsdb source; there is no unconditional taint propagation. Each
 * edge exists because the standard data flow library cannot cross the corresponding
 * construct:
 *   - sqlalchemy persistence of handler connection args between REST/SQL writes and
 *     later handler construction (S1),
 *   - dynamic handler construction `HandlerClass(**handler_ars)` /
 *     `DBClient(handler_type, HandlerClass, **handler_ars)` through the
 *     handler-module registry (S2),
 *   - cross-method object-field flow through those unresolved constructors
 *     (`self.base_url`/`self.connection_data`/... stores in __init__, loads in the
 *     fetch methods) (S3),
 *   - URL reassembly through urllib.parse.urljoin, which is not modeled as a taint
 *     step by the standard library (S4).
 *
 * NOT modeled (documented gaps in iris/report/query_generation_notes.md, requiring
 * either re-review or acceptance — not silently bridged here):
 *   - SQL text -> parsed statement -> connection-args dicts (the mindsdb_sql parser
 *     boundary): taint from the process_query `sql` sources stops at parse_sql;
 *   - model_storage replay of CREATE MODEL 'using' args into predict-time
 *     mlflow/ray_serve fetches;
 *   - the web-crawl response-derived href loop (second-order URLs).
 */

import python
import semmle.python.dataflow.new.DataFlow

module MySummaries {
  // ---------- shared helpers ----------

  /** Holds if `n` is located in the file with this repo-relative path. */
  private predicate inFile(AstNode n, string relPath) {
    n.getLocation().getFile().getRelativePath() = relPath
  }

  /**
   * The handler files whose tp-labeled sinks consume connection-arg URLs/hosts
   * (P3-K-0025..0029, P3-K-0030..0035, P3-K-0039..0043, P3-K-0047, P3-K-0071..0074,
   * P3-K-0078, P3-K-0085..0087, P3-K-0003, P3-K-0004).
   */
  private predicate connectionArgHandlerFile(string f) {
    f = "mindsdb/integrations/handlers/dremio_handler/dremio_handler.py" or
    f = "mindsdb/integrations/handlers/pinot_handler/pinot_handler.py" or
    f = "mindsdb/integrations/handlers/strapi_handler/strapi_handler.py" or
    f = "mindsdb/integrations/handlers/eventstoredb_handler/eventstoredb_handler.py" or
    f = "mindsdb/integrations/handlers/frappe_handler/frappe_handler.py" or
    f = "mindsdb/integrations/handlers/scylla_handler/scylla_handler.py" or
    f = "mindsdb/integrations/handlers/sap_erp_handler/sap_erp_handler.py" or
    f = "mindsdb/integrations/handlers/lightdash_handler/lightdash_handler.py" or
    f = "mindsdb/integrations/handlers/gmail_handler/gmail_handler.py"
  }

  // ---------- pass 3 additional taint steps (pass key: "ssrf") ----------

  /**
   * S1 (write side: P3-S-0046/P3-S-0047/P3-S-0050/P3-S-0051, P3-S-0019..0026;
   * read side: P3-S-0038/P3-S-0039/P3-S-0043/P3-S-0044):
   * IntegrationController.add(name, engine, connection_args) persists the connection
   * args (integrations.py:194 -> _add_integration_record -> db.Integration(data=
   * connection_args or {}) at :160-168), and modify(name, data) updates the record
   * (integration_record.data = data at :217). The read side (get_handler:447
   * connection_data = integration_data.get('connection_data', {}) -> _make_handler_args
   * at :495-500; check_connections -> create_tmp_handler at :355-358) re-enters handler
   * construction through _make_handler_args' connection_data parameter (arg 3). This
   * sqlalchemy persistence relay connects the write-side parameters to that parameter.
   */
  private predicate integrationConnectionArgsPersistence(DataFlow::Node nodeFrom, DataFlow::Node nodeTo) {
    exists(Function add, Function modify, Function makeArgs |
      add.getName() = "add" and
      inFile(add, "mindsdb/interfaces/database/integrations.py") and
      add.getEnclosingScope().(Class).getName() = "IntegrationController" and
      modify.getName() = "modify" and
      inFile(modify, "mindsdb/interfaces/database/integrations.py") and
      modify.getEnclosingScope().(Class).getName() = "IntegrationController" and
      makeArgs.getName() = "_make_handler_args" and
      inFile(makeArgs, "mindsdb/interfaces/database/integrations.py") and
      makeArgs.getEnclosingScope().(Class).getName() = "IntegrationController" and
      nodeTo = DataFlow::parameterNode(makeArgs.getArg(3)) and
      (
        nodeFrom = DataFlow::parameterNode(add.getArg(3)) or
        nodeFrom = DataFlow::parameterNode(modify.getArg(2))
      )
    )
  }

  /**
   * S2: handlers are constructed dynamically through the handler-module registry —
   * get_handler (integrations.py:515 `handler = HandlerClass(**handler_ars)`) and
   * create_tmp_handler (:410 `DBClient(handler_type, ..., **handler_ars)`) — where
   * handler_ars is built by _make_handler_args (:363-373 dict(name=...,
   * connection_data=connection_data, ...)). The class/kwargs-splat dispatch is not
   * resolvable, so _make_handler_args' connection_data parameter (arg 3) is connected
   * to the connection_data/kwargs parameter (arg 2) of the __init__ of the
   * connection-arg handlers listed above (signatures verified:
   * dremio/pinot `__init__(self, name, connection_data, **kwargs)`;
   * strapi/eventstoredb/frappe/scylla/sap_erp/lightdash/gmail
   * `__init__(self, name, **kwargs)` with connection_data taken from kwargs).
   */
  private predicate handlerConstructionDispatch(DataFlow::Node nodeFrom, DataFlow::Node nodeTo) {
    exists(Function makeArgs, Function init, string handlerFile |
      makeArgs.getName() = "_make_handler_args" and
      inFile(makeArgs, "mindsdb/interfaces/database/integrations.py") and
      makeArgs.getEnclosingScope().(Class).getName() = "IntegrationController" and
      nodeFrom = DataFlow::parameterNode(makeArgs.getArg(3)) and
      connectionArgHandlerFile(handlerFile) and
      init.getName() = "__init__" and
      inFile(init, handlerFile) and
      nodeTo = DataFlow::parameterNode(init.getArg(2))
    )
  }

  /**
   * S3: cross-method object-field flow for the connection-arg handlers. The handler
   * __init__ stores the URL/host derived from connection_data
   * (dremio_handler.py:49 self.base_url = f"http://{self.connection_data['host']}:...",
   * strapi_handler.py:27 self._base_url = f"http://{args['host']}...", eventstoredb
   * :71 self.basic_url = build_basic_url(...), frappe_handler.py:44 self.domain =
   * args['domain'], scylla_handler.py:37 self.connection_args = kwargs.get('connection_data'),
   * sap_erp_handler.py:69 / lightdash_handler.py:42 self.base_url =
   * kwargs.get("connection_data", {}).get("base_url", ""), gmail_handler.py:289
   * self.credentials_url = self.connection_args.get('credentials_url')); the fetch
   * methods read those attributes back at the labeled sink sites. Since the instance
   * is created through the unresolvable registry dispatch, the __init__
   * connection_data/kwargs parameter (arg 2) is connected to the self-attribute loads.
   */
  private predicate handlerInitParamToSelfAttr(DataFlow::Node nodeFrom, DataFlow::Node nodeTo) {
    exists(Function init, Attribute load, string handlerFile, string attr |
      connectionArgHandlerFile(handlerFile) and
      init.getName() = "__init__" and
      inFile(init, handlerFile) and
      nodeFrom = DataFlow::parameterNode(init.getArg(2)) and
      load.getName() = attr and
      load.getObject().(Name).getId() = "self" and
      inFile(load, handlerFile) and
      nodeTo = DataFlow::exprNode(load) and
      (
        // dremio: P3-K-0025..0029 (self.base_url at :71/:127/:138/:143/:146)
        (handlerFile = "mindsdb/integrations/handlers/dremio_handler/dremio_handler.py" and attr = "base_url")
        or
        // pinot: P3-K-0071..0074 (self.connection_data['host']/:controller_port at :183/:209)
        (handlerFile = "mindsdb/integrations/handlers/pinot_handler/pinot_handler.py" and attr = "connection_data")
        or
        // strapi: P3-K-0085/P3-K-0086/P3-K-0087 (self._base_url at :61/:90/:98)
        (handlerFile = "mindsdb/integrations/handlers/strapi_handler/strapi_handler.py" and attr = "_base_url")
        or
        // eventstoredb: P3-K-0030..0035 (self.basic_url / self.host at :90/:104/:151/:186)
        (handlerFile = "mindsdb/integrations/handlers/eventstoredb_handler/eventstoredb_handler.py" and
          (attr = "basic_url" or attr = "host"))
        or
        // frappe handler: P3-K-0039..0043 via FrappeClient(self.domain, ...) at :138
        (handlerFile = "mindsdb/integrations/handlers/frappe_handler/frappe_handler.py" and attr = "domain")
        or
        // scylla: P3-K-0078 (self.connection_args.get('secure_connect_bundle') at :85)
        (handlerFile = "mindsdb/integrations/handlers/scylla_handler/scylla_handler.py" and attr = "connection_args")
        or
        // sap_erp: P3-K-0003 via SAPERP(self.base_url, ...) at :134
        (handlerFile = "mindsdb/integrations/handlers/sap_erp_handler/sap_erp_handler.py" and attr = "base_url")
        or
        // lightdash: P3-K-0004 via Lightdash(self.base_url, ...) at :73
        (handlerFile = "mindsdb/integrations/handlers/lightdash_handler/lightdash_handler.py" and attr = "base_url")
        or
        // gmail: P3-K-0047 (self.credentials_url at :319)
        (handlerFile = "mindsdb/integrations/handlers/gmail_handler/gmail_handler.py" and attr = "credentials_url")
      )
    )
  }

  /**
   * S3 (client classes): the API client constructors store their URL parameter, and
   * the request methods read it back — same unresolvable-instance problem as S3:
   *   - FrappeClient.__init__(domain, access_token) (frappe_client.py:14-19:
   *     self.domain = domain; self.base_url = f'{self.domain}/api') -> self.base_url /
   *     self.domain loads feeding P3-K-0039/P3-K-0040/P3-K-0041/P3-K-0042/P3-K-0043;
   *   - SAPERP.__init__(url, api_key) (sap_erp_handler/api.py:39-40: self.base_url = url)
   *     -> self.base_url loads feeding the kwargs "url" entry (P3-K-0003, api.py:46);
   *   - Lightdash.__init__(url, api_key) (lightdash_handler/api.py:7-8:
   *     self.base_url = urljoin(url, "/api/v1/")) -> self.base_url loads feeding the
   *     kwargs "url" entry (P3-K-0004, api.py:14).
   * These constructors are called directly (frappe_handler.py:138, sap_erp_handler.py:134,
   * lightdash_handler.py:73), so taint reaches the parameter through standard flow.
   */
  private predicate clientConstructorUrlToSelfAttr(DataFlow::Node nodeFrom, DataFlow::Node nodeTo) {
    exists(Function init, Attribute load, string clientFile, string attr |
      init.getName() = "__init__" and
      inFile(init, clientFile) and
      nodeFrom = DataFlow::parameterNode(init.getArg(1)) and
      load.getName() = attr and
      load.getObject().(Name).getId() = "self" and
      inFile(load, clientFile) and
      nodeTo = DataFlow::exprNode(load) and
      (
        (clientFile = "mindsdb/integrations/handlers/frappe_handler/frappe_client.py" and
          (attr = "base_url" or attr = "domain"))
        or
        (clientFile = "mindsdb/integrations/handlers/sap_erp_handler/api.py" and attr = "base_url")
        or
        (clientFile = "mindsdb/integrations/handlers/lightdash_handler/api.py" and attr = "base_url")
      )
    )
  }

  /**
   * S4 (URL 拼接): urllib.parse.urljoin(base, ref) reassembly is not modeled by the
   * standard library. The result's scheme/authority (and, for absolute `ref`, the
   * whole URL) come from the arguments, so both arguments are connected to the call
   * result at the urljoin sites that feed network requests:
   *   - sap_erp_handler/api.py:46 urljoin(self.base_url, relative_endpoint) -> the
   *     kwargs "url" entry of requests.request (P3-K-0003);
   *   - lightdash_handler/api.py:14 urljoin(self.base_url/ url, "/api/v1/") (P3-K-0004);
   *   - web_handler/urlcrawl_helpers.py:122 urljoin(url, href) — joins the initial
   *     crawl URL with response-derived hrefs (P3-K-0091 second-order loop).
   */
  private predicate urljoinUrlReassembly(DataFlow::Node nodeFrom, DataFlow::Node nodeTo) {
    exists(Call uj |
      uj.getFunc().(Name).getId() = "urljoin" and
      (
        inFile(uj, "mindsdb/integrations/handlers/sap_erp_handler/api.py") or
        inFile(uj, "mindsdb/integrations/handlers/lightdash_handler/api.py") or
        inFile(uj, "mindsdb/integrations/handlers/web_handler/urlcrawl_helpers.py")
      ) and
      nodeTo = DataFlow::exprNode(uj) and
      (
        nodeFrom.asExpr() = uj.getPositionalArg(0) or
        nodeFrom.asExpr() = uj.getPositionalArg(1)
      )
    )
  }

  /**
   * Entry point used by the pass 3 query configuration.
   * `passKey` must be "ssrf" (the single pass key used throughout pass 3).
   */
  predicate isAdditionalTaintStep(DataFlow::Node nodeFrom, DataFlow::Node nodeTo, string passKey) {
    passKey = "ssrf" and
    (
      integrationConnectionArgsPersistence(nodeFrom, nodeTo) or
      handlerConstructionDispatch(nodeFrom, nodeTo) or
      handlerInitParamToSelfAttr(nodeFrom, nodeTo) or
      clientConstructorUrlToSelfAttr(nodeFrom, nodeTo) or
      urljoinUrlReassembly(nodeFrom, nodeTo)
    )
  }
}
