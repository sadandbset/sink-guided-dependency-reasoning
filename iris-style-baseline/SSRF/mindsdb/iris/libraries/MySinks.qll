/**
 * Machine-generated by Augur (Phase 2, Step 4) for mindsdb — Pass 3 (CWE-918 SSRF).
 * Rendered deterministically from the reviewed labels in iris/labels/labels.json
 * (pass_id 3; entries with role=sink and classification tp/candidate — 42 entries:
 * 37 tp + 5 candidate; label-id -> predicate mapping in iris/report/query_generation_notes.md).
 *
 * Sink semantics: the dangerous URL argument position of a real network request API.
 * requests is the only outbound HTTP client used anywhere in the mindsdb/ tree
 * (urllib is parse-only; no urlopen/urlretrieve/httpx/aiohttp/http.client — verified
 * during extraction), so all sinks are requests call sites:
 *   - requests.<verb>(url, ...)           -> URL at positional argument 0
 *   - requests.request(method, url, ...)  -> URL at positional argument 1
 *   - requests.request(**kwargs) wrappers -> URL arrives inside the kwargs dict; for the
 *     two labeled wrapper sites (sap_erp / lightdash api.py) the sink node is the
 *     urljoin(...) call whose result is the dict's "url" entry (the label's arg_index 1
 *     denotes requests.request's URL position; the kwargs-splat call has no positional
 *     arg 1 node — see query_generation_notes.md).
 *   - session.get(url, ...)               -> the web-crawl requests.Session transport
 *     (urlcrawl_helpers.py), URL at positional argument 0.
 *
 * Sinks are matched at API-signature level. Call sites of the same signatures whose URL
 * is a fixed provider host / literal / config / env value were fp-labeled; they also
 * match here, but only actually tainted arguments produce alerts — the operator-config
 * and fixed-host false-positive heuristics are applied at the reporting stage (Step 6).
 * Test files are excluded, mirroring the label scope.
 */

import python
import semmle.python.dataflow.new.DataFlow

module MySinks {
  // ---------- shared helpers ----------

  /** Holds if `n` is located in the file with this repo-relative path. */
  private predicate inFile(AstNode n, string relPath) {
    n.getLocation().getFile().getRelativePath() = relPath
  }

  /**
   * Holds if `n` is outside test files. The reviewed labels exclude tests
   * (extraction scope already excluded mindsdb/%/tests/ and root tests/).
   */
  private predicate notInTestFile(AstNode n) {
    not n.getLocation().getFile().getRelativePath().matches("%/tests/%") and
    not n.getLocation().getFile().getRelativePath().matches("%tests.py") and
    not n.getLocation().getFile().getRelativePath().matches("%/test_%.py")
  }

  /**
   * Holds if `func` is the attribute `<verb>` selected on the module object `recv`.
   */
  private predicate moduleVerb(Attribute func, string recv, string verb) {
    func.getName() = verb and
    func.getObject().(Name).getId() = recv
  }

  // ---------- pass 3 sinks (pass key: "ssrf") ----------

  /**
   * requests.<get|post|put|delete|head|patch>(url, ...) — URL at positional argument 0.
   * tp instances (attacker-controlled full URL or host at arg 0):
   *   P3-K-0036/P3-K-0037 (file.py:99/116, files-API source URL),
   *   P3-K-0044 (functions.py:33, download_file of PATH-type SQL connection args),
   *   P3-K-0080 (rag settings.py:400, CREATE MODEL USING url),
   *   P3-K-0047/P3-K-0048 (gmail/youtube credentials_url),
   *   P3-K-0025/P3-K-0026 (dremio base_url), P3-K-0071..P3-K-0074 (pinot host/port),
   *   P3-K-0085/P3-K-0087 (strapi _base_url), P3-K-0030/0031/0033/0035 (eventstoredb
   *   basic_url), P3-K-0039/0040/0042/0043 (frappe domain), P3-K-0078 (scylla
   *   secure_connect_bundle), P3-K-0062/P3-K-0063 (mlflow predict_url),
   *   P3-K-0076/P3-K-0077 (ray_serve train_url/predict_url),
   *   P3-K-0020 (clipdrop image_url), P3-K-0084 (stabilityai image_url),
   *   P3-K-0090 (twitter media_url).
   * candidate instances: P3-K-0038 (file_handler _fetch_url), P3-K-0046 (lightwood
   * train_url), P3-K-0032/P3-K-0034 (eventstoredb link['uri'] second-order),
   * P3-K-0041 (frappe redirect Location).
   */
  private predicate requestsModuleVerbUrl(DataFlow::Node sink) {
    exists(Call c, Attribute func, string verb |
      sink.asExpr() = c.getPositionalArg(0) and
      func = c.getFunc() and
      moduleVerb(func, "requests", verb) and
      (
        verb = "get" or
        verb = "post" or
        verb = "put" or
        verb = "delete" or
        verb = "head" or
        verb = "patch"
      )
    )
  }

  /**
   * requests.request(method, url, ...) — URL at positional argument 1 (method first).
   * tp instances: P3-K-0027/P3-K-0028/P3-K-0029 (dremio_handler.py:138/143/146,
   * self.base_url + fixed path), P3-K-0086 (strapi_handler.py:96).
   * (fp-labeled requests.request sites of the same signature — instatus, intercom,
   * sharepoint — match too but only fire on tainted URLs.)
   */
  private predicate requestsModuleRequestUrl(DataFlow::Node sink) {
    exists(Call c, Attribute func |
      sink.asExpr() = c.getPositionalArg(1) and
      func = c.getFunc() and
      moduleVerb(func, "requests", "request")
    )
  }

  /**
   * P3-K-0003 (tp 0.85, sap_erp_handler/api.py:55), P3-K-0004 (tp 0.85,
   * lightdash_handler/api.py:21): `requests.request(**kwargs)` transport wrappers.
   * The URL arrives as the "url" entry of the kwargs dict, whose value is
   * urljoin(self.base_url, relative_endpoint) (api.py:46 / api.py:14), so the sink
   * node is that urljoin(...) call expression. self.base_url is
   * connection_data['base_url'] (sap_erp_handler.py:69 / lightdash_handler.py:42) —
   * attacker-controlled scheme/host/port/base path (label arg_index 1 =
   * requests.request's URL position; see query_generation_notes.md).
   */
  private predicate requestsRequestKwargsWrapperUrl(DataFlow::Node sink) {
    exists(Call c, Call uj |
      c.getFunc().(Attribute).getName() = "request" and
      c.getFunc().(Attribute).getObject().(Name).getId() = "requests" and
      exists(c.getANamedArg().(DictUnpacking)) and
      (
        inFile(c, "mindsdb/integrations/handlers/sap_erp_handler/api.py") or
        inFile(c, "mindsdb/integrations/handlers/lightdash_handler/api.py")
      ) and
      uj.getFunc().(Name).getId() = "urljoin" and
      (
        inFile(uj, "mindsdb/integrations/handlers/sap_erp_handler/api.py") or
        inFile(uj, "mindsdb/integrations/handlers/lightdash_handler/api.py")
      ) and
      sink.asExpr() = uj
    )
  }

  /**
   * P3-K-0091 (tp 0.9): session.get(url, headers) — the web-crawl transport in
   * mindsdb/integrations/handlers/web_handler/urlcrawl_helpers.py:102
   * (session = requests.Session() at :94). URL at positional argument 0; the initial
   * url comes from SELECT ... FROM web WHERE url = ... / native query strings, and
   * response-derived hrefs are joined via urljoin at :122.
   */
  private predicate crawlSessionGetUrl(DataFlow::Node sink) {
    exists(Call c, Attribute func |
      sink.asExpr() = c.getPositionalArg(0) and
      func = c.getFunc() and
      moduleVerb(func, "session", "get") and
      (
        inFile(c, "mindsdb/integrations/handlers/web_handler/urlcrawl_helpers.py")
      )
    )
  }

  /**
   * Entry point used by the pass 3 query configuration.
   * `passKey` must be "ssrf" (the single pass key used throughout pass 3).
   */
  predicate isSink(DataFlow::Node sink, string passKey) {
    passKey = "ssrf" and
    notInTestFile(sink.asExpr()) and
    (
      requestsModuleVerbUrl(sink) or
      requestsModuleRequestUrl(sink) or
      requestsRequestKwargsWrapperUrl(sink) or
      crawlSessionGetUrl(sink)
    )
  }
}
