import python
import semmle.python.dataflow.new.DataFlow
import semmle.python.ApiGraphs

/** Additional taint propagation steps for the CairoSVG passes. */
module MySummaries {
  /**
   * Holds if taint may additionally flow from `nodeFrom` to `nodeTo` for
   * the pass identified by `passKey`.
   *
   * Only `ssrf` (Pass 3) is populated. Every step is conditioned on a
   * concrete syntactic shape whose data path was verified in the source;
   * no step propagates taint unconditionally.
   *
   * Rendered steps:
   *   1. fetchUrlWrapperStep   (labels P3-K-002/005/007/008/010/015)
   *   2. treeUrlStep           (labels P3-K-001/004/009/010/011)
   *   3. fetcherDispatchStep   (labels P3-K-012/K-017 wrapper evidence)
   *   4. requestUrlStep        (label P3-K-014)
   */
  predicate isAdditionalTaintStep(DataFlow::Node nodeFrom, DataFlow::Node nodeTo, string passKey) {
    passKey = "ssrf" and (
      fetchUrlWrapperStep(nodeFrom, nodeTo) or
      treeUrlStep(nodeFrom, nodeTo) or
      fetcherDispatchStep(nodeFrom, nodeTo) or
      requestUrlStep(nodeFrom, nodeTo)
    )
  }

  /**
   * Step 1 - resource-load wrapper bridge (labels P3-K-002, P3-K-005,
   * P3-K-010 call sites; P3-K-007/P3-K-008/P3-K-015 definitions):
   *
   *   parser.py:242-243
   *   `def fetch_url(self, url, resource_type):
   *        return read_url(url, self.url_fetcher, resource_type)`
   *
   * Taint in positional argument 0 of any `X.fetch_url(...)` call flows to
   * the `url` parameter of read_url. The three real call sites are
   * image.py:28 (image fetch), css.py:39 (CSS @import fetch) and
   * parser.py:386 (external SVG fetch); the edge bridges the
   * attribute-call dispatch (`node.fetch_url`/`tree.fetch_url` on
   * unannotated parameters) and the method body, which the source shows is
   * a direct pass-through to read_url.
   */
  private predicate fetchUrlWrapperStep(DataFlow::Node nodeFrom, DataFlow::Node nodeTo) {
    exists(Call c, Function f, Parameter p |
      fetchUrlCallSite(c) and
      nodeFrom.asExpr() = c.getPositionalArg(0) and
      readUrlFunction(f) and
      p = f.getArg(0) and
      nodeTo = DataFlow::parameterNode(p)
    )
  }

  /** A call whose callee is an attribute named `fetch_url`. */
  private predicate fetchUrlCallSite(Call c) {
    c.getFunc() instanceof Attribute and
    c.getFunc().(Attribute).getName() = "fetch_url"
  }

  /** The module-level read_url(url, url_fetcher, resource_type) in url.py. */
  private predicate readUrlFunction(Function f) {
    f.getName() = "read_url" and
    f.getEnclosingModule().getFile().getBaseName() = "url.py" and
    f.getEnclosingScope() instanceof Module
  }

  /**
   * Step 2 - Tree(url=...) document fetch (labels P3-K-001, P3-K-004,
   * P3-K-009, P3-K-010 target, P3-K-011):
   *
   *   Tree.__init__ (parser.py:343-387) receives the document url through
   *   a kwargs dict (`kwargs.get('url')`, parser.py:347), which standard
   *   data flow cannot track. When no bytestring is supplied, the url is
   *   composed against the parent base (parser.py:365) and fetched:
   *
   *   parser.py:386-387
   *   `bytestring = self.fetch_url(parse_url(self.url), 'image/svg+xml')`
   *
   * Edge: the `url` keyword argument value of a Tree(...) call flows to
   * the parse_url(self.url) argument of that external-SVG fetch call.
   * Real Tree(url=...) sites: surface.py:128-130 (top-level document),
   * parser.py:265-267 (<tref>), defs.py:350-352 and
   * bounding_box.py:345-347 (<use>).
   *
   * Exclusions, per the reviewed labels:
   *   - image.py:46 (P3-K-006): bytestring is always provided, the url is
   *     never fetched there;
   *   - Tree(url='#...') (P3-K-003, defs.py:40): constant fragment value,
   *     and fragment-only Tree references reuse the parent tree
   *     (parser.py:376-383) without any fetch.
   */
  private predicate treeUrlStep(DataFlow::Node nodeFrom, DataFlow::Node nodeTo) {
    exists(Call tree, Keyword kw, Call fetchCall |
      treeCallWithUrlKeyword(tree, kw) and
      not treeCallWithoutFetch(tree) and
      nodeFrom.asExpr() = kw.getValue() and
      externalSvgFetchCall(fetchCall) and
      nodeTo.asExpr() = fetchCall.getPositionalArg(0)
    )
  }

  /** A `Tree(...)` call carrying a `url` keyword argument. */
  private predicate treeCallWithUrlKeyword(Call c, Keyword k) {
    c.getFunc() instanceof Name and
    c.getFunc().(Name).getId() = "Tree" and
    k = c.getANamedArg().(Keyword) and
    k.getArg() = "url"
  }

  /**
   * The single Tree(...) site whose url is provably never fetched:
   * image.py:45-48 `Tree(url=url.geturl(), bytestring=image_bytes, ...)`
   * (label P3-K-006) - bytestring is always the already-fetched image
   * bytes, so Tree.__init__ takes the bytestring branch
   * (parser.py:356-357).
   */
  private predicate treeCallWithoutFetch(Call c) {
    c.getScope().getEnclosingModule().getFile().getBaseName() = "image.py" and
    c.getLocation().getStartLine() = 46
  }

  /**
   * The external-SVG fetch call whose argument 0 is the composed document
   * URL: `self.fetch_url(parse_url(self.url), 'image/svg+xml')`
   * (parser.py:386-387). Unique shape: a fetch_url call whose first
   * positional argument is itself a parse_url(...) call.
   */
  private predicate externalSvgFetchCall(Call c) {
    c.getFunc() instanceof Attribute and
    c.getFunc().(Attribute).getName() = "fetch_url" and
    c.getPositionalArg(0) instanceof Call and
    c.getPositionalArg(0).(Call).getFunc().(Name).getId() = "parse_url"
  }

  /**
   * Step 3 - fetcher dispatch to the default network fetcher (label
   * P3-K-012 fetch parameter; wrapper evidence recorded with P3-K-017):
   *
   *   url.py:143            `return url_fetcher(url, resource_type)`
   *   parser.py:354         `self.url_fetcher = kwargs.get('url_fetcher', fetch)`
   *   url.py:77-84 (fetch)  `return urlopen(Request(url, ...)).read()`
   *
   * Edge: the URL argument of the dynamic url_fetcher dispatch flows to
   * the `url` parameter of fetch. This is the dispatch's default target
   * and the only in-database fetcher; an injected custom fetcher would
   * receive the same tainted argument, so the step is a conservative
   * approximation of the documented default, not an unconditional
   * propagation.
   */
  private predicate fetcherDispatchStep(DataFlow::Node nodeFrom, DataFlow::Node nodeTo) {
    exists(Call c, Function f, Parameter p |
      fetcherDispatchCall(c) and
      nodeFrom.asExpr() = c.getPositionalArg(0) and
      fetchFunction(f) and
      p = f.getArg(0) and
      nodeTo = DataFlow::parameterNode(p)
    )
  }

  /** The `url_fetcher(url, resource_type)` dispatch call in url.py. */
  private predicate fetcherDispatchCall(Call c) {
    c.getFunc() instanceof Name and
    c.getFunc().(Name).getId() = "url_fetcher" and
    c.getScope().getEnclosingModule().getFile().getBaseName() = "url.py"
  }

  /** The module-level fetch(url, resource_type) in url.py (default fetcher). */
  private predicate fetchFunction(Function f) {
    f.getName() = "fetch" and
    f.getEnclosingModule().getFile().getBaseName() = "url.py" and
    f.getEnclosingScope() instanceof Module
  }

  /**
   * Step 4 - Request URL transfer (label P3-K-014):
   *
   *   url.py:84 `urlopen(Request(url, headers=HTTP_HEADERS)).read()`
   *
   * Edge: the URL string argument of a urllib.request.Request construction
   * flows to the Request call result, so taint reaches urlopen's argument
   * (the sink node, P3-K-013). urllib's Request object stores the target
   * URL and urlopen performs the request with it; the construction itself
   * is not network I/O (which is why this is a step, not a sink).
   */
  private predicate requestUrlStep(DataFlow::Node nodeFrom, DataFlow::Node nodeTo) {
    exists(Call c |
      c = API::moduleImport("urllib.request").getMember("Request")
            .getACall().asExpr() and
      nodeFrom.asExpr() = c.getPositionalArg(0) and
      nodeTo.asExpr() = c
    )
  }
}
