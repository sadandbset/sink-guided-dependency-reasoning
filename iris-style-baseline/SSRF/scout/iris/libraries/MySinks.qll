   *   `    url=remote_url,`
   *   `    headers={key: value for (key, value) in request.headers if key != "Host"},`
   *   `    data=request.get_data(),`
   *   `    cookies=request.cookies,`
   *   `    allow_redirects=True,`
   *   `)`
   *
   * requests.request's signature is request(method, url, ...): the URL is
   * positional parameter 1, passed as the `url` keyword here (the reviewed
   * label normalized the CSV arg_index -1 to 1). The sink node is the
   * keyword value expression - the `remote_url` parameter reference, i.e.
   * the reviewed source src-025.
   */
  private class RemoteCorsProxyUrlSink extends DataFlow::Node {
    RemoteCorsProxyUrlSink() {
      exists(Call c, Keyword kw |
        requestsCall(c, "request") and
        atSite(c, "scout/server/blueprints/alignviewers/views.py", 42) and
        kw = c.getANamedArg().(Keyword) and
        kw.getArg() = "url" and
        this.asExpr() = kw.getValue()
      )
    }
  }

