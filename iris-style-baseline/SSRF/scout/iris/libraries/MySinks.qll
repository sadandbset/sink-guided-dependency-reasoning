import python
import semmle.python.dataflow.new.DataFlow

/** Taint sinks for the scout CWE-918 pass, dispatched by pass key. */
module MySinks {
  /**
   * Holds if `sink` is a taint sink for the pass identified by `passKey`.
   *
   * Only `ssrf` (Pass 3) is populated. No resource-handling function is
   * promoted to a sink without a code path to actual network I/O.
   */
  predicate isSink(DataFlow::Node sink, string passKey) {
    passKey = "ssrf" and (
      sink instanceof RemoteCorsProxyUrlSink or
      sink instanceof CoverageStatsPostUrlSink or
      sink instanceof ScoutRequestsIoUrlSink or
      sink instanceof FtpUrlopenUrlSink or
      sink instanceof RefseqGetRequestUrlSink or
      sink instanceof LoqusApiGetUrlSink or
      sink instanceof EnsemblRestGetUrlSink or
      sink instanceof RankModelGetUrlSink or
      sink instanceof MatchMakerWrapperUrlSink
    )
  }

  /**
