  /**
   * The argument-0 (patient_id / patient_obj) positions of the MatchMaker
   * wrapper invocations (labels snk-010 0.45, snk-011 0.45, snk-013 0.50)
   * at scout/server/blueprints/cases/controllers.py:
   *
   *   :1163 `resp = matchmaker.patient_delete(patient_id)`
   *   :1206 `server_resp = matchmaker.patient_matches(patient_id)`
   *   :1257 `json_resp = matchmaker.match_external(patient_id, node)`
   *
   * Wrapper justification (verified in this database): the MatchMaker
   * methods (matchmaker_extension.py:81/113/143) embed argument 0 into
   * `url = "".join([self.host, "/patient/delete/"|"/matches/"|
   * "/match/external/", patient_id, ...])` and forward it through request()
   * -> scout_requests.get/delete/post_request_json (url= keyword) ->
   * requests.* - real network I/O with the argument inside the URL string.
   * The patient_submit (:1124) and match_internal (:1241) invocations are
   * NOT sinks: their URLs are constant paths on the admin host and the
   * argument travels only in the JSON body (reviewed as none).
   */
  private class MatchMakerWrapperUrlSink extends DataFlow::Node {
    MatchMakerWrapperUrlSink() {
      exists(Call c |
        matchmakerWrapperCall(c) and
        this.asExpr() = c.getPositionalArg(0)
      )
    }
  }

  /** A `matchmaker.patient_delete/patient_matches/match_external(...)` call. */
  private predicate matchmakerWrapperCall(Call c) {
    c.getFunc() instanceof Attribute and
    c.getFunc().(Attribute).getObject().(Name).getId() = "matchmaker" and
    c.getFunc().(Attribute).getName() in ["patient_delete", "patient_matches", "match_external"] and
    c.getScope().getEnclosingModule().getFile().getRelativePath() =
      "scout/server/blueprints/cases/controllers.py" and
    c.getLocation().getStartLine() in [1163, 1206, 1257]
  }

  /** A `requests.<method>(...)` module-level call. */
  private predicate requestsCall(Call c, string method) {
    c.getFunc() instanceof Attribute and
    c.getFunc().(Attribute).getName() = method and
    c.getFunc().(Attribute).getObject().(Name).getId() = "requests"
  }

  /** A `urllib.request.urlopen(...)` call. */
  private predicate urllibUrlopenCall(Call c) {
    c.getFunc() instanceof Attribute and
    c.getFunc().(Attribute).getName() = "urlopen" and
    c.getFunc().(Attribute).getObject() instanceof Attribute and
    c.getFunc().(Attribute).getObject().(Attribute).getName() = "request" and
    c.getFunc().(Attribute).getObject().(Attribute).getObject().(Name).getId() = "urllib"
  }

  /** Pins a call to (database-relative file path, start line). */
  private predicate atSite(Call c, string relPath, int line) {
    c.getScope().getEnclosingModule().getFile().getRelativePath() = relPath and
    c.getLocation().getStartLine() = line
  }
